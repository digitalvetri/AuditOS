{
  "name": "audit-os-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently -n web,api -c blue,magenta \"npm run dev\" \"npm --prefix ../backend run dev\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "tsc -p tsconfig.json --noEmit",
