## Frontend environment. Copy to `.env` before running `npm run dev`.
## The backend has its own file — see server/.env.example.

## true  → MSW intercepts /api/* in the browser and serves seeded data.
##         NOT a complete app: Books and the whole Workstation module
##         (clients, leads, follow-ups, services, client documents) have
##         no MSW handlers. Those pages fall through to the proxy and
##         fail with "Could not load …" unless the backend is running.
##         Use this only for the HRMS/Tools screens without a backend.
## false → the same /api/* calls are proxied to the Express backend.
##         This is the full app — start it with `npm run dev:full`.
VITE_MOCK_MODE=false

## Where Vite proxies /api and /socket.io in real-backend mode.
VITE_API_PROXY_TARGET=http://localhost:4000

## Show the demo login list on the sign-in screen. Defaults to on in mock
## mode; set to true to also show it against the seeded dev backend.
VITE_SHOW_DEMO_LOGINS=true
