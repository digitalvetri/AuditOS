  contactId String
  kind      String
  line1     String?
  line2     String?
  city      String?
  stateCode String?
  stateName String?
  pincode   String?
  country   String  @default("IN")

  contact BooksContact @relation(fields: [contactId], references: [id])

  @@index([contactId])
