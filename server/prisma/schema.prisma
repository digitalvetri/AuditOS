  receivableLedgerId String?
  payableLedgerId    String?
  notes              String?
  isActive           Boolean @default(true)

  persons   BooksContactPerson[]
  addresses BooksAddress[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

