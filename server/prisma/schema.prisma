// AUDIT OS · HRMS — unified Prisma schema (Part 1 core-HR + Part 2 modules).
//
// ONE MODEL, ONE SOURCE OF TRUTH. There is exactly one User, one Employee,
// one Role, one ExpenseCategory and one payroll model in this file. Where
// Part 1 and Part 2 both described an entity, the Part 1 domain shape wins
// (it is the shape the shipped React frontend consumes) and the useful Part 2
// additions are folded into it.
//
// NAMING: columns are camelCase (Prisma convention). The HTTP API speaks
// snake_case (Part 1 §9/§10). The translation happens in exactly one place —
// src/api/serialize.ts — never inside a route handler or a React component.
//
// MONEY: every monetary column is an integer number of PAISE. No floats.
//
// DATES: a calendar date that must stay IST-stable (attendance date, leave
// range, effective-from, expiry) is stored as an ISO 'YYYY-MM-DD' STRING.
// A point in time is a DateTime stored in UTC. Storing calendar dates as
// DateTime is what makes attendance rows land on the wrong day across the
// IST/UTC boundary, so we do not do it.
//
// SOFT DELETE: every mutable table carries deletedAt; reads filter it out.
// AuditLog and LedgerTransaction are append-only and carry no deletedAt.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // PostgreSQL running in Docker (see docker-compose.yml at repo root).
  // The invariants layer (src/modules/books/db/invariants.ts) already
  // detects the active provider and loads the matching SQL file.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// PLATFORM PRIMITIVES
// ============================================================

model Organisation {
  id                   String @id @default(uuid())
  name                 String
  timezone             String @default("Asia/Kolkata")
  currency             String @default("INR")
  fiscalYearStartMonth Int    @default(4)

  departments         Department[]
  designations        Designation[]
  workLocations       WorkLocation[]
  workSchedules       WorkSchedule[]
  holidays            Holiday[]
  employees           Employee[]
  users               User[]
  leaveTypes          LeaveType[]
  expenseCategories   ExpenseCategory[]
  statutoryRates      StatutoryRate[]
  payrollRuns         PayrollRun[]
  chats               Chat[]
  toolDocuments       ToolDocument[]
  toolJobs            ToolJob[]
  aaBankAccounts      AaBankAccount[]
  aaSourceDocuments   AaSourceDocument[]
  aaJobs              AaJob[]
  aaGstFilings2B      AaGstFiling2B[]
  aaPurchaseRegisters AaPurchaseRegister[]
  aaGstReconJobs      AaGstReconJob[]
  aaTds26AS           AaTds26AS[]
  aaTdsBooks          AaTdsBooks[]
  aaTdsReconJobs      AaTdsReconJob[]
  checklistItems      ClientChecklistItem[]
  tallyCompanies      TallyCompany[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

model Role {
  id          String  @id @default(uuid())
  // employee | dept_manager | hr_admin | finance_admin | md
  code        String  @unique
  name        String
  description String?

  permissions RolePermission[]
  users       User[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

model Permission {
  id          String @id @default(uuid())
  // '<module>.<action>[.<qualifier>]' — see src/platform/rbac/matrix.ts
  code        String @unique
  description String

  roles RolePermission[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String
  // self | department | organisation — a grant is (permission, scope).
  scope        String @default("self")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model User {
  id             String    @id @default(uuid())
  organisationId String
  email          String    @unique
  passwordHash   String
  roleId         String
  // Nullable BOTH ways (Part 1 §4.2): automation users have no employee, and
  // an employee (e.g. an exited one) may have no login.
  employeeId     String?   @unique
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])
  employee     Employee?    @relation(fields: [employeeId], references: [id])

  notifications       Notification[]
  auditLogs           AuditLog[]
  toolDocuments       ToolDocument[]
  toolJobs            ToolJob[]
  aaSourceDocuments   AaSourceDocument[]
  aaJobs              AaJob[]
  aaGstFilings2B      AaGstFiling2B[]
  aaPurchaseRegisters AaPurchaseRegister[]
  aaGstReconJobs      AaGstReconJob[]
  aaTds26AS           AaTds26AS[]
  aaTdsBooks          AaTdsBooks[]
  aaTdsReconJobs      AaTdsReconJob[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

// ============================================================
// CONFIGURATION (Settings §8.11)
// ============================================================

model Department {
  id             String @id @default(uuid())
  organisationId String
  name           String
  code           String @unique

  organisation Organisation @relation(fields: [organisationId], references: [id])
  employees    Employee[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

model Designation {
  id             String @id @default(uuid())
  organisationId String
  name           String

  organisation Organisation @relation(fields: [organisationId], references: [id])
  employees    Employee[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

model WorkLocation {
  id             String  @id @default(uuid())
  organisationId String
  name           String
  address        String  @default("")
  latitude       Float
  longitude      Float
  radiusM        Int     @default(150)
  isActive       Boolean @default(true)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  employees    Employee[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

model WorkSchedule {
  id                   String  @id @default(uuid())
  organisationId       String
  name                 String
  standardStart        String // 'HH:mm'
  standardEnd          String // 'HH:mm'
  fullDayHours         Float   @default(8)
  halfDayHours         Float   @default(4)
  breakMinutes         Int     @default(60)
  // JSON array of ISO weekday numbers 1..7 (SQLite has no native Json column).
  workingDaysJson      String  @default("[1,2,3,4,5]")
  alternateSaturdayOff Boolean @default(false)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  employees    Employee[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

model Holiday {
  id             String  @id @default(uuid())
  organisationId String
  date           String // 'YYYY-MM-DD'
  name           String
  isOptional     Boolean @default(false)

  organisation Organisation @relation(fields: [organisationId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([date])
}

model LeaveType {
  id                    String  @id @default(uuid())
  organisationId        String
  // casual | sick | earned | lop | comp_off
  code                  String
  name                  String
  // null = unlimited (Loss of Pay)
  annualEntitlement     Float?
  accrual               String  @default("monthly") // monthly | earned
  carryForwardMax       Float   @default(0)
  halfDayAllowed        Boolean @default(false)
  minNoticeDays         Int     @default(0)
  accrueDuringProbation Boolean @default(true)

  organisation Organisation   @relation(fields: [organisationId], references: [id])
  balances     LeaveBalance[]
  requests     LeaveRequest[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([organisationId, code])
}

model ExpenseCategory {
  id              String  @id @default(uuid())
  organisationId  String
  name            String
  code            String  @unique
  isActive        Boolean @default(true)
  requiresReceipt Boolean @default(true)
  glAccount       String?

  organisation Organisation @relation(fields: [organisationId], references: [id])
  expenses     Expense[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

// Statutory configuration is DATA, never a literal in code. A row is
// (code, effectiveFrom, effectiveTo); payroll resolves the row effective on
// the period start and snapshots it onto the run.
model StatutoryRate {
  id             String  @id @default(uuid())
  organisationId String
  // 'pf.employee_rate' | 'pf.wage_ceiling' | 'esi.gross_threshold' | 'pt.tn.slab' | …
  code           String
  // Stored as a string; the caller parses (rate, ceiling, or a slab JSON array).
  value          String
  effectiveFrom  String // 'YYYY-MM-DD'
  effectiveTo    String? // 'YYYY-MM-DD'
  notes          String?

  organisation Organisation @relation(fields: [organisationId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([code, effectiveFrom])
}

// ============================================================
// CORE HR
// ============================================================

model Employee {
  id             String @id @default(uuid())
  organisationId String
  employeeCode   String @unique
  firstName      String
  lastName       String
  fullName       String
  // partner | manager | executive | articled | support
  type           String @default("executive")
  // active | on_leave | probation | notice_period | inactive
  status         String @default("active")

  designationId  String
  departmentId   String
  managerId      String? // self-referential, nullable
  workLocationId String
  workScheduleId String

  email            String  @unique
  phone            String  @default("")
  joiningDate      String // 'YYYY-MM-DD'
  exitDate         String?
  exitReason       String?
  noticePeriodDays Int     @default(30)

  // RESERVED FOR WORKSTATION — nullable from day one, no UI in this phase.
  weeklyCapacityHours Float?

  // Task module back-relations (Workstation → Task).
  assignedTasks     Task[]                @relation("TaskAssignee")
  quotations        Quotation[]           @relation("QuotationPreparedBy")
  engagementLetters EngagementLetter[]    @relation("EngagementPreparedBy")
  raisedTasks       Task[]                @relation("TaskAssigner")
  taskSessions      TaskTimeSession[]
  checklistItems    ClientChecklistItem[] @relation("ChecklistAssignee")

  photoUrl              String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  bankAccountMasked     String?

  organisation Organisation @relation(fields: [organisationId], references: [id])
  department   Department   @relation(fields: [departmentId], references: [id])
  designation  Designation  @relation(fields: [designationId], references: [id])
  workLocation WorkLocation @relation(fields: [workLocationId], references: [id])
  workSchedule WorkSchedule @relation(fields: [workScheduleId], references: [id])
  manager      Employee?    @relation("EmployeeManager", fields: [managerId], references: [id])
  reports      Employee[]   @relation("EmployeeManager")

  user               User?
  training           ArticledTraining?      @relation("TrainingSubject")
  principalTrainings ArticledTraining[]     @relation("TrainingPrincipal")
  attendance         Attendance[]
  corrections        AttendanceCorrection[]
  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]
  documents          EmployeeDocument[]
  salaryStructures   SalaryStructure[]
  payrollItems       PayrollItem[]
  payslips           Payslip[]
  expenses           Expense[]
  payments           Payment[]
  ledgerEntries      LedgerTransaction[]
  chatMemberships    ChatMember[]
  chatMessages       ChatMessage[]
  messageReads       MessageRead[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([departmentId])
  @@index([managerId])
}

model ArticledTraining {
  id                  String @id @default(uuid())
  employeeId          String @unique
  icaiRegistrationNo  String
  principalEmployeeId String
  trainingStart       String
  trainingEnd         String
  currentYear         Int    @default(1)
  stipendSlab         String @default("")
  // active | transferred | completed | terminated
  status              String @default("active")

  employee  Employee @relation("TrainingSubject", fields: [employeeId], references: [id])
  principal Employee @relation("TrainingPrincipal", fields: [principalEmployeeId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

model EmployeeDocument {
  id         String   @id @default(uuid())
  employeeId String
  name       String
  // employment | joining | certificate | hr | tax | bank | company_issued | icai
  type       String
  fileKey    String
  uploadedBy String
  uploadedAt DateTime @default(now())
  expiryDate String?
  // valid | expiring_soon | expired | pending_verification (derived on read
  // from expiryDate, except the sticky pending_verification state)
  status     String   @default("valid")

  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([employeeId])
}

// ============================================================
// ATTENDANCE (§8.2)
// ============================================================

model Attendance {
  id         String @id @default(uuid())
  employeeId String
  date       String // 'YYYY-MM-DD' IST calendar date

  checkInAt  DateTime?
  checkOutAt DateTime?

  checkInLat        Float?
  checkInLong       Float?
  checkInAccuracyM  Float?
  checkOutLat       Float?
  checkOutLong      Float?
  checkOutAccuracyM Float?

  checkInLocationId  String?
  checkOutLocationId String?
  // office | client_site | remote | field
  locationType       String?
  offSiteReason      String?

  workedMinutes    Int?
  breakMinutes     Int?
  // present | late | absent | half_day | wfh | on_leave | missing_check_in | missing_check_out
  status           String
  // web_geo | biometric | manual
  source           String  @default("web_geo")
  // none | requested | approved | rejected
  correctionStatus String  @default("none")
  device           String?
  ip               String?

  // RESERVED FOR WORKSTATION — no FK, there is no Client table yet.
  clientId String?

  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([employeeId, date])
  @@index([date])
}

model AttendanceCorrection {
  id                  String    @id @default(uuid())
  attendanceId        String? // null when the correction creates a new day
  employeeId          String
  date                String
  requestedCheckInAt  DateTime?
  requestedCheckOutAt DateTime?
  reason              String
  attachmentUrl       String?
  // pending | approved | rejected
  status              String    @default("pending")
  reviewedBy          String?
  reviewedAt          DateTime?
  reviewNotes         String?

  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([employeeId, status])
}

// ============================================================
// LEAVE (§8.3)
// ============================================================

model LeaveBalance {
  id              String @id @default(uuid())
  employeeId      String
  leaveTypeId     String
  fiscalYearStart String // 'YYYY-04-01'
  entitled        Float  @default(0)
  availed         Float  @default(0)
  carriedForward  Float  @default(0)

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, leaveTypeId, fiscalYearStart])
}

model LeaveRequest {
  id                  String    @id @default(uuid())
  employeeId          String
  leaveTypeId         String
  startDate           String
  endDate             String
  halfDay             Boolean   @default(false)
  // Server-authoritative: the sandwich rule is applied at write time.
  computedWorkingDays Float
  reason              String
  attachmentUrl       String?
  // pending | approved | rejected | cancelled
  status              String    @default("pending")
  approverId          String? // manager who approved (stage 1)
  hrApproverId        String? // HR who approved (stage 2, > 5 days)
  approvedAt          DateTime?
  rejectionReason     String?

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([employeeId, startDate])
  @@index([status])
}

// ============================================================
// PAYROLL (§8.4)
// ============================================================

model SalaryStructure {
  id                    String  @id @default(uuid())
  employeeId            String
  effectiveFrom         String
  effectiveTo           String? // null = currently effective
  monthlyCtcPaise       Int     @default(0)
  basicPaise            Int     @default(0)
  hraPaise              Int     @default(0)
  conveyancePaise       Int     @default(0)
  specialAllowancePaise Int     @default(0)
  // JSON array of { code, label, amount_paise, kind: 'earning' | 'deduction' }
  customComponentsJson  String  @default("[]")
  notes                 String?

  employee     Employee      @relation(fields: [employeeId], references: [id])
  payrollItems PayrollItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([employeeId, effectiveFrom])
}

model PayrollRun {
  id                    String  @id @default(uuid())
  organisationId        String
  periodStart           String
  periodEnd             String
  // draft → hr_review → finance_review → approved → processed
  stage                 String  @default("draft")
  isCalculating         Boolean @default(false)
  // Snapshot of the StatutoryRate table at calculate time. A rate change
  // afterwards must NOT alter a processed run's numbers.
  statutorySnapshotJson String?

  headcount            Int @default(0)
  grossTotalPaise      Int @default(0)
  deductionsTotalPaise Int @default(0)
  netTotalPaise        Int @default(0)

  reviewedBy  String?
  approvedBy  String?
  processedBy String?
  processedAt DateTime?
  notes       String?

  organisation Organisation  @relation(fields: [organisationId], references: [id])
  items        PayrollItem[]
  payslips     Payslip[]
  payments     Payment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([periodStart, periodEnd])
}

model PayrollItem {
  id                String @id @default(uuid())
  payrollRunId      String
  employeeId        String
  salaryStructureId String

  payableDays Float
  presentDays Float
  onLeaveDays Float
  absentDays  Float
  lopDays     Float

  // "Show the working": full component-by-component breakdown, in the exact
  // PayrollEarnings / PayrollDeductions shape the payslip renders.
  earningsJson   String
  deductionsJson String

  grossPaise           Int
  totalDeductionsPaise Int
  netPaise             Int
  gratuityAccrualPaise Int     @default(0)
  notes                String?

  payrollRun      PayrollRun      @relation(fields: [payrollRunId], references: [id])
  employee        Employee        @relation(fields: [employeeId], references: [id])
  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id])
  payslip         Payslip?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
}

model Payslip {
  id            String   @id @default(uuid())
  payrollRunId  String
  payrollItemId String   @unique
  employeeId    String
  payslipNo     String   @unique
  publishedAt   DateTime
  fileKey       String
  // published | revoked
  status        String   @default("published")

  payrollRun  PayrollRun  @relation(fields: [payrollRunId], references: [id])
  payrollItem PayrollItem @relation(fields: [payrollItemId], references: [id])
  employee    Employee    @relation(fields: [employeeId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([employeeId])
}

// ============================================================
// EXPENSES (§8.5)
// ============================================================

model Expense {
  id             String  @id @default(uuid())
  expenseNo      String  @unique
  employeeId     String
  categoryId     String
  title          String
  amountPaise    Int
  expenseDate    String
  description    String  @default("")
  // cash | card | upi | bank_transfer | other
  paymentMethod  String  @default("card")
  receiptFileKey String?
  notes          String?
  // draft → pending_manager → pending_finance → approved → paid | rejected
  stage          String  @default("draft")

  submittedAt       DateTime?
  managerApprovedBy String?
  managerApprovedAt DateTime?
  financeApprovedBy String?
  financeApprovedAt DateTime?
  paidAt            DateTime?
  paymentId         String?
  rejectionReason   String?
  rejectedBy        String?
  rejectedAt        DateTime?

  // RESERVED FOR WORKSTATION — nullable, no UI, no FK.
  clientId String?

  employee  Employee          @relation(fields: [employeeId], references: [id])
  category  ExpenseCategory   @relation(fields: [categoryId], references: [id])
  approvals ExpenseApproval[]
  payments  Payment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([employeeId, stage])
  @@index([stage])
}

/// Append-only stage-transition trail. No update, no delete.
model ExpenseApproval {
  id          String  @id @default(uuid())
  expenseId   String
  actorUserId String
  fromStage   String
  toStage     String
  notes       String?

  expense Expense @relation(fields: [expenseId], references: [id])

  createdAt DateTime @default(now())

  @@index([expenseId])
}

// ============================================================
// ACCOUNTS & PAYMENTS (§8.6)
// ============================================================

model Payment {
  id           String    @id @default(uuid())
  paymentNo    String    @unique
  employeeId   String
  payrollRunId String?
  expenseId    String?
  amountPaise  Int
  // bank_transfer | cash | cheque | mock
  method       String    @default("mock")
  reference    String    @unique
  // pending | processing | completed | failed
  status       String    @default("pending")
  paidAt       DateTime?

  employee      Employee            @relation(fields: [employeeId], references: [id])
  payrollRun    PayrollRun?         @relation(fields: [payrollRunId], references: [id])
  expense       Expense?            @relation(fields: [expenseId], references: [id])
  ledgerEntries LedgerTransaction[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([employeeId, status])
}

/// APPEND-ONLY. There is no update and no delete path to this table anywhere
/// in the application — a correction is a contra entry that points back at the
/// row it reverses via reversesId. `namespace` is the hard boundary that keeps
/// client accounting out of Audit OS's own books (§8.6).
model LedgerTransaction {
  id                  String  @id @default(uuid())
  transactionRef      String  @unique
  namespace           String  @default("INTERNAL")
  // Monotonic, assigned inside the posting transaction.
  sequence            Int     @unique
  date                String
  // Payroll | Expense Reimbursement | Office Expense | Employee Advance |
  // Advance Recovery | Payment
  type                String
  description         String
  employeeId          String?
  category            String?
  debitPaise          Int     @default(0)
  creditPaise         Int     @default(0)
  runningBalancePaise Int
  referenceId         String
  referenceType       String
  // posted | reversed  (`reversed` means "a contra entry exists for me")
  status              String  @default("posted")

  paymentId  String?
  reversesId String?

  employee Employee? @relation(fields: [employeeId], references: [id])
  payment  Payment?  @relation(fields: [paymentId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?

  @@index([date])
  @@index([type])
}

// ============================================================
// MESSAGES (§8.7)
// ============================================================
//
// Shapes follow src/data/models.ts: a chat is `group` or `dm`; membership is
// a soft-leave row so history survives someone leaving; a read receipt is one
// row per (message, employee) rather than a per-chat high-water mark, which is
// what lets "read by me" be answered for an individual message.

model Chat {
  id             String  @id @default(uuid())
  organisationId String
  // group | dm
  type           String
  // Groups carry a name; a DM derives its display name from the other member.
  name           String?
  description    String?

  // RESERVED FOR WORKSTATION — nullable, no UI in this phase.
  subjectType String?
  subjectId   String?

  // Denormalised so the chat list can sort by activity without a join.
  lastMessageAt DateTime?

  organisation Organisation  @relation(fields: [organisationId], references: [id])
  members      ChatMember[]
  messages     ChatMessage[]
  reads        MessageRead[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([lastMessageAt])
}

model ChatMember {
  id         String    @id @default(uuid())
  chatId     String
  employeeId String
  // member | admin
  role       String    @default("member")
  joinedAt   DateTime  @default(now())
  /// Soft leave — the person stops receiving the chat but history is intact.
  leftAt     DateTime?

  chat     Chat     @relation(fields: [chatId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([chatId, employeeId])
  @@index([employeeId])
}

model ChatMessage {
  id               String  @id @default(uuid())
  chatId           String
  authorEmployeeId String
  /// Empty for an image-only message — an attachment is content in its own
  /// right, so the caption is optional. Never null, so readers need no guard.
  body             String  @default("")
  /// Reply-to. A thread is one level deep by design.
  parentId         String?
  /// JSON array of employee ids. Reserved for @mentions; empty in this phase.
  mentionsJson     String  @default("[]")

  chat        Chat             @relation(fields: [chatId], references: [id])
  author      Employee         @relation(fields: [authorEmployeeId], references: [id])
  parent      ChatMessage?     @relation("MessageReply", fields: [parentId], references: [id])
  replies     ChatMessage[]    @relation("MessageReply")
  reads       MessageRead[]
  attachments ChatAttachment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete — messages are retained for audit.
  deletedAt DateTime?

  @@index([chatId, createdAt])
}

/// An image sent in a chat. Bytes live in the storage adapter, never in the
/// database and never on a publicly guessable path: `storagePath` is a
/// server-generated key, and the only way to read it back is the membership-
/// checked GET /api/chat-attachments/:id route.
model ChatAttachment {
  id               String @id @default(uuid())
  messageId        String
  /// Key understood by the StorageAdapter — never a client-supplied path.
  storagePath      String
  /// What the sender called it, sanitized. Shown on hover and on download.
  originalFilename String
  /// Sniffed from the magic bytes, not taken from the upload's own header.
  mimeType         String
  fileSize         Int

  message ChatMessage @relation(fields: [messageId], references: [id])

  createdAt DateTime @default(now())

  @@index([messageId])
}

model MessageRead {
  id         String   @id @default(uuid())
  chatId     String
  messageId  String
  employeeId String
  readAt     DateTime @default(now())

  chat     Chat        @relation(fields: [chatId], references: [id])
  message  ChatMessage @relation(fields: [messageId], references: [id])
  employee Employee    @relation(fields: [employeeId], references: [id])

  @@unique([messageId, employeeId])
  @@index([chatId, employeeId])
}

// ============================================================
// NOTIFICATIONS + AUDIT (§8.9, §10)
// ============================================================

model Notification {
  id         String  @id @default(uuid())
  userId     String
  type       String
  // attendance | leave | payroll | expense | message | document | system
  module     String
  entityType String?
  entityId   String?
  title      String
  body       String
  actionUrl  String?
  isRead     Boolean @default(false)

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

/// Append-only. There is no update shape and no delete.
model AuditLog {
  id          String  @id @default(uuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  beforeJson  String?
  afterJson   String?
  ip          String?
  userAgent   String?

  actor User? @relation(fields: [actorUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================
// WORKSTATION (AUDIT_OS_WORKSTATION.md §5)
// ============================================================
//
// ONE CENTRAL CLIENT RECORD. Leads, Services, Follow-ups, Documents, GST,
// E-way Bills, Tasks and Activity all reference `Client.id`. Nothing in this
// section creates a second client row, and nothing creates a second employee
// table — every assignment is a scalar `…EmployeeId` resolved against the
// HRMS `Employee` at read time, exactly like `EmployeeDocument.uploadedBy`
// and `Expense.managerApprovedBy` already do. That is deliberate: declaring
// Prisma relations here would force back-relation fields onto `Employee` and
// `Organisation`, and those models must stay untouched.

/// Configurable service catalog. A ClientService and a Lead both point here.
model Service {
  id             String  @id @default(uuid())
  organisationId String
  code           String  @unique
  name           String
  isActive       Boolean @default(true)
  sortOrder      Int     @default(0)

  leads          Lead[]
  clientServices ClientService[]
  quotationItems QuotationItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

/// A prospect, BEFORE it becomes a client. Never deleted once converted.
model Lead {
  id             String @id @default(uuid())
  organisationId String
  /// Human-readable 'LD-1001'. Allocated server-side inside a transaction.
  leadCode       String @unique

  name               String
  contactNumber      String
  email              String?
  serviceId          String
  priceQuotedPaise   Int     @default(0)
  /// HRMS Employee id. No FK by design — see the section header.
  assignedEmployeeId String
  /// new | contacted | requirement_identified | quote_sent | negotiation | won | lost
  status             String  @default("new")
  notes              String?
  lostReason         String?

  /// Set once, by conversion. @unique is what makes a second client from one
  /// lead impossible at the database level rather than only in a handler.
  convertedClientId String?   @unique
  convertedAt       DateTime?

  service           Service            @relation(fields: [serviceId], references: [id])
  followUps         FollowUp[]
  quotations        Quotation[]
  engagementLetters EngagementLetter[]

  /// System-generated (§5.2). Never accepted from a request body.
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([status])
  @@index([assignedEmployeeId])
}

/// THE ONE CENTRAL CLIENT RECORD.
model Client {
  id             String @id @default(uuid())
  organisationId String
  /// Human-readable 'CLI-1001'.
  clientCode     String @unique

  companyName   String
  legalName     String?
  businessType  String?
  contactPerson String
  contactNumber String
  email         String?
  address       String?

  gstin String?
  pan   String?
  tan   String?

  accountManagerId String
  assignedTeam     String?
  /// active | onboarding | pending_documents | service_due | inactive
  status           String  @default("onboarding")
  onboardingDate   String
  notes            String?

  /// Back-link to the lead this client came from. @unique mirrors
  /// Lead.convertedClientId so the 1:1 holds from both directions.
  sourceLeadId String? @unique

  /// RESERVED FOR THE CLIENT PORTAL (§56). Modelled, no client-facing screen.
  portalEnabled     Boolean @default(false)
  portalInviteEmail String?

  /// Which of the firm's Zoho Payments accounts bills this client.
  /// Nullable — set once at onboarding, drives which invoice series
  /// applies and which account a payment is expected in
  /// (docs/zoho-payments/README.md §3 and §4).
  billingAccountId String?
  billingAccount   ZpayAccount? @relation(fields: [billingAccountId], references: [id])

  zpayExternalInvoices ZpayExternalInvoice[]

  contacts            ClientContact[]
  services            ClientService[]
  followUps           FollowUp[]
  documents           ClientDocument[]
  tasks               Task[]
  quotations          Quotation[]
  engagementLetters   EngagementLetter[]
  ewayBills           EwayBill[]
  gstProfile          GstProfile?
  eInvoiceEwbProfile  EInvoiceEwbProfile?
  eInvoiceIrns        EInvoiceIrn[]
  eInvoiceEwbPulls    EInvoiceEwbPullRun[]
  bkEngagement        BookkeepingEngagement?
  bkTasks             BookkeepingTask[]
  bkPendingItems      BookkeepingPendingItem[]
  bkDocumentRequests  BookkeepingDocumentRequest[]
  bkDeliverables      BookkeepingDeliverable[]
  bkActivities        BookkeepingActivity[]
  bkImports           BookkeepingImport[]
  registrations       ClientRegistration[]
  incCases            IncorporationCase[]
  incDocumentRequests IncorporationDocumentRequest[]
  incDeliverables     IncorporationDeliverable[]
  incFees             IncorporationFee[]
  aaBankAccounts      AaBankAccount[]
  aaSourceDocuments   AaSourceDocument[]
  aaJobs              AaJob[]
  aaGstFilings2B      AaGstFiling2B[]
  aaPurchaseRegisters AaPurchaseRegister[]
  aaGstReconJobs      AaGstReconJob[]
  aaTds26AS           AaTds26AS[]
  aaTdsBooks          AaTdsBooks[]
  aaTdsReconJobs      AaTdsReconJob[]

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  createdBy           String?
  updatedBy           String?
  deletedAt           DateTime?
  ClientChecklistItem ClientChecklistItem[]

  @@index([status])
  @@index([accountManagerId])
}

model ClientContact {
  id          String  @id @default(uuid())
  clientId    String
  name        String
  designation String?
  phone       String
  email       String?
  isPrimary   Boolean @default(false)

  client     Client               @relation(fields: [clientId], references: [id])
  incParties IncorporationParty[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([clientId])
}

/// A service sold to a client. The join between Client and the catalog.
model ClientService {
  id        String @id @default(uuid())
  clientId  String
  serviceId String

  assignedEmployeeId String
  managerId          String?
  /// 'YYYY-MM-DD' — a calendar date, so it cannot drift across the IST/UTC edge.
  dueDate            String?
  /// not_started | documents_pending | in_progress | under_review | ready |
  /// submitted | completed | failed | on_hold
  status             String    @default("not_started")
  startedAt          DateTime?
  completedAt        DateTime?
  notes              String?

  client   Client              @relation(fields: [clientId], references: [id])
  service  Service             @relation(fields: [serviceId], references: [id])
  tasks    Task[]
  incCases IncorporationCase[]
  incFees  IncorporationFee[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([clientId])
  @@index([assignedEmployeeId])
  @@index([status])
}

model Task {
  id                  String  @id @default(uuid())
  /// NULLABLE since the Task module: an internal task ("prepare the
  /// month-end pack") belongs to an employee, not to a client. Every
  /// pre-existing row still carries its client.
  clientId            String?
  /// The engagement a task belongs to — Workstation's "project".
  clientServiceId     String?
  /// Set when the task was raised from an Incorporation case. Nullable, so
  /// every existing Task row is untouched — this EXTENDS the one task engine
  /// rather than standing a second one up beside it.
  incorporationCaseId String?
  title               String
  description         String?
  assignedEmployeeId  String
  dueDate             String?
  /// pending | in_progress | paused | completed | cancelled
  /// Rows written before the Task module carry the legacy vocabulary
  /// (open | blocked | done); reads normalise it, writes never emit it.
  status              String  @default("open")

  // ── Task module (work-time tracking) ────────────────────────────────
  /// low | medium | high | urgent
  priority          String    @default("medium")
  /// The employee who raised/assigned it. Null on rows created before this.
  assignedById      String?
  estimatedMinutes  Int?
  /// DERIVED, never user-entered: the sum of closed work sessions.
  actualMinutes     Int       @default(0)
  /// DERIVED: elapsed wall-clock time minus actual work time.
  totalPauseMinutes Int       @default(0)
  /// Server timestamp of the FIRST start. Not reset by pause/resume.
  startedAt         DateTime?
  endedAt           DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  notes             String?
  attachmentUrl     String?

  client            Client?            @relation(fields: [clientId], references: [id])
  clientService     ClientService?     @relation(fields: [clientServiceId], references: [id])
  incorporationCase IncorporationCase? @relation(fields: [incorporationCaseId], references: [id], onDelete: SetNull)
  assignedEmployee  Employee           @relation("TaskAssignee", fields: [assignedEmployeeId], references: [id])
  assignedBy        Employee?          @relation("TaskAssigner", fields: [assignedById], references: [id])
  sessions          TaskTimeSession[]
  auditLogs         TaskAuditLog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([clientId])
  @@index([assignedEmployeeId])
  @@index([incorporationCaseId])
  @@index([status])
  @@index([dueDate])
  @@index([assignedEmployeeId, status])
  @@index([createdAt])
}

/// One stretch of work on a task. A task accumulates many of these; the
/// sum of their closed durations IS the task's actual work time, so the
/// number on screen can always be walked back to the sessions that made it.
///
/// An OPEN session (endedAt null) is the one being worked right now. The
/// partial unique index in prisma/sql/task-invariants.sql makes a second
/// open session on the same task impossible at the database, which is what
/// makes a double-clicked Start button harmless.
model TaskTimeSession {
  id              String    @id @default(uuid())
  taskId          String
  employeeId      String
  /// Server clock, always. A client-supplied timestamp is never accepted.
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  /// Whole minutes, written when the session closes. Null while open.
  durationMinutes Int?
  /// work — the only kind recorded. Pause is the ABSENCE of an open work
  /// session, and is derived, so a pause can never be double-counted.
  sessionType     String    @default("work")
  /// start | resume — why this session opened.
  openedBy        String    @default("start")
  /// pause | complete | cancel — why it closed. Null while open.
  closedBy        String?

  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([employeeId, startedAt])
  @@index([taskId, endedAt])
}

/// Append-only history of everything that happened to a task. There is no
/// update path and no delete path to this table anywhere in the module.
model TaskAuditLog {
  id                    String  @id @default(uuid())
  taskId                String
  /// task_created | task_assigned | task_reassigned | task_edited |
  /// task_started | task_paused | task_resumed | task_completed |
  /// task_cancelled | task_reopened
  action                String
  performedByUserId     String?
  performedByEmployeeId String?
  oldStatus             String?
  newStatus             String?
  metaJson              String?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  performedAt DateTime @default(now())

  @@index([taskId, performedAt])
  @@index([performedByEmployeeId])
}

/// ONE follow-up entity for BOTH leads and clients (§3). Exactly one of
/// leadId / clientId is set; the service layer enforces the XOR on write.
model FollowUp {
  id              String  @id @default(uuid())
  organisationId  String
  leadId          String?
  clientId        String?
  clientServiceId String?

  title                 String
  /// call | whatsapp | email | meeting | document_request | payment_followup |
  /// service_followup | other
  type                  String   @default("call")
  /// A point in time — the follow-up's date AND time.
  scheduledAt           DateTime
  assignedEmployeeId    String
  /// pending | completed | rescheduled | cancelled | missed
  status                String   @default("pending")
  notes                 String?
  reminderMinutesBefore Int?

  completedByEmployeeId String?
  completedAt           DateTime?
  completionNotes       String?

  lead   Lead?   @relation(fields: [leadId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([scheduledAt])
  @@index([assignedEmployeeId, status])
  @@index([clientId])
  @@index([leadId])
}

model DocumentCategory {
  id             String  @id @default(uuid())
  organisationId String
  /// gst | it_filing | basic | other
  code           String  @unique
  name           String
  description    String?
  sortOrder      Int     @default(0)

  documents ClientDocument[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

/// CLIENT-CENTRIC (§10.7). clientId is REQUIRED; clientServiceId is only a
/// tag. There is deliberately no per-service document store.
///
/// Named ClientDocument rather than §17's bare `Document` because
/// `EmployeeDocument` already exists for HRMS and the two must never be
/// confused at a call site.
model ClientDocument {
  id              String  @id @default(uuid())
  clientId        String
  categoryId      String
  /// Optional tag only — a document belongs to the CLIENT, not the service.
  clientServiceId String?

  name           String
  financialYear  String?
  /// requested | pending | uploaded | under_review | verified | rejected | expired
  status         String  @default("requested")
  /// Points at the highest ClientDocumentVersion.version. 0 = nothing uploaded yet.
  currentVersion Int     @default(0)

  requestedByEmployeeId String?
  requestedAt           DateTime?
  verifiedByEmployeeId  String?
  verifiedAt            DateTime?
  rejectionReason       String?
  expiryDate            String?

  client              Client                         @relation(fields: [clientId], references: [id])
  category            DocumentCategory               @relation(fields: [categoryId], references: [id])
  versions            ClientDocumentVersion[]
  bkDocumentRequests  BookkeepingDocumentRequest[]
  bkDeliverables      BookkeepingDeliverable[]
  incDocumentRequests IncorporationDocumentRequest[]
  incFilings          IncorporationFiling[]
  incQueries          IncorporationQuery[]
  incDeliverables     IncorporationDeliverable[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([clientId])
  @@index([categoryId])
  @@index([status])
}

/// Never overwrite (§10.6). An upload appends v1 → v2 → v3, each with its own
/// fileKey and therefore its own signed download URL.
model ClientDocumentVersion {
  id                String   @id @default(uuid())
  documentId        String
  version           Int
  fileKey           String
  /// An HRMS employee id, or the literal 'portal' when the future Client
  /// Portal delivered it. Seeded both ways so the receiving path is exercised.
  uploadedBy        String
  uploadedAt        DateTime @default(now())
  sizeBytes         Int      @default(0)
  notes             String?
  previousVersionId String?

  document ClientDocument @relation(fields: [documentId], references: [id])

  createdAt DateTime @default(now())

  @@unique([documentId, version])
  @@index([documentId])
}

model GstProfile {
  id       String @id @default(uuid())
  clientId String @unique
  gstin    String

  /// active | cancelled | suspended | not_registered
  registrationStatus String    @default("active")
  /// monthly | quarterly
  filingFrequency    String    @default("monthly")
  registrationDate   String?
  assignedEmployeeId String
  /// Mirrors the GST service status values (§7.7).
  serviceStatus      String    @default("not_started")
  lastFiledAt        DateTime?
  nextDueDate        String?

  // ── GST compliance service (§11) ────────────────────────────────────
  /// Legal name as printed on the certificate, when it differs from the
  /// client's trading name.
  legalName          String?
  pan                String?
  state              String?
  /// regular | composition | casual | isd | sez | non_resident
  registrationType   String  @default("regular")
  /// The second pair of eyes on this client's returns (§21).
  reviewerEmployeeId String?
  contactPerson      String?
  contactEmail       String?
  contactPhone       String?
  address            String?
  active             Boolean @default(true)

  client  Client                @relation(fields: [clientId], references: [id])
  filings GstFiling[]
  periods GstCompliancePeriod[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

model GstFiling {
  id                 String    @id @default(uuid())
  gstProfileId       String
  /// 'YYYY-MM' — the return period, e.g. '2026-08'.
  period             String
  /// GSTR-1 | GSTR-3B | GSTR-9
  returnType         String
  /// not_started | documents_pending | data_preparation | under_review |
  /// ready_to_file | filed | failed | completed
  status             String    @default("not_started")
  filedAt            DateTime?
  dueDate            String?
  assignedEmployeeId String
  arn                String?
  remarks            String?

  // ── GST compliance service ──────────────────────────────────────────
  /// The period this filing belongs to. NULLABLE because rows written
  /// before the compliance service have no period row; the service
  /// backfills one on first touch and never orphans an existing filing.
  compliancePeriodId String?
  financialYear      String?
  reviewerEmployeeId String?
  preparedAt         DateTime?
  reviewedAt         DateTime?

  /// Declared figures, paise. GSTR-1 uses the first two; GSTR-3B uses the
  /// liability trio. All nullable — a filing is a lifecycle row first and
  /// carries numbers only once prepared.
  taxableValue BigInt?
  taxAmount    BigInt?
  taxLiability BigInt?
  eligibleItc  BigInt?
  netPayable   BigInt?

  /// §31: filing is RECORDED, never transmitted. Audit OS has no GSTN
  /// connectivity, so `filedManually` is true for every filed row and the
  /// screens say so rather than implying an automated submission.
  filedManually Boolean @default(true)
  filedByUserId String?
  /// not_applicable | pending | completed
  paymentStatus String  @default("not_applicable")
  paymentDate   String?
  challanRef    String?

  gstProfile       GstProfile           @relation(fields: [gstProfileId], references: [id])
  compliancePeriod GstCompliancePeriod? @relation(fields: [compliancePeriodId], references: [id])
  drafts           GstReturnDraft[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([gstProfileId, period, returnType])
  @@index([status])
  @@index([compliancePeriodId])
  @@index([dueDate])
}

// ============================================================
// GST RETURN COMPOSITION
// ============================================================
// The GstFiling row above is the lifecycle record — "we owe a GSTR-1 for
// August, it's under review, ARN pending". The models below are the
// DATA of that return: the sectionised rows we would send to GSTN, and
// the roll-up numbers we'd declare in GSTR-3B.
//
// A filing can have several drafts over its life (compose → find an
// error → re-compose). Only the most recent draft with status
// 'ready_to_file' or beyond feeds submission; earlier drafts remain for
// audit. Immutability lands at 'submitted' — after that a fix cuts a
// new draft that supersedes.

/// GST rate slabs as data. Council changes land as new rows with a later
/// effectiveFrom; we never mutate an existing slab because past returns
/// must reproduce byte-for-byte. percentageBp is basis points to match
/// BooksTaxRate (1800 = 18%, 500 = 5%).
model GstRateSlab {
  id            String  @id @default(uuid())
  /// Rate in basis points: 0 | 500 | 1200 | 1800 | 2800.
  percentageBp  Int
  /// Display label like '18%'. UI-only convenience.
  label         String
  /// 'YYYY-MM-DD' — the date this slab first applies from.
  effectiveFrom String
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([percentageBp, effectiveFrom])
  @@index([isActive])
}

/// HSN/SAC master. Read-mostly reference table seeded with a starter set
/// covering the common goods and services categories; users add more
/// through settings as their book of business grows. Kept small on
/// purpose — a full 8-digit HSN roster is over 40k rows and only a
/// fraction is ever used by any one firm.
model HsnMaster {
  id            String  @id @default(uuid())
  /// 4/6/8-digit HSN or 6-digit SAC.
  code          String  @unique
  description   String
  /// goods | services
  kind          String  @default("goods")
  /// Default rate slab in bp (1800 = 18%). NULL when the code spans
  /// several rates and the user must pick per line.
  defaultRateBp Int?
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, isActive])
}

/// A composed return snapshot owned by a GstFiling row. `payloadJson`
/// mirrors the GSTN return JSON shape so submission is a pass-through,
/// but section-level detail also lives in GstReturnSection rows for
/// query, audit and per-row override without JSON parsing.
///
/// Immutable once status reaches 'submitted' — a subsequent re-compose
/// creates a NEW draft whose `supersedesId` points at the old one, and
/// flips the old draft's status to 'superseded'. This keeps the audit
/// trail contiguous even when a return is re-worked.
model GstReturnDraft {
  id          String @id @default(uuid())
  gstFilingId String
  /// 'YYYY-MM' — mirrors GstFiling.period.
  period      String
  /// GSTR-1 | GSTR-3B | GSTR-9
  returnType  String
  /// draft | ready_to_file | submitted | filed | rejected | superseded
  status      String @default("draft")
  /// Full return payload in GSTN-JSON shape. Kept as a String so it
  /// re-serialises byte-identically on read — critical because GSTN
  /// signs a hash of the exact bytes on submission.
  payloadJson String

  /// Roll-up totals in paise. Duplicated out of payloadJson so lists
  /// can filter and sort without deserialising every draft.
  totalTaxableValue BigInt @default(0)
  totalCgst         BigInt @default(0)
  totalSgst         BigInt @default(0)
  totalIgst         BigInt @default(0)
  totalCess         BigInt @default(0)
  invoiceCount      Int    @default(0)

  /// Set when this draft supersedes an earlier one after re-composition.
  supersedesId String?

  gstFiling GstFiling             @relation(fields: [gstFilingId], references: [id])
  sections  GstReturnSection[]
  liability GstLiabilitySnapshot?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([gstFilingId])
  @@index([period, returnType])
  @@index([status])
}

/// Sectionised row within a return draft. One row per invoice for b2b,
/// cdnr, exp; one aggregate row per (rate, place-of-supply) for b2cs;
/// one row per HSN code for the hsn summary. `sourceDocumentId` refs
/// the BooksDocument the row was composed from, and is NULL for
/// aggregate rows and hand-entered adjustments.
model GstReturnSection {
  id                String  @id @default(uuid())
  returnDraftId     String
  /// b2b | b2cl | b2cs | cdnr | cdnur | exp | at | atadj | nil | hsn | docs
  section           String
  /// Deterministic index within the section for stable ordering.
  ordinal           Int
  /// Buyer / counterparty GSTIN when applicable.
  counterpartyGstin String?
  counterpartyName  String?
  /// Rate slab in bp — 0, 500, 1200, 1800, 2800.
  rateBp            Int?
  hsnCode           String?
  invoiceNumber     String?
  /// 'YYYY-MM-DD'
  invoiceDate       String?
  /// GSTN state code, '33' = Tamil Nadu.
  placeOfSupply     String?
  isInterState      Boolean @default(false)
  /// All amounts in paise.
  taxableValue      BigInt  @default(0)
  cgst              BigInt  @default(0)
  sgst              BigInt  @default(0)
  igst              BigInt  @default(0)
  cess              BigInt  @default(0)
  /// BooksDocument the row was composed from; NULL for aggregates.
  sourceDocumentId  String?

  returnDraft GstReturnDraft @relation(fields: [returnDraftId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([returnDraftId, section])
  @@index([sourceDocumentId])
}

/// GSTR-3B liability roll-up — output tax, ITC, cash payable per head.
/// Derived from the outward return (GSTR-1) plus the ITC input from the
/// latest 2B reconciliation for the period. One snapshot per draft;
/// re-composing the draft overwrites it.
model GstLiabilitySnapshot {
  id            String @id @default(uuid())
  returnDraftId String @unique

  /// Output tax collected on outward supplies (paise).
  outputCgst BigInt @default(0)
  outputSgst BigInt @default(0)
  outputIgst BigInt @default(0)
  outputCess BigInt @default(0)

  /// Input tax credit for the period, taken from the latest AaGstReconJob.
  itcCgst BigInt @default(0)
  itcSgst BigInt @default(0)
  itcIgst BigInt @default(0)
  itcCess BigInt @default(0)

  /// Net cash payable per head, floored at zero (a credit balance carries
  /// forward, it does not become a refund on 3B).
  cashCgst BigInt @default(0)
  cashSgst BigInt @default(0)
  cashIgst BigInt @default(0)
  cashCess BigInt @default(0)

  /// Interest and late fee if filed after the due date.
  interest BigInt @default(0)
  lateFee  BigInt @default(0)

  returnDraft GstReturnDraft @relation(fields: [returnDraftId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// GST COMPLIANCE SERVICE
// ============================================================
// Workstation → Services → Registration → GST Registration.
//
// The spine is GstProfile (one per client, already above) →
// GstCompliancePeriod (one per financial year + tax period) → the four
// stages. GSTR-1 and GSTR-3B are NOT new tables: they are the existing
// GstFiling rows, keyed by returnType, now pointed at their period. A
// second returns table would have split the firm's filings across two
// engines, which is the same mistake the Task module avoided.
//
// Money is BigInt paise throughout, matching GstLiabilitySnapshot above.
// Employee ids are plain Strings with no relation, matching GstFiling —
// this module adds no relation to Employee.

/// One client's compliance obligation for one tax period. Everything a
/// period needs hangs off this row, so a client/period can never be read
/// across into another client's numbers.
model GstCompliancePeriod {
  id            String @id @default(uuid())
  gstProfileId  String
  /// '2026-27' — never hardcoded anywhere; derived from the period.
  financialYear String
  /// 'YYYY-MM' for monthly, 'YYYY-Q1'..'YYYY-Q4' for quarterly filers.
  period        String
  /// monthly | quarterly — copied from the profile at creation so a later
  /// change of frequency does not silently rewrite closed periods.
  periodType    String @default("monthly")

  /// DERIVED (§29), recomputed by the engine — never written by a client.
  /// not_started | in_progress | completed | overdue | exception
  overallStatus String  @default("not_started")
  /// The earliest unmet stage due date, for calendar and sorting (§30).
  nextDueDate   String?

  assignedEmployeeId String?
  reviewerEmployeeId String?
  managerEmployeeId  String?

  gstProfile     GstProfile         @relation(fields: [gstProfileId], references: [id])
  filings        GstFiling[]
  r2b            GstR2BRecord?
  reconciliation GstReconciliation?
  exceptions     GstException[]
  assignments    GstAssignment[]
  auditLogs      GstAuditLog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([gstProfileId, financialYear, period])
  @@index([overallStatus])
  @@index([nextDueDate])
  @@index([financialYear, period])
  @@index([assignedEmployeeId])
  @@index([reviewerEmployeeId])
}

/// GSTR-2B (§14). NOT a return anyone files — it is the auto-drafted ITC
/// statement, so its vocabulary is available/downloaded/reconciled and it
/// has no `filed` state and no ARN. One per compliance period.
model GstR2BRecord {
  id                 String @id @default(uuid())
  compliancePeriodId String @unique

  /// pending | expected | available | downloaded | reconciliation_pending |
  /// reconciliation_in_progress | reconciliation_completed | exceptions_found
  status        String  @default("pending")
  availableDate String?
  downloadDate  String?

  /// ITC in paise, as read from the 2B statement.
  totalItcCgst BigInt @default(0)
  totalItcSgst BigInt @default(0)
  totalItcIgst BigInt @default(0)
  totalItcCess BigInt @default(0)
  /// Roll-ups the reconciliation writes back, so a list can show the split
  /// without joining the item table.
  matchedItc   BigInt @default(0)
  mismatchItc  BigInt @default(0)

  missingInvoiceCount   Int @default(0)
  duplicateInvoiceCount Int @default(0)
  exceptionCount        Int @default(0)

  /// The Tools-side 2B upload this was read from, when one exists.
  sourceFiling2BId String?
  remarks          String?

  compliancePeriod GstCompliancePeriod @relation(fields: [compliancePeriodId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([status])
}

/// Books-vs-2B reconciliation for one period (§15/§16).
///
/// The MATCHING ITSELF is not reimplemented here. Tools already owns a
/// working engine (AaGstReconJob / GstMatchingService / the 2B parsers);
/// `reconJobId` points at that run and this row is the GST service's
/// summary of it. Items are copied into GstReconciliationItem as a working
/// paper so a reviewer's decision has somewhere to live — the accounting
/// records themselves stay in Books/Tally and are never duplicated.
model GstReconciliation {
  id                 String @id @default(uuid())
  compliancePeriodId String @unique

  /// pending | in_progress | completed | completed_with_exceptions
  status     String  @default("pending")
  /// The Tools-side run this summarises. Null until a run is attached.
  reconJobId String?

  totalInvoices       Int @default(0)
  matchedCount        Int @default(0)
  partialCount        Int @default(0)
  mismatchCount       Int @default(0)
  missingInBooksCount Int @default(0)
  missingIn2BCount    Int @default(0)
  duplicateCount      Int @default(0)
  reviewRequiredCount Int @default(0)

  /// Paise. booksItc − twoBItc is the §16 ITC difference, kept as stored
  /// columns so the dashboard aggregates in the database, not the browser.
  booksItc    BigInt @default(0)
  twoBItc     BigInt @default(0)
  matchedItc  BigInt @default(0)
  mismatchItc BigInt @default(0)
  missingItc  BigInt @default(0)

  startedAt   DateTime?
  completedAt DateTime?
  remarks     String?

  compliancePeriod GstCompliancePeriod     @relation(fields: [compliancePeriodId], references: [id], onDelete: Cascade)
  items            GstReconciliationItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([status])
}

/// One invoice line of a reconciliation — the working paper a reviewer
/// acts on. Both sides are held side by side so a mismatch shows WHAT
/// differs, not merely that something does.
model GstReconciliationItem {
  id               String @id @default(uuid())
  reconciliationId String

  /// matched | partial_match | mismatch | missing_in_books |
  /// missing_in_2b | duplicate | review_required
  matchStatus String

  supplierGstin String?
  invoiceNumber String?
  invoiceDate   String?

  /// Books side (paise). Null when the invoice is missing in books.
  booksTaxable BigInt?
  booksCgst    BigInt?
  booksSgst    BigInt?
  booksIgst    BigInt?
  booksTotal   BigInt?

  /// GSTR-2B side (paise). Null when the invoice is missing in 2B.
  twoBTaxable BigInt?
  twoBCgst    BigInt?
  twoBSgst    BigInt?
  twoBIgst    BigInt?
  twoBTotal   BigInt?

  /// Signed books − 2B on total tax, so a list can sort by worst first.
  taxDifference BigInt @default(0)

  /// open | accepted | disputed | resolved — the reviewer's decision.
  reviewStatus String    @default("open")
  reviewNote   String?
  reviewedBy   String?
  reviewedAt   DateTime?

  reconciliation GstReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  exceptions     GstException[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reconciliationId, matchStatus])
  @@index([reconciliationId, reviewStatus])
  @@index([supplierGstin])
  @@index([invoiceNumber])
}

/// An exception raised anywhere in the cycle (§25). Optionally points at
/// the reconciliation line that produced it, so "mismatch ₹12,000" can be
/// clicked through to the invoice.
model GstException {
  id                   String  @id @default(uuid())
  compliancePeriodId   String
  reconciliationItemId String?

  /// gstr1 | gstr2b | reconciliation | gstr3b | payment
  stage       String
  /// missing_gstr1_data | gstr2b_unavailable | invoice_mismatch |
  /// itc_mismatch | missing_invoice | duplicate_invoice | gstin_mismatch |
  /// tax_calculation_mismatch | gstr3b_pending | payment_pending
  issueType   String
  /// low | medium | high | critical
  severity    String  @default("medium")
  title       String
  description String?

  /// open | under_review | resolved
  status               String    @default("open")
  assignedToEmployeeId String?
  dueDate              String?
  resolution           String?
  resolvedBy           String?
  resolvedAt           DateTime?

  compliancePeriod   GstCompliancePeriod    @relation(fields: [compliancePeriodId], references: [id], onDelete: Cascade)
  reconciliationItem GstReconciliationItem? @relation(fields: [reconciliationItemId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([compliancePeriodId, status])
  @@index([status, severity])
  @@index([assignedToEmployeeId])
}

/// Every assignment ever made on a period (§21) — append-only, so "who was
/// on this in September" survives a later reassignment.
model GstAssignment {
  id                 String @id @default(uuid())
  compliancePeriodId String

  /// preparer | reviewer | approver
  role       String
  employeeId String
  /// gstr1 | gstr2b | reconciliation | gstr3b | period — what they own.
  stage      String @default("period")

  assignedByUserId String?
  assignedAt       DateTime  @default(now())
  /// Set when superseded; a null unassignedAt is the assignment in force.
  unassignedAt     DateTime?

  compliancePeriod GstCompliancePeriod @relation(fields: [compliancePeriodId], references: [id], onDelete: Cascade)

  @@index([compliancePeriodId, role])
  @@index([employeeId, unassignedAt])
}

/// Append-only audit trail (§32). No update path and no delete path to
/// this table exists anywhere in the module.
model GstAuditLog {
  id                 String  @id @default(uuid())
  compliancePeriodId String?
  gstProfileId       String?

  /// GST_CLIENT_CREATED | GSTR1_FILED | GSTR2B_DOWNLOADED |
  /// RECONCILIATION_COMPLETED | EXCEPTION_RESOLVED | PAYMENT_RECORDED | …
  action String
  /// gstr1 | gstr2b | reconciliation | gstr3b | payment | client | period
  stage  String?

  performedByUserId     String?
  performedByEmployeeId String?
  oldValue              String?
  newValue              String?
  metaJson              String?

  compliancePeriod GstCompliancePeriod? @relation(fields: [compliancePeriodId], references: [id], onDelete: Cascade)

  performedAt DateTime @default(now())

  @@index([compliancePeriodId, performedAt])
  @@index([gstProfileId, performedAt])
  @@index([action])
}

/// SIMULATED (§7.3 / §15). `isSimulated` defaults true and every response and
/// screen says so. Audit OS has no government e-way bill connectivity.
model EwayBill {
  id       String @id @default(uuid())
  clientId String
  ewbNo    String @unique

  documentNo            String
  documentDate          String
  fromGstin             String?
  toGstin               String?
  toPartyName           String?
  valuePaise            Int       @default(0)
  /// generated | active | cancelled | expired
  status                String    @default("generated")
  generatedAt           DateTime  @default(now())
  validUntil            String?
  /// Timestamp form of validUntil — the 24h expiry alert and the 8-hour
  /// extension window both need a point-in-time, not just a calendar day.
  expiresAt             DateTime?
  /// The originating EWB number. Each extension issues a NEW e-way bill
  /// number; this chains back to the first one so the 360-day cap can be
  /// measured against original generation, not the latest extension.
  originalEwbNo         String?
  /// Timestamp of the ORIGINAL generation (== generatedAt for a first
  /// issue; for extensions, this is the original's generatedAt copied
  /// over so the 360-day cap check does not need a chain lookup).
  originalGeneratedAt   DateTime?
  /// Count of extensions applied so far — for display.
  extensionCount        Int       @default(0)
  cancelledAt           DateTime?
  cancelReason          String?
  generatedByEmployeeId String
  isSimulated           Boolean   @default(true)

  client Client @relation(fields: [clientId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([clientId])
}

/// Per-client E-Invoice and E-Way Bill setup + monitoring config.
/// The firm does NOT generate IRNs or e-way bills — the client does that
/// inside its own ERP. This profile holds enablement status, the IRP the
/// client uses, MFA state and reconciliation cursor, plus the per-year
/// aggregate turnover used to derive e-invoice applicability. Every
/// threshold used against these fields lives in StatutoryRate, not in code.
model EInvoiceEwbProfile {
  id             String @id @default(uuid())
  clientId       String @unique
  /// JSON array of { fy: 'YYYY-YY', aatoPaise: bigInt }, all financial
  /// years from 2017-18 onwards. Applicability is derived from ANY year
  /// crossing the threshold (PAN-level, sticky once applicable).
  aatoByYearJson String @default("[]")

  /// Which of the six IRPs this client uses: einvoice1..einvoice6.
  /// Nullable — set once the client has registered.
  irp              String?
  irpRegisteredOn  String? // 'YYYY-MM-DD'
  /// direct | gsp | erp | none — API route for reporting invoices.
  einvoiceApiRoute String  @default("none")

  /// E-way bill API enablement — a per-client onboarding workflow the
  /// client performs themselves. Tracked here so the firm can see status.
  ewbApiEnabled  Boolean @default(false)
  ewbApiUsername String?
  ewbGsp         String?
  ewbVerifiedAt  String? // 'YYYY-MM-DD'

  /// MFA is mandatory on both portals since 1 April 2025. Every handoff
  /// tells the operator that the OTP goes to the client's registered
  /// mobile / Sandes / NIC-GST Shield.
  mfaActive Boolean @default(false)

  /// Reconciliation cursor — the last month for which our store holds
  /// pulled EWB and e-invoice data. Drives the "reconciled to …" copy on
  /// the page and gates alerts that need a full month present.
  reconciledThrough String? // 'YYYY-MM'

  client Client @relation(fields: [clientId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

/// SIMULATED. IRNs the client has (or hasn't yet) reported to the IRP.
/// The 30-day rule window is measured from documentDate — the alert engine
/// derives day-count against the config row, not a literal.
model EInvoiceIrn {
  id       String @id @default(uuid())
  clientId String

  documentNo      String
  documentDate    String // 'YYYY-MM-DD'
  /// INV | CRN | DBN — must be one of these per INV-01 schema.
  documentType    String  @default("INV")
  buyerGstin      String?
  buyerName       String?
  placeOfSupply   String? // mandatory in INV-01 — validation surfaces if missing
  totalValuePaise Int     @default(0)

  /// pending | reported | cancelled | expired (past 30-day rule)
  status       String    @default("pending")
  irn          String?   @unique
  reportedAt   DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  isSimulated  Boolean   @default(true)

  client Client @relation(fields: [clientId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([clientId, documentNo])
  @@index([clientId, documentDate])
  @@index([status])
}

/// Log of scheduled pull runs (monthly, per client, per kind). Kept because
/// the e-way bill portal retains only six months — reconciliation depends
/// on our store having each month before it drops from the portal. A run
/// row per month is the evidence that our continuous pull is caught up.
model EInvoiceEwbPullRun {
  id       String @id @default(uuid())
  clientId String

  /// ewb | einvoice
  kind        String
  /// 'YYYY-MM' — the month this run pulled.
  periodMonth String
  runAt       DateTime @default(now())
  recordCount Int      @default(0)
  /// scheduled | manual — how the run was triggered.
  source      String   @default("scheduled")
  /// ok | empty | failed — outcome; failed rows keep an error note.
  status      String   @default("ok")
  notes       String?

  client Client @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())

  @@index([clientId, kind, periodMonth])
}

/// The user-visible timeline (§11) — distinct from AuditLog, which is the
/// security trail. Append-only, so no deletedAt, like AuditLog.
model Activity {
  id             String @id @default(uuid())
  organisationId String
  /// lead | client
  subjectType    String
  subjectId      String

  /// 'lead.created', 'lead.status_changed', 'client.service_assigned', …
  action          String
  description     String
  actorUserId     String?
  actorEmployeeId String?
  entityType      String?
  entityId        String?
  metaJson        String?

  createdAt DateTime @default(now())

  @@index([subjectType, subjectId, createdAt])
}

// ============================================================
// TOOLS MODULE (Converters & Utilities)
// ============================================================
//
// One document model for every tool — no per-tool tables. The registry that
// drives the Tools page lives in code (src/modules/tools/registry.ts on both
// sides); these three catalogue tables are synced FROM it by the seed so a
// job row can reference a stable tool id and reporting can join on it.

model ToolCategory {
  id     String @id
  key    String @unique
  label  String
  order  Int
  /// active | coming_soon
  status String @default("active")

  groups ToolGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ToolGroup {
  id         String @id
  key        String @unique
  label      String
  categoryId String
  order      Int

  category ToolCategory @relation(fields: [categoryId], references: [id])
  tools    Tool[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tool {
  id            String @id
  key           String @unique
  name          String
  description   String
  groupId       String
  /// pdf | xlsx | docx | csv | txt | zip
  outputType    String
  permissionKey String
  /// active | coming_soon
  status        String @default("active")

  group ToolGroup @relation(fields: [groupId], references: [id])
  jobs  ToolJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A file the Tools module holds: either something a user uploaded as input
/// (`kind = input`) or something a tool generated (`kind = output`).
model ToolDocument {
  id               String  @id @default(uuid())
  organisationId   String
  userId           String
  /// input | output
  kind             String  @default("output")
  originalFilename String
  storedFilename   String
  mimeType         String
  fileSize         Int
  /// Key understood by the StorageAdapter — never a client-supplied path.
  storagePath      String
  /// Registry tool id that produced this document (null for raw uploads).
  sourceTool       String?
  parentDocumentId String?
  /// processing | completed | failed
  status           String  @default("completed")
  errorMessage     String?
  /// Free-form JSON — page count, table count, OCR confidence, signer info…
  metaJson         String?

  organisation Organisation          @relation(fields: [organisationId], references: [id])
  user         User                  @relation(fields: [userId], references: [id])
  versions     ToolDocumentVersion[]
  inputJobs    ToolJob[]             @relation("ToolJobInput")
  outputJobs   ToolJob[]             @relation("ToolJobOutput")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organisationId, userId])
  @@index([sourceTool])
  @@index([status])
  @@index([createdAt])
}

model ToolDocumentVersion {
  id          String @id @default(uuid())
  documentId  String
  version     Int
  storagePath String
  fileSize    Int

  document ToolDocument @relation(fields: [documentId], references: [id])

  createdAt DateTime @default(now())

  @@unique([documentId, version])
}

/// Every tool run — queued, processing, completed or failed — is one row here,
/// so the Documents detail drawer can show timing and the outcome uniformly.
model ToolJob {
  id               String    @id @default(uuid())
  toolId           String
  userId           String
  organisationId   String
  inputDocumentId  String?
  outputDocumentId String?
  /// queued | processing | completed | failed
  status           String    @default("queued")
  /// 0–100, reported by the service where it can be determinate.
  progress         Int       @default(0)
  errorMessage     String?
  /// Tool options + per-run facts (all input ids, page counts, warnings…).
  metaJson         String?
  startedAt        DateTime?
  completedAt      DateTime?

  tool           Tool          @relation(fields: [toolId], references: [id])
  user           User          @relation(fields: [userId], references: [id])
  organisation   Organisation  @relation(fields: [organisationId], references: [id])
  inputDocument  ToolDocument? @relation("ToolJobInput", fields: [inputDocumentId], references: [id])
  outputDocument ToolDocument? @relation("ToolJobOutput", fields: [outputDocumentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId, userId])
  @@index([toolId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// AUDIT AUTOMATION (AMENDMENT-02-REPOTIC-GAPS.md)
// Bank-statement ingestion pipeline. See plan file: revised upload
// flow with user-selected bank, password-protected PDF support,
// scanned-document rejection, per-client dedupe, adapter registry.
// ============================================================

/// Master list of supported banks. Rendered in the bank-picker on the
/// upload wireframe (amendment §3). Seeded from a code registry so a
/// new adapter adds a bank list entry automatically.
model AaBank {
  id     String  @id
  key    String  @unique
  name   String
  order  Int
  active Boolean @default(true)

  accounts        AaBankAccount[]
  sourceDocuments AaSourceDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A bank account belonging to a client — the auditor picks one before
/// uploading a statement. Full account number is intentionally NOT
/// stored on this slice; only the masked form (e.g. "•••4471"). Adding
/// an encrypted full number is a follow-on decision.
model AaBankAccount {
  id                  String  @id @default(uuid())
  organisationId      String
  clientId            String
  bankId              String
  /// Masked form for display, e.g. "•••4471".
  accountNumberMasked String
  /// Optional label (e.g. "Current — Payroll").
  label               String?
  currency            String  @default("INR")
  active              Boolean @default(true)

  organisation    Organisation       @relation(fields: [organisationId], references: [id])
  client          Client             @relation(fields: [clientId], references: [id])
  bank            AaBank             @relation(fields: [bankId], references: [id])
  sourceDocuments AaSourceDocument[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organisationId, clientId])
  @@index([bankId])
}

/// A statement record. This is NOT the encrypted PDF — per amendment
/// §1-Gap1 we store the extracted text (pdfjs TextItem[] per page,
/// with coordinates) at `extractionPath`, never a decrypted copy of
/// the PDF. `fileSha256` is the sha256 of the original uploaded bytes
/// (encrypted), which is what the auditor sees as "the file" and so
/// is the correct dedupe key per (clientId, fileSha256).
///
/// The password is deliberately absent — used to decrypt in memory
/// during upload preflight, then discarded. Never persisted anywhere.
model AaSourceDocument {
  id                String  @id @default(uuid())
  organisationId    String
  clientId          String
  uploadedByUserId  String
  bankId            String
  bankAccountId     String
  originalFilename  String
  mimeType          String
  fileSize          Int
  fileSha256        String
  /// Storage key for the JSON extraction blob (never the decrypted PDF).
  extractionPath    String
  pageCount         Int
  /// Sum of text bytes across pages — the text-layer signal.
  textLayerBytes    Int
  encrypted         Boolean @default(false)
  /// "Page N of M" M value where the footer was found; null otherwise.
  declaredPageCount Int?

  organisation Organisation  @relation(fields: [organisationId], references: [id])
  client       Client        @relation(fields: [clientId], references: [id])
  uploadedBy   User          @relation(fields: [uploadedByUserId], references: [id])
  bank         AaBank        @relation(fields: [bankId], references: [id])
  bankAccount  AaBankAccount @relation(fields: [bankAccountId], references: [id])
  jobs         AaJob[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// Per-client dedupe key (amendment §4-Prompt2-1(d)). A second upload
  /// of the same file for the same client is refused with a link to the
  /// existing job.
  @@unique([clientId, fileSha256])
  @@index([organisationId, clientId])
  @@index([bankId])
}

/// One pipeline run per uploaded statement. Status walks
/// queued → extracting → extracted | failed. This slice's extractor
/// is a stub; row-extraction + balance chain are follow-on slices.
model AaJob {
  id               String    @id @default(uuid())
  sourceDocumentId String
  organisationId   String
  clientId         String
  createdByUserId  String
  /// queued | extracting | extracted | failed
  status           String    @default("queued")
  progress         Int       @default(0)
  /// Non-blocking condition flags: ADAPTER_UNCERTAIN, ADAPTER_MISMATCH,
  /// PAGE_COUNT_MISMATCH, UNKNOWN_FORMAT.
  flags            String    @default("")
  errorMessage     String?
  /// Adapter id, detect score, page counts, extractor facts. Never a
  /// password — password is destructured out at the route boundary.
  metaJson         String?
  startedAt        DateTime?
  completedAt      DateTime?

  sourceDocument AaSourceDocument @relation(fields: [sourceDocumentId], references: [id])
  organisation   Organisation     @relation(fields: [organisationId], references: [id])
  client         Client           @relation(fields: [clientId], references: [id])
  createdBy      User             @relation(fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId, clientId])
  @@index([sourceDocumentId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// AUDIT AUTOMATION · GST RECONCILIATION
// GSTR-2B (inward supplies from GSTN) vs Purchase Register
// (client's book). See plan for the parsers and matching engine.
// ============================================================

/// One uploaded GSTR-2B filing (from the GSTN portal, JSON or Excel).
/// Per-(client, sha256) dedupe like AaSourceDocument.
model AaGstFiling2B {
  id               String    @id @default(uuid())
  organisationId   String
  clientId         String
  uploadedByUserId String
  /// 1..12
  periodMonth      Int
  periodYear       Int
  /// json | excel
  sourceFormat     String
  originalFilename String
  fileSize         Int
  fileSha256       String
  storagePath      String
  /// Client's own GSTIN this filing was pulled for.
  gstin            String?
  /// When GSTN generated the 2B (from the file's own metadata).
  generatedAt      DateTime?

  organisation Organisation         @relation(fields: [organisationId], references: [id])
  client       Client               @relation(fields: [clientId], references: [id])
  uploadedBy   User                 @relation(fields: [uploadedByUserId], references: [id])
  entries      AaGstFiling2BEntry[]
  reconJobs    AaGstReconJob[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([clientId, fileSha256])
  @@index([organisationId, clientId])
  @@index([periodYear, periodMonth])
}

/// One line item inside a GSTR-2B filing. Sections map to the JSON
/// envelope: b2b | cdnr | isd | impg | imps + amendments b2ba|cdnra|isda.
model AaGstFiling2BEntry {
  id            String  @id @default(uuid())
  filingId      String
  section       String
  supplierGstin String
  supplierName  String?
  invoiceNumber String
  /// YYYY-MM-DD to keep the calendar date IST-stable.
  invoiceDate   String
  /// Amounts in paise (INR minor units) — Int for exact arithmetic.
  taxableValue  Int
  igst          Int     @default(0)
  cgst          Int     @default(0)
  sgst          Int     @default(0)
  cess          Int     @default(0)
  /// GSTN's own "ITC Available" flag from the 2B row.
  itcAvailable  Boolean @default(true)
  /// Original source row as JSON so we can re-parse later if needed.
  rawJson       String?

  filing    AaGstFiling2B   @relation(fields: [filingId], references: [id])
  reconRows AaGstReconRow[] @relation("Filing2BEntryToReconRow")

  @@index([filingId])
  @@index([supplierGstin, invoiceNumber])
}

/// One uploaded Purchase Register (client's book — Excel with a column
/// map, or Tally XML). Per-(client, sha256) dedupe.
model AaPurchaseRegister {
  id               String  @id @default(uuid())
  organisationId   String
  clientId         String
  uploadedByUserId String
  periodMonth      Int
  periodYear       Int
  /// excel | tally_xml
  sourceFormat     String
  originalFilename String
  fileSize         Int
  fileSha256       String
  storagePath      String
  /// { supplierGstin: 'B', invoiceNumber: 'D', ... } for Excel; null for Tally XML.
  columnMapJson    String?

  organisation Organisation              @relation(fields: [organisationId], references: [id])
  client       Client                    @relation(fields: [clientId], references: [id])
  uploadedBy   User                      @relation(fields: [uploadedByUserId], references: [id])
  entries      AaPurchaseRegisterEntry[]
  reconJobs    AaGstReconJob[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([clientId, fileSha256])
  @@index([organisationId, clientId])
  @@index([periodYear, periodMonth])
}

/// One line item inside a Purchase Register.
model AaPurchaseRegisterEntry {
  id            String  @id @default(uuid())
  registerId    String
  supplierGstin String
  supplierName  String?
  invoiceNumber String
  invoiceDate   String
  taxableValue  Int
  igst          Int     @default(0)
  cgst          Int     @default(0)
  sgst          Int     @default(0)
  cess          Int     @default(0)
  /// Ledger / GL code from the register (optional).
  glCode        String?
  rawJson       String?

  register  AaPurchaseRegister @relation(fields: [registerId], references: [id])
  reconRows AaGstReconRow[]    @relation("PurchaseRegisterEntryToReconRow")

  @@index([registerId])
  @@index([supplierGstin, invoiceNumber])
}

/// One reconciliation run pairing a 2B filing with a PR for a client.
model AaGstReconJob {
  id                 String    @id @default(uuid())
  organisationId     String
  clientId           String
  createdByUserId    String
  filing2BId         String
  purchaseRegisterId String
  /// queued | matching | matched | failed
  status             String    @default("queued")
  progress           Int       @default(0)
  matchedCount       Int       @default(0)
  partialCount       Int       @default(0)
  only2BCount        Int       @default(0)
  onlyPRCount        Int       @default(0)
  /// { matched: {taxable, igst, cgst, sgst, cess}, partial: {...}, only_2b: {...}, only_pr: {...} } — paise.
  totalsJson         String?
  errorMessage       String?
  startedAt          DateTime?
  completedAt        DateTime?

  organisation     Organisation       @relation(fields: [organisationId], references: [id])
  client           Client             @relation(fields: [clientId], references: [id])
  createdBy        User               @relation(fields: [createdByUserId], references: [id])
  filing2B         AaGstFiling2B      @relation(fields: [filing2BId], references: [id])
  purchaseRegister AaPurchaseRegister @relation(fields: [purchaseRegisterId], references: [id])
  rows             AaGstReconRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId, clientId])
  @@index([status])
  @@index([createdAt])
}

/// One row of the reconciliation result. Either or both entry refs may be
/// set: matched/partial rows carry both; only_2b / only_pr rows carry one.
model AaGstReconRow {
  id                      String    @id @default(uuid())
  jobId                   String
  /// matched | partial | only_2b | only_pr
  matchStatus             String
  filing2BEntryId         String?
  purchaseRegisterEntryId String?
  /// Comma-separated field names that differ on partial matches
  /// (taxable_value | tax_split | invoice_date | supplier_gstin).
  mismatchFields          String    @default("")
  /// eligible | ineligible | reversal | blocked (auditor-overridable).
  itcClassification       String    @default("eligible")
  auditorNote             String?
  reviewedByUserId        String?
  reviewedAt              DateTime?

  job                   AaGstReconJob            @relation(fields: [jobId], references: [id])
  filing2BEntry         AaGstFiling2BEntry?      @relation("Filing2BEntryToReconRow", fields: [filing2BEntryId], references: [id])
  purchaseRegisterEntry AaPurchaseRegisterEntry? @relation("PurchaseRegisterEntryToReconRow", fields: [purchaseRegisterEntryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId, matchStatus])
  @@index([filing2BEntryId])
  @@index([purchaseRegisterEntryId])
}

// ============================================================
// AUDIT AUTOMATION · TDS RECONCILIATION
// Form 26AS (TDS credits reported by deductors) vs client's TDS books.
// ============================================================

/// One uploaded Form 26AS (TRACES text or Excel).
model AaTds26AS {
  id                String    @id @default(uuid())
  organisationId    String
  clientId          String
  uploadedByUserId  String
  /// Client PAN (from the 26AS header).
  pan               String?
  /// AY (e.g. 2027 for AY 2026-27, i.e. FY 2026-27).
  assessmentYear    Int
  /// text | excel
  sourceFormat      String
  originalFilename  String
  fileSize          Int
  fileSha256        String
  storagePath       String
  /// From the 26AS header (View As on date / Generated on).
  tracesGeneratedAt DateTime?

  organisation Organisation     @relation(fields: [organisationId], references: [id])
  client       Client           @relation(fields: [clientId], references: [id])
  uploadedBy   User             @relation(fields: [uploadedByUserId], references: [id])
  entries      AaTds26ASEntry[]
  reconJobs    AaTdsReconJob[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([clientId, fileSha256])
  @@index([organisationId, clientId])
  @@index([assessmentYear])
}

/// One line-item inside a 26AS. `part` identifies the 26AS section
/// (Part A = TDS on salary, A1 = TDS other than salary, A2 = TDS on
/// sale of immovable property, Part B = TCS, Part C = tax paid).
model AaTds26ASEntry {
  id           String  @id @default(uuid())
  filingId     String
  /// part_a | part_a1 | part_a2 | part_b | part_c
  part         String
  /// Bare TDS section code (e.g. "194C", "192", "195").
  section      String
  deductorTan  String
  deductorName String?
  /// Q1 | Q2 | Q3 | Q4
  quarter      String
  /// Amounts in paise (INR minor units) for exact arithmetic.
  amountPaid   Int     @default(0)
  tdsAmount    Int     @default(0)
  /// Date TDS was deducted / booked (YYYY-MM-DD, IST calendar).
  tdsDate      String
  /// TRACES status (Booked / Provisional / etc.), free text.
  status       String?
  rawJson      String?

  filing    AaTds26AS       @relation(fields: [filingId], references: [id])
  reconRows AaTdsReconRow[] @relation("Tds26ASEntryToReconRow")

  @@index([filingId])
  @@index([deductorTan, section, quarter])
}

/// One uploaded Books TDS register (Excel + column map, or Tally XML).
model AaTdsBooks {
  id               String  @id @default(uuid())
  organisationId   String
  clientId         String
  uploadedByUserId String
  assessmentYear   Int
  /// excel | tally_xml
  sourceFormat     String
  originalFilename String
  fileSize         Int
  fileSha256       String
  storagePath      String
  /// Column map (JSON) — only set for Excel uploads.
  columnMapJson    String?

  organisation Organisation      @relation(fields: [organisationId], references: [id])
  client       Client            @relation(fields: [clientId], references: [id])
  uploadedBy   User              @relation(fields: [uploadedByUserId], references: [id])
  entries      AaTdsBooksEntry[]
  reconJobs    AaTdsReconJob[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([clientId, fileSha256])
  @@index([organisationId, clientId])
  @@index([assessmentYear])
}

/// One entry inside a Books TDS register.
model AaTdsBooksEntry {
  id           String  @id @default(uuid())
  booksId      String
  section      String
  deductorTan  String
  deductorName String?
  quarter      String
  amountPaid   Int     @default(0)
  tdsAmount    Int     @default(0)
  tdsDate      String
  glCode       String?
  rawJson      String?

  books     AaTdsBooks      @relation(fields: [booksId], references: [id])
  reconRows AaTdsReconRow[] @relation("TdsBooksEntryToReconRow")

  @@index([booksId])
  @@index([deductorTan, section, quarter])
}

/// One TDS reconciliation run pairing a 26AS with a Books register.
model AaTdsReconJob {
  id              String    @id @default(uuid())
  organisationId  String
  clientId        String
  createdByUserId String
  filing26ASId    String
  booksId         String
  /// queued | matching | matched | failed
  status          String    @default("queued")
  progress        Int       @default(0)
  verifiedCount   Int       @default(0)
  varianceCount   Int       @default(0)
  only26ASCount   Int       @default(0)
  onlyBooksCount  Int       @default(0)
  /// { verified: { amount_paid, tds_amount, count }, variance: {...}, ... } — paise.
  totalsJson      String?
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?

  organisation Organisation    @relation(fields: [organisationId], references: [id])
  client       Client          @relation(fields: [clientId], references: [id])
  createdBy    User            @relation(fields: [createdByUserId], references: [id])
  filing26AS   AaTds26AS       @relation(fields: [filing26ASId], references: [id])
  books        AaTdsBooks      @relation(fields: [booksId], references: [id])
  rows         AaTdsReconRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId, clientId])
  @@index([status])
  @@index([createdAt])
}

/// One row of a TDS recon result. Either or both entry refs may be set.
model AaTdsReconRow {
  id                String    @id @default(uuid())
  jobId             String
  /// verified | variance | only_26as | only_books
  matchStatus       String
  filing26ASEntryId String?
  booksEntryId      String?
  /// Comma-separated: tds_amount | amount_paid | tds_date | section
  mismatchFields    String    @default("")
  /// no_action | chase_deductor | revise_book | credit_claimed | written_off
  actionStatus      String    @default("no_action")
  auditorNote       String?
  reviewedByUserId  String?
  reviewedAt        DateTime?

  job             AaTdsReconJob    @relation(fields: [jobId], references: [id])
  filing26ASEntry AaTds26ASEntry?  @relation("Tds26ASEntryToReconRow", fields: [filing26ASEntryId], references: [id])
  booksEntry      AaTdsBooksEntry? @relation("TdsBooksEntryToReconRow", fields: [booksEntryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId, matchStatus])
  @@index([filing26ASEntryId])
  @@index([booksEntryId])
}

// ============================================================
// TALLY — native double-entry accounting module (AUDITOSTALLYMODULEPROMPT.md)
// Foundation slice: companies, financial years, groups, ledgers.
// Every table carries tallyCompanyId; every service enforces strict
// (organisationId, tallyCompanyId) isolation. Money in paise (Int).
// ============================================================

/// One accounting company (Tally-equivalent). A user's Organisation
/// may hold many companies; each is fully isolated from the others.
model TallyCompany {
  id                  String  @id @default(uuid())
  organisationId      String
  name                String
  mailingName         String?
  address             String?
  country             String  @default("India")
  state               String?
  pin                 String?
  phone               String?
  email               String?
  website             String?
  baseCurrency        String  @default("INR")
  /// regular | composition | unregistered | sez | overseas
  gstRegistrationType String  @default("regular")
  gstin               String?
  pan                 String?
  tan                 String?
  /// Month the financial year begins (Indian FY = 4 / April).
  fyBeginMonth        Int     @default(4)
  /// Calendar date books opened (YYYY-MM-DD, IST-stable).
  booksBeginFrom      String
  active              Boolean @default(true)

  organisation   Organisation         @relation(fields: [organisationId], references: [id])
  financialYears TallyFinancialYear[]
  groups         TallyGroup[]
  ledgers        TallyLedger[]

  voucherTypes    TallyVoucherType[]
  vouchers        TallyVoucher[]
  stockGroups     TallyStockGroup[]
  stockCategories TallyStockCategory[]
  units           TallyUnit[]
  godowns         TallyGodown[]
  stockItems      TallyStockItem[]
  statementLines  TallyBankStatementLine[]
  reconciliations TallyBankReconciliation[]
  taxRates        TallyTaxRate[]
  settings        TallySetting[]
  employees       TallyEmployee[]
  payHeads        TallyPayHead[]
  payrollRuns     TallyPayrollRun[]
  backups         TallyBackup[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organisationId, name])
  @@index([organisationId])
}

/// Financial year for a Tally company. Every future voucher will
/// belong to exactly one FY; posting into a closed FY is rejected.
model TallyFinancialYear {
  id             String  @id @default(uuid())
  tallyCompanyId String
  /// Human label, e.g. "2026-27".
  label          String
  startDate      String
  endDate        String
  closed         Boolean @default(false)

  company        TallyCompany   @relation(fields: [tallyCompanyId], references: [id])
  ledgersOpening TallyLedger[]  @relation("LedgerOpeningInFY")
  vouchers       TallyVoucher[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tallyCompanyId, label])
  @@index([tallyCompanyId])
}

/// Group of ledgers — the top of the account tree. Seeded with 17
/// primary groups per company at creation time (Capital, Sundry
/// Debtors, etc.). Sub-groups reference `parentGroupId`.
model TallyGroup {
  id             String  @id @default(uuid())
  tallyCompanyId String
  name           String
  parentGroupId  String?
  /// assets | liabilities | income | expenses
  nature         String
  /// Whether balances under this group hit P&L (vs Balance Sheet only).
  affectsPL      Boolean @default(false)
  /// Primary groups are seeded and cannot be deleted.
  isPrimary      Boolean @default(false)

  company     TallyCompany  @relation(fields: [tallyCompanyId], references: [id])
  parentGroup TallyGroup?   @relation("TallyGroupParent", fields: [parentGroupId], references: [id])
  children    TallyGroup[]  @relation("TallyGroupParent")
  ledgers     TallyLedger[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([tallyCompanyId, name])
  @@index([tallyCompanyId])
  @@index([parentGroupId])
}

/// A ledger — the leaves of the account tree. Opening balances land
/// here; posted voucher lines (Slice 2+) reference these.
model TallyLedger {
  id                     String  @id @default(uuid())
  tallyCompanyId         String
  name                   String
  groupId                String
  /// Amount in PAISE — never floats.
  openingBalancePaise    Int     @default(0)
  /// dr | cr — which side the opening balance sits on.
  openingBalanceType     String  @default("dr")
  /// FY the opening balance applies to.
  openingBalanceAsOfFyId String?
  address                String?
  contact                String?
  gstin                  String?
  pan                    String?
  state                  String?
  /// regular | composition | unregistered | sez | overseas
  gstRegistrationType    String?
  creditPeriodDays       Int?
  bankAccountName        String?
  bankAccountNumber      String?
  bankIfsc               String?
  /// JSON blob for default tax config (rate, HSN, etc.).
  taxConfigJson          String?
  active                 Boolean @default(true)

  company            TallyCompany        @relation(fields: [tallyCompanyId], references: [id])
  group              TallyGroup          @relation(fields: [groupId], references: [id])
  openingBalanceAsOf TallyFinancialYear? @relation("LedgerOpeningInFY", fields: [openingBalanceAsOfFyId], references: [id])

  entries         TallyVoucherEntry[]
  partyVouchers   TallyVoucher[]            @relation("TallyVoucherParty")
  allocations     TallyBillAllocation[]
  statementLines  TallyBankStatementLine[]
  reconciliations TallyBankReconciliation[]
  payHeads        TallyPayHead[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([tallyCompanyId, name])
  @@index([tallyCompanyId])
  @@index([groupId])
}

// ============================================================
// TALLY — accounting engine (Slice 2+): vouchers, inventory,
// banking, GST, payroll, audit.
// ============================================================
//
// THE ONE WRITER of financial state is TallyVoucher + TallyVoucherEntry,
// written only through engine/posting.ts inside a Prisma transaction.
// Every report (trial balance, P&L, balance sheet, outstandings, stock,
// GST) is DERIVED from those rows plus TallyLedger opening balances —
// nothing anywhere caches or recomputes a total by hand.
//
// MONEY: integer PAISE (matching TallyLedger.openingBalancePaise).
// QUANTITY: integer MILLI-UNITS (qty x 1000) so 0.001 of a unit is
// representable without floats.
// DATES: calendar dates are IST-stable 'YYYY-MM-DD' strings.

/// A voucher type. Seeded per company with the 17 Tally-style defaults;
/// users may add their own (e.g. "Cash Sales") under a parent type.
/// Numbering state lives here — `currentNumber` is bumped inside the
/// same transaction that writes the voucher, so numbers never collide.
model TallyVoucherType {
  id              String  @id @default(uuid())
  tallyCompanyId  String
  name            String
  /// payment | receipt | contra | journal | sales | purchase | debit_note |
  /// credit_note | sales_order | purchase_order | quotation | delivery_note |
  /// receipt_note | stock_journal | physical_stock | rejections_in |
  /// rejections_out | payroll
  code            String
  /// auto | manual
  numberingMethod String  @default("auto")
  prefix          String?
  suffix          String?
  startNumber     Int     @default(1)
  currentNumber   Int     @default(0)
  /// Does this type post double-entry accounting lines?
  affectsAccounts Boolean @default(true)
  /// Does this type move stock?
  affectsStock    Boolean @default(false)
  /// Order-type vouchers (SO/PO/Quotation) record commitments only —
  /// they post neither accounts nor stock until converted.
  isOrder         Boolean @default(false)
  isDefault       Boolean @default(false)
  active          Boolean @default(true)

  company  TallyCompany   @relation(fields: [tallyCompanyId], references: [id])
  vouchers TallyVoucher[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([tallyCompanyId, name])
  @@index([tallyCompanyId, code])
}

/// A voucher — the transaction header. Accounting lines hang off
/// TallyVoucherEntry, stock lines off TallyVoucherItem. A voucher whose
/// type affectsAccounts is rejected at post time unless total debit ==
/// total credit (integrity rule 1).
model TallyVoucher {
  id                String  @id @default(uuid())
  tallyCompanyId    String
  financialYearId   String
  voucherTypeId     String
  /// Denormalised type code so registers/filters never need the join.
  voucherTypeCode   String
  voucherNumber     String
  /// 'YYYY-MM-DD', IST-stable.
  date              String
  referenceNumber   String?
  referenceDate     String?
  narration         String?
  /// Customer / supplier / employee ledger for party-facing vouchers.
  partyLedgerId     String?
  /// Two-digit state code of the place of supply (GST).
  placeOfSupply     String?
  /// active | cancelled
  status            String  @default("active")
  /// Denormalised roll-ups, always written from the lines by the engine.
  totalDebitPaise   Int     @default(0)
  totalCreditPaise  Int     @default(0)
  taxableValuePaise Int     @default(0)
  cgstPaise         Int     @default(0)
  sgstPaise         Int     @default(0)
  igstPaise         Int     @default(0)
  cessPaise         Int     @default(0)
  roundOffPaise     Int     @default(0)
  grandTotalPaise   Int     @default(0)
  dueDate           String?
  /// Optimistic-lock / edit counter. Every alteration writes a
  /// TallyVoucherRevision and bumps this.
  version           Int     @default(1)

  createdByUserId   String?
  modifiedByUserId  String?
  cancelledByUserId String?
  cancelledAt       DateTime?
  cancelReason      String?

  company       TallyCompany           @relation(fields: [tallyCompanyId], references: [id])
  financialYear TallyFinancialYear     @relation(fields: [financialYearId], references: [id])
  voucherType   TallyVoucherType       @relation(fields: [voucherTypeId], references: [id])
  partyLedger   TallyLedger?           @relation("TallyVoucherParty", fields: [partyLedgerId], references: [id])
  entries       TallyVoucherEntry[]
  items         TallyVoucherItem[]
  allocations   TallyBillAllocation[]
  revisions     TallyVoucherRevision[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([tallyCompanyId, voucherTypeId, voucherNumber])
  @@index([tallyCompanyId, date])
  @@index([tallyCompanyId, voucherTypeCode, date])
  @@index([tallyCompanyId, partyLedgerId])
  @@index([financialYearId])
}

/// One debit or credit line of a voucher. The sole source of every
/// ledger balance in the system.
model TallyVoucherEntry {
  id             String  @id @default(uuid())
  tallyCompanyId String
  voucherId      String
  ledgerId       String
  /// dr | cr
  entryType      String
  amountPaise    Int
  narration      String?
  position       Int     @default(0)
  /// Marks the party line so receivable/payable reports can find it.
  isPartyLedger  Boolean @default(false)
  costCentre     String?

  /// Bank reconciliation state (only meaningful on bank-ledger lines).
  bankDate            String?
  reconciledAt        DateTime?
  reconciledByUserId  String?
  bankStatementLineId String?   @unique

  voucher       TallyVoucher            @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  ledger        TallyLedger             @relation(fields: [ledgerId], references: [id])
  allocations   TallyBillAllocation[]
  statementLine TallyBankStatementLine? @relation(fields: [bankStatementLineId], references: [id])

  createdAt DateTime @default(now())

  @@index([tallyCompanyId, ledgerId])
  @@index([voucherId])
  @@index([ledgerId])
}

/// Bill-wise allocation — what an invoice creates and what a payment
/// settles. Outstanding = sum(new) - sum(against) per bill reference.
model TallyBillAllocation {
  id             String  @id @default(uuid())
  tallyCompanyId String
  voucherId      String
  voucherEntryId String
  ledgerId       String
  /// The bill reference this row is about (usually the invoice number).
  billRef        String
  /// new | against | advance | on_account
  method         String
  amountPaise    Int
  dueDate        String?
  /// 'YYYY-MM-DD' of the voucher, copied for ageing without a join.
  date           String

  voucher      TallyVoucher      @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  voucherEntry TallyVoucherEntry @relation(fields: [voucherEntryId], references: [id], onDelete: Cascade)
  ledger       TallyLedger       @relation(fields: [ledgerId], references: [id])

  createdAt DateTime @default(now())

  @@index([tallyCompanyId, ledgerId, billRef])
  @@index([voucherId])
}

/// A stock line of a voucher: what moved, how much, at what rate, and
/// the tax that line carried. Stock reports read these (joined to an
/// active voucher) — quantities are never stored as a running total.
model TallyVoucherItem {
  id             String  @id @default(uuid())
  tallyCompanyId String
  voucherId      String
  stockItemId    String
  godownId       String?
  batchId        String?
  /// in | out
  direction      String
  qtyMilli       Int
  ratePaise      Int     @default(0)
  discountPct    Int     @default(0)
  discountPaise  Int     @default(0)
  /// Taxable value of the line after discount.
  amountPaise    Int     @default(0)
  hsnCode        String?
  /// GST rate in basis points (1800 = 18%).
  gstRateBp      Int     @default(0)
  cgstPaise      Int     @default(0)
  sgstPaise      Int     @default(0)
  igstPaise      Int     @default(0)
  cessPaise      Int     @default(0)
  /// Sales / purchase ledger the line's value was posted to.
  salesLedgerId  String?
  description    String?
  position       Int     @default(0)

  voucher   TallyVoucher     @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  stockItem TallyStockItem   @relation(fields: [stockItemId], references: [id])
  godown    TallyGodown?     @relation(fields: [godownId], references: [id])
  batch     TallyStockBatch? @relation(fields: [batchId], references: [id])

  createdAt DateTime @default(now())

  @@index([tallyCompanyId, stockItemId])
  @@index([voucherId])
  @@index([godownId])
}

/// Append-only history of every alteration to a voucher. Lets an
/// auditor diff old vs new; never rewritten, never deleted from the UI.
model TallyVoucherRevision {
  id             String  @id @default(uuid())
  tallyCompanyId String
  voucherId      String
  version        Int
  /// created | updated | cancelled | restored | deleted
  action         String
  beforeJson     String?
  afterJson      String?
  actorUserId    String?
  note           String?

  voucher TallyVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([tallyCompanyId, createdAt])
  @@index([voucherId])
}

// ── Inventory masters ────────────────────────────────────────────────

model TallyStockGroup {
  id             String  @id @default(uuid())
  tallyCompanyId String
  name           String
  parentId       String?

  company  TallyCompany      @relation(fields: [tallyCompanyId], references: [id])
  parent   TallyStockGroup?  @relation("TallyStockGroupParent", fields: [parentId], references: [id])
  children TallyStockGroup[] @relation("TallyStockGroupParent")
  items    TallyStockItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([tallyCompanyId, name])
  @@index([tallyCompanyId])
}

model TallyStockCategory {
  id             String @id @default(uuid())
  tallyCompanyId String
  name           String

  company TallyCompany     @relation(fields: [tallyCompanyId], references: [id])
  items   TallyStockItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([tallyCompanyId, name])
}

model TallyUnit {
  id             String @id @default(uuid())
  tallyCompanyId String
  name           String
  /// Decimal places allowed when entering a quantity in this unit.
  decimals       Int    @default(0)

  company TallyCompany     @relation(fields: [tallyCompanyId], references: [id])
  items   TallyStockItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([tallyCompanyId, name])
}

model TallyGodown {
  id             String  @id @default(uuid())
  tallyCompanyId String
  name           String
  address        String?
  parentId       String?

  company  TallyCompany        @relation(fields: [tallyCompanyId], references: [id])
  parent   TallyGodown?        @relation("TallyGodownParent", fields: [parentId], references: [id])
  children TallyGodown[]       @relation("TallyGodownParent")
  items    TallyVoucherItem[]
  openings TallyStockOpening[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([tallyCompanyId, name])
}

model TallyStockItem {
  id                 String  @id @default(uuid())
  tallyCompanyId     String
  name               String
  stockGroupId       String?
  categoryId         String?
  unitId             String?
  hsnCode            String?
  /// GST rate in basis points (1800 = 18%).
  gstRateBp          Int     @default(0)
  /// Reorder level in milli-units.
  reorderLevelMilli  Int     @default(0)
  standardCostPaise  Int     @default(0)
  standardPricePaise Int     @default(0)
  /// fifo | avg — valuation method for closing stock.
  valuationMethod    String  @default("avg")
  batchTracking      Boolean @default(false)
  active             Boolean @default(true)

  company      TallyCompany        @relation(fields: [tallyCompanyId], references: [id])
  stockGroup   TallyStockGroup?    @relation(fields: [stockGroupId], references: [id])
  category     TallyStockCategory? @relation(fields: [categoryId], references: [id])
  unit         TallyUnit?          @relation(fields: [unitId], references: [id])
  batches      TallyStockBatch[]
  openings     TallyStockOpening[]
  voucherItems TallyVoucherItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([tallyCompanyId, name])
  @@index([tallyCompanyId])
}

/// Opening stock per item (optionally per godown/batch). Kept separate
/// from the item master so a multi-godown opening is representable and
/// so closing stock is always opening + movements.
model TallyStockOpening {
  id              String  @id @default(uuid())
  tallyCompanyId  String
  stockItemId     String
  godownId        String?
  batchId         String?
  financialYearId String?
  qtyMilli        Int     @default(0)
  ratePaise       Int     @default(0)
  valuePaise      Int     @default(0)

  stockItem TallyStockItem   @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  godown    TallyGodown?     @relation(fields: [godownId], references: [id])
  batch     TallyStockBatch? @relation(fields: [batchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tallyCompanyId, stockItemId])
}

model TallyStockBatch {
  id             String  @id @default(uuid())
  tallyCompanyId String
  stockItemId    String
  name           String
  mfgDate        String?
  expiryDate     String?

  stockItem TallyStockItem      @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  items     TallyVoucherItem[]
  openings  TallyStockOpening[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stockItemId, name])
  @@index([tallyCompanyId])
}

// ── Banking ──────────────────────────────────────────────────────────

/// One line of an imported bank statement. Matching a line to a voucher
/// entry sets both sides (entry.bankStatementLineId + line.status).
model TallyBankStatementLine {
  id              String    @id @default(uuid())
  tallyCompanyId  String
  bankLedgerId    String
  date            String
  description     String
  refNumber       String?
  debitPaise      Int       @default(0)
  creditPaise     Int       @default(0)
  balancePaise    Int?
  importBatch     String?
  /// unmatched | matched | ignored
  status          String    @default("unmatched")
  matchedAt       DateTime?
  matchedByUserId String?

  company    TallyCompany       @relation(fields: [tallyCompanyId], references: [id])
  bankLedger TallyLedger        @relation(fields: [bankLedgerId], references: [id])
  entry      TallyVoucherEntry?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tallyCompanyId, bankLedgerId, date])
}

/// A saved reconciliation as at a statement date — the evidence an
/// auditor looks for: book balance, statement balance, difference.
model TallyBankReconciliation {
  id                    String  @id @default(uuid())
  tallyCompanyId        String
  bankLedgerId          String
  statementDate         String
  bookBalancePaise      Int
  statementBalancePaise Int
  differencePaise       Int
  matchedCount          Int     @default(0)
  unmatchedCount        Int     @default(0)
  notes                 String?
  reconciledByUserId    String?

  company    TallyCompany @relation(fields: [tallyCompanyId], references: [id])
  bankLedger TallyLedger  @relation(fields: [bankLedgerId], references: [id])

  createdAt DateTime @default(now())

  @@index([tallyCompanyId, bankLedgerId, statementDate])
}

// ── Tax configuration ────────────────────────────────────────────────

/// Data-driven statutory rates. Nothing in the engine hardcodes a rate;
/// it reads these rows (or the rate carried on the stock item / entry).
model TallyTaxRate {
  id             String  @id @default(uuid())
  tallyCompanyId String
  /// gst | tds | tcs
  taxType        String
  name           String
  hsnCode        String?
  sacCode        String?
  /// Section code for TDS/TCS (e.g. "194J"). Never interpreted, only carried.
  section        String?
  /// Rate in basis points (1800 = 18%).
  rateBp         Int     @default(0)
  cessBp         Int     @default(0)
  /// Annual threshold below which TDS is not deducted, in paise.
  thresholdPaise Int?
  effectiveFrom  String?
  active         Boolean @default(true)

  company TallyCompany @relation(fields: [tallyCompanyId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([tallyCompanyId, taxType, name])
  @@index([tallyCompanyId, taxType])
}

/// Per-company configuration. One row per key; the value is JSON so a
/// settings page can grow without a migration.
model TallySetting {
  id             String @id @default(uuid())
  tallyCompanyId String
  key            String
  valueJson      String

  company TallyCompany @relation(fields: [tallyCompanyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tallyCompanyId, key])
}

// ── Payroll ──────────────────────────────────────────────────────────

model TallyEmployee {
  id                String  @id @default(uuid())
  tallyCompanyId    String
  name              String
  code              String?
  employeeGroup     String?
  designation       String?
  dateOfJoining     String?
  dateOfLeaving     String?
  pan               String?
  bankAccountNumber String?
  bankIfsc          String?
  active            Boolean @default(true)

  company        TallyCompany               @relation(fields: [tallyCompanyId], references: [id])
  structureLines TallySalaryStructureLine[]
  attendance     TallyAttendanceRecord[]
  payrollLines   TallyPayrollLine[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([tallyCompanyId, name])
  @@index([tallyCompanyId])
}

/// A pay head — one component of a payslip, mapped to the ledger it
/// posts to. Statutory heads (PF/ESI/PT) are ordinary rows whose rate
/// lives in `percentBp`, so a rate change is data, not code.
model TallyPayHead {
  id             String  @id @default(uuid())
  tallyCompanyId String
  name           String
  /// earning | deduction | employer_contribution
  headType       String
  /// flat | percent_of_basic | attendance
  calcType       String  @default("flat")
  valuePaise     Int     @default(0)
  percentBp      Int     @default(0)
  /// pf | esi | pt | income_tax | null
  statutory      String?
  /// Ledger this head posts to (salary expense, PF payable, ...).
  ledgerId       String?
  active         Boolean @default(true)

  company        TallyCompany               @relation(fields: [tallyCompanyId], references: [id])
  ledger         TallyLedger?               @relation(fields: [ledgerId], references: [id])
  structureLines TallySalaryStructureLine[]
  payrollLines   TallyPayrollLine[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([tallyCompanyId, name])
}

model TallySalaryStructureLine {
  id             String  @id @default(uuid())
  tallyCompanyId String
  employeeId     String
  payHeadId      String
  valuePaise     Int     @default(0)
  percentBp      Int     @default(0)
  effectiveFrom  String?

  employee TallyEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payHead  TallyPayHead  @relation(fields: [payHeadId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, payHeadId])
  @@index([tallyCompanyId])
}

model TallyAttendanceRecord {
  id             String @id @default(uuid())
  tallyCompanyId String
  employeeId     String
  /// 'YYYY-MM'
  period         String
  payableDays    Int    @default(0)
  presentDays    Int    @default(0)
  lopDays        Int    @default(0)

  employee TallyEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, period])
  @@index([tallyCompanyId, period])
}

model TallyPayrollRun {
  id                String  @id @default(uuid())
  tallyCompanyId    String
  /// 'YYYY-MM'
  period            String
  /// draft | processed | posted
  status            String  @default("draft")
  grossPaise        Int     @default(0)
  deductionsPaise   Int     @default(0)
  netPaise          Int     @default(0)
  /// The salary journal this run posted, once posted.
  voucherId         String?
  processedByUserId String?

  company TallyCompany       @relation(fields: [tallyCompanyId], references: [id])
  lines   TallyPayrollLine[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([tallyCompanyId, period])
}

model TallyPayrollLine {
  id             String @id @default(uuid())
  tallyCompanyId String
  payrollRunId   String
  employeeId     String
  payHeadId      String
  /// earning | deduction | employer_contribution
  headType       String
  amountPaise    Int

  run      TallyPayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee TallyEmployee   @relation(fields: [employeeId], references: [id])
  payHead  TallyPayHead    @relation(fields: [payHeadId], references: [id])

  createdAt DateTime @default(now())

  @@index([payrollRunId])
  @@index([tallyCompanyId, employeeId])
}

// ── Backup ───────────────────────────────────────────────────────────

/// A point-in-time JSON snapshot of one company's data. Restoring is an
/// explicit, permissioned action that never runs without confirmation.
model TallyBackup {
  id              String  @id @default(uuid())
  tallyCompanyId  String
  label           String
  /// Full JSON payload of the company's masters + vouchers.
  payloadJson     String
  sizeBytes       Int     @default(0)
  voucherCount    Int     @default(0)
  ledgerCount     Int     @default(0)
  createdByUserId String?

  company TallyCompany @relation(fields: [tallyCompanyId], references: [id])

  createdAt DateTime @default(now())

  @@index([tallyCompanyId, createdAt])
}

// ============================================================
// BOOKS — native bookkeeping (docs/accounting-module/README.md)
// ============================================================
//
// One BooksOrganisation per end client of the firm. Every table below carries
// booksOrgId and every read folds it into the where clause. Money is BigInt
// minor units (paise); a foreign-currency line stores both the transaction
// amount (fxAmount, fxCurrency) and the base amount (amount) with the rate.
//
// The ONE writer of financial state is BooksJournal + BooksJournalLine, via
// engine/posting.ts. Invoices, bills, payments, credit notes and transfers are
// wrappers that produce journals. Triggers in prisma/sql/books-invariants.*
// make an unbalanced posted journal, an edit to a posted journal, or an
// edit/delete of an audit event impossible at the database.

model BooksOrganisation {
  id                   String  @id @default(uuid())
  organisationId       String
  /// Optional link to the Workstation client this set of books belongs to.
  clientId             String?
  name                 String
  legalName            String?
  gstin                String?
  pan                  String?
  /// Two-letter GST state code, e.g. '33' for Tamil Nadu — place-of-supply anchor.
  stateCode            String?
  stateName            String?
  addressLine1         String?
  addressLine2         String?
  city                 String?
  pincode              String?
  baseCurrency         String  @default("INR")
  fiscalYearStartMonth Int     @default(4)
  /// Enable TDS deduction on purchases.
  tdsEnabled           Boolean @default(true)
  isActive             Boolean @default(true)

  memberships BooksMembership[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([organisationId])
  @@index([clientId])
}

/// Firm staff assigned to a set of books. role: admin | staff | viewer.
model BooksMembership {
  id         String @id @default(uuid())
  booksOrgId String
  userId     String
  role       String @default("staff")

  booksOrg BooksOrganisation @relation(fields: [booksOrgId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?

  @@unique([booksOrgId, userId])
  @@index([userId])
}

/// Account groups. rootCategory: asset | liability | equity | income | expense.
/// tallyGroup mirrors Tally's primary group names for a later export.
model BooksAccountGroup {
  id            String  @id @default(uuid())
  booksOrgId    String
  name          String
  rootCategory  String
  tallyGroup    String
  parentGroupId String?
  isSystem      Boolean @default(false)
  sortOrder     Int     @default(0)

  ledgers BooksLedger[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([booksOrgId, name])
  @@index([booksOrgId, rootCategory])
}

/// A ledger account. systemKey names the accounts the engine posts to
/// (accounts_receivable, cgst_output, round_off, …) so posting never
/// depends on a user-editable name.
model BooksLedger {
  id                 String  @id @default(uuid())
  booksOrgId         String
  groupId            String
  name               String
  alias              String?
  code               String?
  rootCategory       String
  tallyGroup         String
  systemKey          String?
  /// Party ledgers point at their contact.
  contactId          String?
  openingBalance     BigInt  @default(0)
  /// debit | credit
  openingBalanceType String  @default("debit")
  openingDate        String?
  currency           String  @default("INR")
  billWise           Boolean @default(false)
  gstin              String?
  stateCode          String?
  /// TDS nature of payment / section for expense ledgers, e.g. '194C'.
  tdsSection         String?
  bankName           String?
  bankAccountNo      String?
  bankIfsc           String?
  isBank             Boolean @default(false)
  isCash             Boolean @default(false)
  isSystem           Boolean @default(false)
  isActive           Boolean @default(true)
  description        String?

  group BooksAccountGroup  @relation(fields: [groupId], references: [id])
  lines BooksJournalLine[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([booksOrgId, name])
  @@index([booksOrgId, systemKey])
  @@index([booksOrgId, rootCategory])
  @@index([contactId])
}

/// THE financial record. status: draft | posted | void.
/// voucherType: journal | opening | invoice | credit_note | payment_in |
///   bill | vendor_credit | payment_out | transfer | revaluation | retainer_apply
model BooksJournal {
  id                String    @id @default(uuid())
  booksOrgId        String
  date              String // 'YYYY-MM-DD'
  number            String
  voucherType       String
  sourceModule      String?
  sourceId          String?
  narration         String?
  status            String    @default("draft")
  /// Set on the reversing journal that voids another.
  reversesJournalId String?
  /// Set on a voided journal, pointing at its reversal.
  voidedByJournalId String?
  currency          String    @default("INR")
  exchangeRate      Float     @default(1)
  totalDebit        BigInt    @default(0)
  totalCredit       BigInt    @default(0)
  postedAt          DateTime?
  postedBy          String?

  lines       BooksJournalLine[]
  allocations BooksBillAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@unique([booksOrgId, number])
  @@index([booksOrgId, date])
  @@index([booksOrgId, status])
  @@index([sourceModule, sourceId])
}

model BooksJournalLine {
  id                        String    @id @default(uuid())
  journalId                 String
  booksOrgId                String
  lineNo                    Int
  ledgerId                  String
  /// debit | credit
  side                      String
  /// Base-currency minor units, always positive.
  amount                    BigInt
  fxCurrency                String    @default("INR")
  fxAmount                  BigInt
  exchangeRate              Float     @default(1)
  partyLedgerId             String?
  taxRateId                 String?
  description               String?
  /// Bank reconciliation: statement line this entry was matched to.
  reconciledStatementLineId String?
  reconciledAt              DateTime?

  journal BooksJournal @relation(fields: [journalId], references: [id])
  ledger  BooksLedger  @relation(fields: [ledgerId], references: [id])

  @@index([booksOrgId, ledgerId])
  @@index([journalId])
}

/// An open item on a bill-wise ledger: one per invoice / bill / advance.
/// side: debit (receivable) | credit (payable). balance falls as allocations
/// are posted; status closes at zero.
model BooksBill {
  id         String  @id @default(uuid())
  booksOrgId String
  ledgerId   String
  contactId  String?
  billNo     String
  /// new_ref | advance | on_account
  billType   String  @default("new_ref")
  sourceType String
  sourceId   String
  date       String
  dueDate    String?
  side       String
  currency   String  @default("INR")
  fxAmount   BigInt
  amount     BigInt
  fxBalance  BigInt
  balance    BigInt
  status     String  @default("open")

  allocations BooksBillAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([booksOrgId, sourceType, sourceId])
  @@index([booksOrgId, ledgerId, status])
  @@index([contactId])
}

/// A journal's effect on an open item. type: new_ref | against_ref | advance | on_account.
model BooksBillAllocation {
  id         String @id @default(uuid())
  booksOrgId String
  journalId  String
  billId     String
  type       String
  currency   String @default("INR")
  fxAmount   BigInt
  amount     BigInt

  journal BooksJournal @relation(fields: [journalId], references: [id])
  bill    BooksBill    @relation(fields: [billId], references: [id])

  createdAt DateTime @default(now())

  @@index([booksOrgId, billId])
  @@index([journalId])
}

/// customer | vendor | both. gstTreatment: business_gst | business_none | overseas | consumer.
model BooksContact {
  id                 String  @id @default(uuid())
  booksOrgId         String
  type               String
  displayName        String
  companyName        String?
  email              String?
  phone              String?
  gstin              String?
  gstTreatment       String  @default("business_gst")
  pan                String?
  placeOfSupplyState String?
  currency           String  @default("INR")
  paymentTermsDays   Int     @default(30)
  creditLimit        BigInt  @default(0)
  /// TDS section applied to this vendor's bills, e.g. '194J'.
  tdsSection         String?
  receivableLedgerId String?
  payableLedgerId    String?
  notes              String?
  isActive           Boolean @default(true)

  persons   BooksContactPerson[]
  addresses BooksAddress[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([booksOrgId, type])
  @@index([booksOrgId, displayName])
}

model BooksContactPerson {
  id          String  @id @default(uuid())
  contactId   String
  name        String
  email       String?
  phone       String?
  designation String?
  isPrimary   Boolean @default(false)

  contact BooksContact @relation(fields: [contactId], references: [id])

  @@index([contactId])
}

/// kind: billing | shipping
model BooksAddress {
  id        String  @id @default(uuid())
  contactId String
  kind      String
  line1     String?
  line2     String?
  city      String?
  stateCode String?
  stateName String?
  pincode   String?
  country   String  @default("IN")

  contact BooksContact @relation(fields: [contactId], references: [id])

  @@index([contactId])
}

/// itemType: inventory | sales | purchases | sales_and_purchases; productType: goods | service
model BooksItem {
  id               String  @id @default(uuid())
  booksOrgId       String
  name             String
  sku              String?
  unit             String  @default("nos")
  itemType         String  @default("sales_and_purchases")
  productType      String  @default("service")
  sellRate         BigInt  @default(0)
  purchaseRate     BigInt  @default(0)
  taxRateId        String?
  hsnSac           String?
  salesLedgerId    String?
  purchaseLedgerId String?
  description      String?
  isActive         Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([booksOrgId, name])
}

/// type: gst | tds | tcs | other. percentage in basis points (1800 = 18%).
model BooksTaxRate {
  id                String  @id @default(uuid())
  booksOrgId        String
  name              String
  type              String
  percentageBp      Int
  /// For TDS: the flat rate when the vendor has no PAN (bp).
  noPanPercentageBp Int?
  /// TDS/TCS section code, e.g. '194C'.
  section           String?
  isCompound        Boolean @default(false)
  isActive          Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([booksOrgId, name])
  @@index([booksOrgId, type])
}

/// One table for every transaction document.
/// kind: estimate | sales_order | invoice | retainer_invoice | credit_note |
///       purchase_order | bill | vendor_credit
/// status: draft | sent | accepted | declined | posted | partially_paid | paid |
///         closed | void | expired
model BooksDocument {
  id                 String  @id @default(uuid())
  booksOrgId         String
  kind               String
  number             String
  contactId          String
  date               String
  dueDate            String?
  expiryDate         String?
  referenceNo        String?
  status             String  @default("draft")
  currency           String  @default("INR")
  exchangeRate       Float   @default(1)
  placeOfSupply      String?
  isInterState       Boolean @default(false)
  taxInclusive       Boolean @default(false)
  /// Document-level discount, applied before tax. bp of subtotal or a fixed amount.
  discountPercentBp  Int     @default(0)
  discountAmount     BigInt  @default(0)
  subtotal           BigInt  @default(0)
  discountTotal      BigInt  @default(0)
  taxableTotal       BigInt  @default(0)
  cgstTotal          BigInt  @default(0)
  sgstTotal          BigInt  @default(0)
  igstTotal          BigInt  @default(0)
  taxTotal           BigInt  @default(0)
  tdsRateId          String?
  tdsTotal           BigInt  @default(0)
  roundOff           BigInt  @default(0)
  total              BigInt  @default(0)
  /// Base-currency total (== total when currency is the base).
  baseTotal          BigInt  @default(0)
  balanceDue         BigInt  @default(0)
  /// Remaining unapplied credit on a credit note / vendor credit.
  creditsRemaining   BigInt  @default(0)
  journalId          String?
  /// The document this one was created from (SO → invoice, PO → bill, …).
  sourceDocumentId   String?
  recurringProfileId String?
  notes              String?
  terms              String?
  voidReason         String?

  lines BooksDocumentLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@unique([booksOrgId, kind, number])
  @@index([booksOrgId, kind, status])
  @@index([booksOrgId, contactId])
  @@index([booksOrgId, date])
}

model BooksDocumentLine {
  id                String  @id @default(uuid())
  documentId        String
  booksOrgId        String
  lineNo            Int
  itemId            String?
  description       String
  hsnSac            String?
  quantity          Float   @default(1)
  /// Unit rate in transaction-currency minor units.
  rate              BigInt
  discountPercentBp Int     @default(0)
  discountAmount    BigInt  @default(0)
  taxRateId         String?
  taxPercentBp      Int     @default(0)
  taxable           BigInt  @default(0)
  cgst              BigInt  @default(0)
  sgst              BigInt  @default(0)
  igst              BigInt  @default(0)
  tax               BigInt  @default(0)
  lineTotal         BigInt  @default(0)
  /// Income / expense / asset ledger this line posts to.
  ledgerId          String

  document BooksDocument @relation(fields: [documentId], references: [id])

  @@index([documentId])
}

/// kind: invoice | bill. frequency: weekly | monthly | quarterly | yearly.
model BooksRecurringProfile {
  id           String  @id @default(uuid())
  booksOrgId   String
  kind         String
  name         String
  contactId    String
  frequency    String
  startDate    String
  endDate      String?
  nextRunDate  String
  lastRunDate  String?
  /// Serialised document input (lines, terms, currency …) used for each run.
  templateJson String
  status       String  @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@index([booksOrgId, status, nextRunDate])
}

/// kind: received | made. Allocations live on the journal (BooksBillAllocation).
model BooksPayment {
  id              String  @id @default(uuid())
  booksOrgId      String
  kind            String
  number          String
  contactId       String
  date            String
  currency        String  @default("INR")
  exchangeRate    Float   @default(1)
  fxAmount        BigInt
  amount          BigInt
  depositLedgerId String
  bankCharges     BigInt  @default(0)
  tdsAmount       BigInt  @default(0)
  mode            String  @default("bank_transfer")
  reference       String?
  notes           String?
  journalId       String?
  status          String  @default("posted")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@unique([booksOrgId, kind, number])
  @@index([booksOrgId, contactId])
}

model BooksBankTransfer {
  id           String  @id @default(uuid())
  booksOrgId   String
  date         String
  number       String
  fromLedgerId String
  toLedgerId   String
  amount       BigInt
  reference    String?
  notes        String?
  journalId    String?
  status       String  @default("posted")

  createdAt DateTime @default(now())
  createdBy String?

  @@unique([booksOrgId, number])
}

/// A manually entered bank statement line, matched to a journal line.
model BooksBankStatementLine {
  id                   String    @id @default(uuid())
  booksOrgId           String
  ledgerId             String
  date                 String
  description          String
  /// Signed minor units: positive = money in.
  amount               BigInt
  reference            String?
  matchedJournalLineId String?
  matchedAt            DateTime?

  createdAt DateTime @default(now())
  createdBy String?

  @@index([booksOrgId, ledgerId, date])
}

model BooksExchangeRate {
  id         String @id @default(uuid())
  booksOrgId String
  currency   String
  date       String
  rate       Float

  createdAt DateTime @default(now())

  @@unique([booksOrgId, currency, date])
}

model BooksRevaluation {
  id         String  @id @default(uuid())
  booksOrgId String
  date       String
  currency   String
  rate       Float
  /// Signed base-currency delta booked to the FX gain/loss ledger.
  delta      BigInt
  journalId  String?
  detailJson String

  createdAt DateTime @default(now())
  createdBy String?

  @@index([booksOrgId, date])
}

model BooksNumberSequence {
  id         String @id @default(uuid())
  booksOrgId String
  kind       String
  prefix     String
  next       Int    @default(1)

  @@unique([booksOrgId, kind])
}

/// Append-only. Triggers forbid UPDATE and DELETE.
model BooksAuditEvent {
  id          String   @id @default(uuid())
  booksOrgId  String
  actorUserId String?
  entityType  String
  entityId    String
  action      String
  beforeJson  String?
  afterJson   String?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([booksOrgId, entityType, entityId])
  @@index([booksOrgId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// BOOKKEEPING SERVICE
//
// The SERVICE-MANAGEMENT layer over the Books accounting engine. It tracks
// the work the bookkeeping team does for a client — engagements, monthly
// periods, checklists, tasks, chased documents, deliverables — and links out
// to Books via BooksOrganisation.clientId. It holds NO financial balances:
// Books stays the single source of truth for every ledger figure.
//
// Employee and user ids are plain Strings resolved through employeeMap(),
// exactly as ClientService and Task do, so Employee gains no back-relations.
// ─────────────────────────────────────────────────────────────────────────

/// One bookkeeping engagement per client — the standing agreement to keep
/// their books. @unique on clientId enforces "one per client".
model BookkeepingEngagement {
  id       String @id @default(uuid())
  clientId String @unique

  /// active | on_hold | completed | cancelled
  status             String  @default("active")
  /// 'YYYY-MM-DD' — a calendar date, so it cannot drift across the IST/UTC edge.
  serviceStartDate   String
  assignedEmployeeId String
  /// monthly | quarterly | annual
  billingFrequency   String  @default("monthly")
  /// Days after period end at which the period's due date defaults. Per-client
  /// because firms agree different turnarounds; bookkeeping carries no
  /// statutory deadline, so every date here is an internal commitment and
  /// must be configurable rather than constant.
  dueOffsetDays      Int     @default(5)
  nextDueDate        String?
  notes              String?

  client  Client              @relation(fields: [clientId], references: [id])
  periods BookkeepingPeriod[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([status])
  @@index([assignedEmployeeId])
}

/// One month of bookkeeping work. The unique constraint is what stops a
/// second "May 2026" being opened for the same engagement.
model BookkeepingPeriod {
  id           String @id @default(uuid())
  engagementId String
  year         Int
  month        Int

  /// The period window as calendar dates. Derived on write from year+month
  /// and the engagement's billingFrequency (monthly: 1st→last of month;
  /// quarterly: 1st of month→last of month+2; annual: 1st→last of month+11).
  /// Nullable only for the backfill of pre-existing rows; new periods always
  /// carry both. `dueDate` in turn is derived from `periodEnd` plus the
  /// engagement's `dueOffsetDays`, adjusted forward off weekends.
  periodStart String?
  periodEnd   String?

  /// not_started | in_progress | awaiting_documents | under_review | completed | blocked
  status             String    @default("not_started")
  dueDate            String?
  completedDate      DateTime?
  assignedEmployeeId String?
  notes              String?

  engagement       BookkeepingEngagement        @relation(fields: [engagementId], references: [id])
  checklistItems   BookkeepingChecklistItem[]
  tasks            BookkeepingTask[]
  pendingItems     BookkeepingPendingItem[]
  documentRequests BookkeepingDocumentRequest[]
  deliverables     BookkeepingDeliverable[]
  activities       BookkeepingActivity[]
  imports          BookkeepingImport[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([engagementId, year, month])
  @@index([status])
  @@index([dueDate])
  @@index([periodEnd])
}

/// DEPRECATED. The monthly checklist is now a rendering of BookkeepingTask
/// rows grouped by BookkeepingWorkflowStage — one task per stage per period.
/// This table is retained only so `prisma db push` never has to drop it (see
/// docker-compose.yml note): existing rows migrated their state onto tasks
/// via seed-bookkeeping-stages.ts, and no code path reads or writes here.
/// A follow-up PR drops the table once every environment has migrated.
model BookkeepingChecklistItem {
  id       String @id @default(uuid())
  periodId String

  label     String
  /// pending | in_progress | completed | blocked | not_applicable
  status    String  @default("pending")
  sortOrder Int     @default(0)
  notes     String?

  completedAt           DateTime?
  completedByEmployeeId String?

  period BookkeepingPeriod @relation(fields: [periodId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([periodId, sortOrder])
}

/// The monthly workflow — one config row per stage of a bookkeeping close.
/// Every BookkeepingTask on a period is derived from one of these, so the
/// "checklist", the "task list" and the "workflow panel" are three renderings
/// of the same underlying record. Sequence orders the render; slug is stable.
model BookkeepingWorkflowStage {
  id                String  @id @default(uuid())
  sequence          Int     @unique
  name              String
  slug              String  @unique
  /// The category to stamp on tasks seeded from this stage.
  defaultCategory   String  @default("other")
  /// Offset in days from the period end to seed the task's due date at. Used
  /// when the future auto-due-date generator (PR-2) runs; today it seeds a
  /// null due date and the user still enters it manually.
  defaultOffsetDays Int     @default(0)
  /// Nullable pointer to a gate rule (PR-6). Left as a plain string rather
  /// than a FK so the rules table can arrive later without a data migration.
  gateRuleSlug      String?
  isActive          Boolean @default(true)

  tasks BookkeepingTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sequence])
}

model BookkeepingTask {
  id       String  @id @default(uuid())
  periodId String?
  clientId String
  /// The workflow stage this task represents. Null means an ad-hoc task
  /// created outside the standard monthly workflow (retained for
  /// backwards compatibility with rows migrated from the old task table).
  stageId  String?

  title       String
  description String?
  /// data_collection | sales | purchases | expenses | banking | reconciliation |
  /// review | client_communication | reporting | other
  category    String  @default("other")
  /// low | medium | high | critical
  priority    String  @default("medium")
  /// pending | in_progress | completed | blocked | cancelled
  status      String  @default("pending")

  assignedEmployeeId    String
  dueDate               String?
  completedAt           DateTime?
  completedByEmployeeId String?
  createdById           String?
  notes                 String?

  period BookkeepingPeriod?        @relation(fields: [periodId], references: [id])
  client Client                    @relation(fields: [clientId], references: [id])
  stage  BookkeepingWorkflowStage? @relation(fields: [stageId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// The (period_id, stage_id) invariant — one task per stage per period —
  /// is enforced at the application layer today (upsert in service.ts and
  /// the seed migration). A DB-level UNIQUE will be added in a follow-up PR
  /// once every environment has migrated, because `prisma db push` refuses
  /// to add a UNIQUE constraint on live data without --accept-data-loss.
  @@index([clientId])
  @@index([periodId])
  @@index([periodId, stageId])
  @@index([status])
  @@index([assignedEmployeeId, status])
  @@index([dueDate])
}

/// Something the firm is waiting on from the client.
model BookkeepingPendingItem {
  id       String  @id @default(uuid())
  periodId String?
  clientId String

  title       String
  description String?
  /// bank_statement | sales_data | purchase_bills | expense_documents |
  /// payment_details | other
  category    String  @default("other")
  /// low | medium | high | critical
  priority    String  @default("medium")
  /// requested | partially_received | received | under_review | resolved | overdue
  status      String  @default("requested")

  requestedDate      String
  dueDate            String?
  resolvedDate       DateTime?
  assignedEmployeeId String?
  createdById        String?
  notes              String?

  period BookkeepingPeriod? @relation(fields: [periodId], references: [id])
  client Client             @relation(fields: [clientId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clientId])
  @@index([periodId])
  @@index([status])
  @@index([dueDate])
}

/// A request for a file. Storage stays in ClientDocument — this row is the
/// ASK, and clientDocumentId is the FK to the delivered file.
model BookkeepingDocumentRequest {
  id       String  @id @default(uuid())
  periodId String?
  clientId String

  /// bank_statement | purchase_bills | sales_register | expense_documents |
  /// payment_proof | other
  documentType String
  description  String?
  /// requested | received | under_review | accepted | rejected
  status       String  @default("requested")

  requestedById String?
  requestedAt   DateTime  @default(now())
  dueDate       String?
  receivedAt    DateTime?

  clientDocumentId String?

  period         BookkeepingPeriod? @relation(fields: [periodId], references: [id])
  client         Client             @relation(fields: [clientId], references: [id])
  clientDocument ClientDocument?    @relation(fields: [clientDocumentId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clientId])
  @@index([periodId])
  @@index([status])
}

/// Tracking only. The actual numbers on a trial balance or P&L are produced
/// by Books at read time; this row records that one was prepared and sent.
model BookkeepingDeliverable {
  id       String  @id @default(uuid())
  periodId String?
  clientId String

  /// monthly_books | financial_report | bank_reconciliation | ledger |
  /// trial_balance | profit_and_loss | balance_sheet | other
  type   String
  /// draft | in_review | approved | delivered
  status String @default("draft")

  preparedByEmployeeId String?
  reviewedByEmployeeId String?
  clientDocumentId     String?

  approvedAt  DateTime?
  deliveredAt DateTime?
  notes       String?

  period         BookkeepingPeriod? @relation(fields: [periodId], references: [id])
  client         Client             @relation(fields: [clientId], references: [id])
  clientDocument ClientDocument?    @relation(fields: [clientDocumentId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clientId])
  @@index([periodId])
  @@index([status])
}

/// Append-only per-period trail. AuditLog still records every mutation for
/// compliance; this is the human-readable story shown on the Activity tab.
model BookkeepingActivity {
  id       String  @id @default(uuid())
  periodId String?
  clientId String

  actorUserId String?
  action      String
  detail      String?

  period BookkeepingPeriod? @relation(fields: [periodId], references: [id])
  client Client             @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([periodId, createdAt])
}

/// The financial data layer (spec §4.2 / §6.4). One row per file the firm
/// pulls into a period — bank statement, day book, outstandings, trial
/// balance. Append-only: a re-import creates a new row and never overwrites,
/// because the prior-period comparison needs history.
///
/// Every row records the outcome of the TWO BLOCKING VALIDATIONS spec §5
/// requires (period and company must match the target). A rejected row is
/// deliberately kept so a reviewer can see WHICH file was refused and why.
/// The stored file lives under `storagePath`; row-level parsing (populating
/// `rowCount` and BookkeepingLedgerBalance below) is added by later PRs on
/// a per-kind basis.
model BookkeepingImport {
  id       String @id @default(uuid())
  periodId String
  clientId String

  /// trial_balance | day_book | outstandings | bank_statement
  kind   String
  /// upload | email | agent  (only 'upload' today; 'email' and 'agent' are
  /// reserved for the ingestion pipeline that will follow.)
  source String @default("upload")

  originalFilename String
  storagePath      String // resolved by bookkeepingImportStorage
  fileSize         Int
  mimeType         String

  /// The company name and period boundary the CALLER declared for the file.
  /// These are what the two blocking validations run against — a future
  /// parser will populate them automatically; today the user types them.
  companyNameInFile String
  periodFromInFile  String // 'YYYY-MM-DD'
  periodToInFile    String // 'YYYY-MM-DD'

  /// Populated when a per-kind parser runs; null in the meantime.
  rowCount Int?

  /// imported | rejected_period_mismatch | rejected_company_mismatch | parse_failed
  status      String
  errorDetail String?

  importedAt           DateTime @default(now())
  importedByEmployeeId String?

  period  BookkeepingPeriod          @relation(fields: [periodId], references: [id])
  client  Client                     @relation(fields: [clientId], references: [id])
  ledgers BookkeepingLedgerBalance[]

  @@index([periodId, kind, importedAt])
  @@index([clientId, importedAt])
  @@index([status])
}

/// One ledger balance from a trial-balance import. Money is INTEGER PAISE
/// (BigInt in the schema so a legacy INR balance never overflows Int32).
/// Classification is by PARENT GROUP (`Bank Accounts` → asset · bank,
/// `Sundry Creditors` → liability · payable), never by ledger name — firms
/// name ledgers differently, but Tally's group hierarchy is standard.
///
/// Populated by a parser attached to BookkeepingImport in a follow-up PR;
/// the table is declared now so the schema is complete and Reports (spec
/// §6.5, PR-6) can slot in without a second migration.
model BookkeepingLedgerBalance {
  id       String @id @default(uuid())
  importId String

  ledgerName  String
  parentGroup String
  /// asset | liability | income | expense | equity
  category    String
  /// cash | bank | receivable | payable | gst | other
  subtype     String @default("other")

  openingPaise BigInt @default(0)
  debitPaise   BigInt @default(0)
  creditPaise  BigInt @default(0)
  closingPaise BigInt @default(0)

  /// The raw row as the file carried it, so the parser output remains
  /// auditable even after the classification rules change.
  raw Json?

  import BookkeepingImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@index([category, subtype])
}

/// Group-to-category mapping for the Reports tab (spec §6.5).
///
/// Classification is by PARENT GROUP, never by ledger name — firms name
/// ledgers differently, but Tally's group hierarchy is standard. The ten
/// system rows here are seeded once and never mutated; a firm that keeps
/// a custom group inserts a NON-system row to teach the reports how to
/// classify it. Deleting a row a period actually referenced would blank
/// its report line — hence `deletedAt` on non-system rows and a hard
/// guard against removing system rows.
model BookkeepingLedgerGroup {
  id   String @id @default(uuid())
  /// Exact match against BookkeepingLedgerBalance.parentGroup — trim of
  /// outer whitespace is the ONLY normalisation.
  name String @unique

  /// asset | liability | income | expense | equity
  category String
  /// cash | bank | receivable | payable | gst | other
  subtype  String @default("other")

  /// System rows: seeded from spec §6.5 and immutable through the UI.
  isSystem Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([category, subtype])
}

// ============================================================
// INCORPORATION SERVICE (Workstation → Services → Incorporation)
// ============================================================
//
// TRUTH OF DATA. Every value in this section that describes something a
// government portal did or said was TYPED IN BY AN EMPLOYEE. Nothing here
// calls MCA or any other portal, and nothing here may claim that it did.
// That is why every row carrying an externally-sourced fact also carries the
// provenance triple — `source` (always 'manual_entry' today),
// `recordedByEmployeeId`, `recordedAt` — and why the UI prints
// "Recorded by <employee> · <date>" beside each of those values. There is no
// "verified", no "synced" and no "last checked with the portal" anywhere.
//
// `externalRef` / `syncedAt` shapes are DELIBERATELY ABSENT rather than
// stubbed: a nullable column no code path writes is dead integration code.
// The reference numbers below are employee-recorded strings, which is what a
// future integration would reconcile against anyway.
//
// Employee ids are scalars, never Prisma relations — declaring a relation
// here would force back-relation fields onto Employee, and that model stays
// untouched (see the Workstation section header). They resolve through
// `employeeMap()` at read time, exactly like every other Workstation module.
//
// Status vocabularies are Strings with the allowed values in the doc comment,
// matching ClientService / Task / FollowUp / Bookkeeping. The authoritative
// list is `server/src/modules/incorporation/validate.ts`, which is what the
// `oneOf()` validators check on every write.

/// Configurable entity type. Party roles, checklist templates and document
/// requirements hang off THIS ROW, not off an `if` in a component — adding
/// "Section 8 Company" is a Settings edit, not a code change.
model IncorporationEntityType {
  id             String  @id @default(uuid())
  organisationId String
  /// 'PVT_LTD' | 'OPC' | 'LLP' | 'PARTNERSHIP' | 'PROPRIETORSHIP' | 'OTHER'
  code           String  @unique
  name           String
  description    String?

  /// The party roles this entity type actually uses, as a JSON array of role
  /// codes. Data, so an LLP asks for designated partners and a proprietorship
  /// does not.
  partyRolesJson String @default("[]")
  minParties     Int    @default(1)
  maxParties     Int?

  /// Applied when a case of this type is created.
  defaultTargetDays         Int     @default(30)
  defaultAssignedEmployeeId String?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  cases              IncorporationCase[]
  checklistTemplates IncorporationChecklistTemplate[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([isActive, sortOrder])
}

/// A checklist line DEFINITION. `entityTypeId = null` is the baseline
/// template every entity type inherits; a row with an entityTypeId either
/// adds to or overrides the baseline for that type.
model IncorporationChecklistTemplate {
  id             String  @id @default(uuid())
  organisationId String
  entityTypeId   String?

  /// client | people | documents | dsc | name | filing | government | completion
  category         String
  label            String
  sortOrder        Int     @default(0)
  /// The case stage this item belongs to, so Case Detail can show what the
  /// current stage still needs. Null = not tied to one stage.
  stage            String?
  /// For a `documents` item, the document category to request.
  documentCategory String?
  isActive         Boolean @default(true)

  entityType IncorporationEntityType?     @relation(fields: [entityTypeId], references: [id], onDelete: Cascade)
  items      IncorporationChecklistItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([entityTypeId, sortOrder])
  @@index([category])
}

/// THE CASE — the aggregate root. One incorporation engagement for one client.
model IncorporationCase {
  id             String @id @default(uuid())
  organisationId String
  /// Human-readable 'INC-2026-0001'. Allocated SERVER-SIDE inside the
  /// transaction that creates the case, by reading the current maximum for
  /// the year. Never client-side, never random.
  caseCode       String @unique

  clientId        String
  entityTypeId    String
  /// Optional link to the ClientService row this case is delivered under, so
  /// the Services list and the case agree.
  clientServiceId String?

  proposedName           String
  alternateName          String?
  businessActivity       String?
  businessCategory       String?
  state                  String?
  city                   String?
  registeredOfficeInfo   String?
  incorporationObjective String?

  /// The stage machine. See INCORPORATION_STAGES / STAGE_TRANSITIONS in
  /// modules/incorporation/validate.ts — the server is what enforces it.
  stage         String  @default("new")
  /// The stage a hold was taken from, so ON_HOLD returns to where it paused.
  heldFromStage String?
  /// active | on_hold | completed | cancelled
  status        String  @default("active")
  /// low | medium | high | critical — the platform priority vocabulary,
  /// reused rather than re-declared.
  priority      String  @default("medium")

  assignedEmployeeId String
  targetDate         String?
  internalNotes      String?
  completedAt        DateTime?
  cancelledReason    String?

  /// Seeded sample data. A real case is always false, and the UI marks a
  /// true one so a sample reference number can never be mistaken for a real
  /// government reference.
  isDemo Boolean @default(false)

  client           Client                         @relation(fields: [clientId], references: [id])
  entityType       IncorporationEntityType        @relation(fields: [entityTypeId], references: [id])
  clientService    ClientService?                 @relation(fields: [clientServiceId], references: [id])
  parties          IncorporationParty[]
  checklistItems   IncorporationChecklistItem[]
  documentRequests IncorporationDocumentRequest[]
  dscRecords       IncorporationDsc[]
  names            IncorporationName[]
  filings          IncorporationFiling[]
  queries          IncorporationQuery[]
  deliverables     IncorporationDeliverable[]
  fees             IncorporationFee[]
  activities       IncorporationActivity[]
  tasks            Task[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([clientId])
  @@index([stage])
  @@index([status])
  @@index([entityTypeId])
  @@index([priority])
  @@index([targetDate])
  @@index([assignedEmployeeId, status])
  @@index([updatedAt])
}

/// A promoter / director / partner / designated partner / authorised person.
/// Links to the existing ClientContact where the person is already on file,
/// so nobody re-keys a director who is already a client contact.
model IncorporationParty {
  id     String @id @default(uuid())
  caseId String

  /// One of the entity type's partyRolesJson codes. Checked on write against
  /// THAT list, so an LLP cannot acquire a "director".
  role            String
  name            String
  contactNumber   String?
  email           String?
  address         String?
  clientContactId String?

  dscRequired Boolean @default(true)
  sortOrder   Int     @default(0)
  notes       String?

  case          IncorporationCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  clientContact ClientContact?     @relation(fields: [clientContactId], references: [id])
  dscRecords    IncorporationDsc[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([caseId, sortOrder])
  @@index([clientContactId])
}

/// An instantiated checklist row ON a case, copied from the templates that
/// apply to the case's entity type at creation time, in one transaction.
model IncorporationChecklistItem {
  id         String  @id @default(uuid())
  caseId     String
  templateId String?

  category  String
  label     String
  /// pending | in_progress | completed | blocked | not_applicable
  status    String  @default("pending")
  sortOrder Int     @default(0)
  stage     String?

  assignedEmployeeId String?
  dueDate            String?
  remarks            String?

  completedAt           DateTime?
  completedByEmployeeId String?

  case     IncorporationCase               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  template IncorporationChecklistTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId, sortOrder])
  @@index([status])
}

/// The ASK for a file. Storage stays in ClientDocument — this row records
/// that we asked, and clientDocumentId is the FK to the delivered file.
model IncorporationDocumentRequest {
  id       String  @id @default(uuid())
  caseId   String
  clientId String
  /// Set when the document belongs to one party (a director's KYC).
  partyId  String?

  /// identity_kyc | address_proof | registered_office | party | dsc |
  /// name_application | government_filing | government_query | certificate |
  /// pan_tan | other
  category     String  @default("other")
  documentType String
  description  String?
  /// required | requested | received | under_review | approved | rejected |
  /// not_applicable
  status       String  @default("required")

  requestedByEmployeeId String?
  requestedAt           DateTime?
  dueDate               String?
  receivedAt            DateTime?
  reviewedByEmployeeId  String?
  rejectionReason       String?

  clientDocumentId String?

  case           IncorporationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  client         Client            @relation(fields: [clientId], references: [id])
  clientDocument ClientDocument?   @relation(fields: [clientDocumentId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([caseId])
  @@index([clientId])
  @@index([status])
  @@index([category])
}

/// DSC TRACKING ONLY. This module performs no DSC operation of any kind — it
/// records what an employee did with a token outside the system.
///
/// `status = 'verified'` means AN EMPLOYEE PHYSICALLY VERIFIED THE TOKEN. It
/// never means an API confirmed anything, and the UI labels it
/// "Verified by employee" for exactly that reason.
model IncorporationDsc {
  id      String @id @default(uuid())
  caseId  String
  partyId String

  required    Boolean @default(true)
  /// not_required | pending | requested | received | verified | expired | issue
  status      String  @default("pending")
  provider    String?
  /// The reference an employee noted from the provider's paperwork.
  referenceNo String?

  requestDate  String?
  receivedDate String?
  expiryDate   String?
  remarks      String?

  /// PROVENANCE (§1.4).
  source               String   @default("manual_entry")
  recordedByEmployeeId String?
  recordedAt           DateTime @default(now())

  case  IncorporationCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  party IncorporationParty @relation(fields: [partyId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  /// One DSC record per party per case.
  @@unique([caseId, partyId])
  @@index([caseId])
  @@index([status])
  @@index([expiryDate])
}

/// A proposed name option. `priority` is the preference order submitted to
/// the portal; it is unique per case so two names cannot both be "first".
model IncorporationName {
  id     String @id @default(uuid())
  caseId String

  proposedName String
  priority     Int    @default(1)
  /// draft | ready | submitted | approved | rejected | rework | other
  status       String @default("draft")

  submissionDate String?
  /// The application reference an employee noted from the portal.
  applicationRef String?
  responseDate   String?
  remarks        String?

  /// PROVENANCE (§1.4) — the status below is what an employee SAW, recorded.
  source               String   @default("manual_entry")
  recordedByEmployeeId String?
  recordedAt           DateTime @default(now())

  case IncorporationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([caseId, priority])
  @@index([caseId])
  @@index([status])
}

/// A filing an employee prepared and submitted, and the references they noted
/// back from the portal.
model IncorporationFiling {
  id     String @id @default(uuid())
  caseId String

  /// spice_plus_part_a | spice_plus_part_b | agile_pro | inc_9 | fillip |
  /// run_llp | llp_agreement | pan_tan | other
  filingType String
  /// The portal an employee used, as they named it. Free text on purpose:
  /// we are recording what a person did, not selecting an integration.
  portal     String?

  applicationRef     String?
  acknowledgementRef String?
  preparedDate       String?
  submittedDate      String?
  /// not_started | preparing | ready_for_review | submitted | processing |
  /// query | resubmission | approved | rejected | closed
  status             String  @default("not_started")

  assignedEmployeeId String?
  remarks            String?
  clientDocumentId   String?

  /// PROVENANCE (§1.4).
  source               String   @default("manual_entry")
  recordedByEmployeeId String?
  recordedAt           DateTime @default(now())

  case           IncorporationCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  clientDocument ClientDocument?      @relation(fields: [clientDocumentId], references: [id], onDelete: SetNull)
  queries        IncorporationQuery[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([caseId])
  @@index([status])
  @@index([submittedDate])
}

/// A government query and the response cycle it starts.
///
/// OVERDUE IS NOT STORED. It is `responseDueDate < today && status != 'resolved'`,
/// computed at read time, so a row cannot sit in the database claiming to be
/// on time a week after it stopped being on time.
model IncorporationQuery {
  id       String  @id @default(uuid())
  caseId   String
  filingId String?

  queryDate   String
  /// The authority or portal, as the employee recorded it.
  authority   String?
  description String

  clientDocumentId   String?
  assignedEmployeeId String?
  responseDueDate    String?

  response              String?
  responseSubmittedDate String?
  resubmissionRef       String?
  resolution            String?
  remarks               String?
  /// new | assigned | preparing_response | ready | submitted | resolved | escalated
  status                String  @default("new")

  /// PROVENANCE (§1.4).
  source               String   @default("manual_entry")
  recordedByEmployeeId String?
  recordedAt           DateTime @default(now())

  case           IncorporationCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  filing         IncorporationFiling? @relation(fields: [filingId], references: [id], onDelete: SetNull)
  clientDocument ClientDocument?      @relation(fields: [clientDocumentId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([caseId])
  @@index([filingId])
  @@index([status])
  @@index([responseDueDate])
}

/// A final output — certificate, PAN, TAN, acknowledgement. Tracking and a
/// link to the file in ClientDocument; the bytes never live here.
model IncorporationDeliverable {
  id       String @id @default(uuid())
  caseId   String
  clientId String

  name   String
  /// certificate_of_incorporation | pan | tan | din | moa | aoa |
  /// llp_agreement | acknowledgement | other
  type   String @default("other")
  /// pending | prepared | delivered
  status String @default("pending")

  clientDocumentId      String?
  preparedDate          String?
  deliveredDate         String?
  deliveredByEmployeeId String?
  /// The number an employee read off the certificate.
  referenceNo           String?
  notes                 String?

  /// PROVENANCE (§1.4).
  source               String   @default("manual_entry")
  recordedByEmployeeId String?
  recordedAt           DateTime @default(now())

  case           IncorporationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  client         Client            @relation(fields: [clientId], references: [id])
  clientDocument ClientDocument?   @relation(fields: [clientDocumentId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([caseId])
  @@index([clientId])
  @@index([status])
}

/// SERVICE FEE TRACKING.
///
/// Created rather than reused after checking every candidate: `Payment` is
/// HRMS payroll/expense money moving TO AN EMPLOYEE; `BooksDocument` lives
/// under a BooksOrganisation, which is THE CLIENT'S OWN SET OF BOOKS, so the
/// firm's fee posted there would become the client's revenue; `ClientService`
/// carries no amount and `Lead.priceQuotedPaise` dies at conversion. Money is
/// integer PAISE here like everywhere else in this schema.
model IncorporationFee {
  id       String @id @default(uuid())
  caseId   String
  clientId String

  /// professional_fee | government_fee | dsc_fee | stamp_duty | other
  category    String  @default("professional_fee")
  description String?
  amountPaise Int     @default(0)
  /// pending | invoiced | partly_paid | paid | waived
  status      String  @default("pending")

  /// Optional link to the ClientService this was billed under, and to the
  /// firm's own invoice reference where one exists.
  clientServiceId String?
  invoiceRef      String?

  dueDate         String?
  paidDate        String?
  paidAmountPaise Int     @default(0)
  notes           String?

  recordedByEmployeeId String?

  case          IncorporationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  client        Client            @relation(fields: [clientId], references: [id])
  clientService ClientService?    @relation(fields: [clientServiceId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([caseId])
  @@index([clientId])
  @@index([status])
}

/// Append-only per-case trail — the human-readable story on the Timeline tab.
/// AuditLog remains the compliance record for every mutation (§8).
model IncorporationActivity {
  id     String @id @default(uuid())
  caseId String

  actorUserId String?
  action      String
  detail      String?

  case IncorporationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
}

// ============================================================
// REGISTRATION SERVICE
// ============================================================
// Workstation → Services → Registration. The ten registrations the firm
// files for clients (GST, incorporation, UDYAM, IEC, PF, ESI, …).
//
// IT CALLS NOTHING. There is no GST/MCA/DGFT client here and no portal
// scrape. Every government fact below was typed in by an employee and is
// stamped with who typed it and when, exactly as Incorporation does it.

/// The catalogue, seeded from the ten registrations. The frontend keeps its
/// own copy for icons and long-form copy; THIS is the source of truth for
/// what exists, so a registration cannot be filed against a type the server
/// does not know.
model RegistrationType {
  id             String @id @default(uuid())
  organisationId String
  /// Matches the frontend slug: 'gst', 'private-limited', 'msme-udyam', …
  code           String @unique
  name           String
  shortName      String
  /// tax | entity | licence | labour
  kind           String
  authority      String
  /// What the client ends up holding, e.g. 'REG-01 → GSTIN'.
  form           String

  /// india | tamil-nadu | none
  portalScope    String
  /// Null where no registry exists. Deep links are deliberate — several of
  /// these point at the form itself, not a site root.
  portalUrl      String?
  portalLabel    String
  /// The ClientDocument name a completed registration produces.
  outputDocument String

  /// Months between renewals; null = does not renew. IEC is 12 (the annual
  /// April–June confirmation), Shops & Establishment follows the state cycle.
  renewalMonths Int?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  registrations ClientRegistration[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([isActive, sortOrder])
}

/// One registration for one client — the aggregate root of this module.
///
/// NO DB-LEVEL UNIQUE on (clientId, typeId): every table here soft-deletes,
/// and a unique index counts soft-deleted rows, so deleting a registration
/// would permanently block re-registering that client. The "one of each per
/// client" rule is enforced in the route against `deletedAt: null` instead.
model ClientRegistration {
  id               String @id @default(uuid())
  organisationId   String
  /// 'REG-2026-0001' — allocated server-side inside the creating transaction.
  registrationCode String @unique

  clientId        String
  typeId          String
  /// Optional link to the ClientService row this is delivered under.
  clientServiceId String?

  /// not_started | in_progress | filed | registered | rejected | expired
  status String @default("not_started")

  /// The portal's acknowledgement — ARN (GST), SRN (MCA), TRN. Employee-typed.
  applicationRef     String?
  /// What the client ends up holding — GSTIN, CIN, UDYAM number, IEC.
  registrationNumber String?

  /// Calendar dates as 'YYYY-MM-DD' strings so they cannot drift across IST.
  appliedOn     String?
  registeredOn  String?
  validTill     String?
  /// Derived from renewalMonths on registration, and the thing the board
  /// sorts renewals by. Null when the registration does not renew.
  nextRenewalOn String?

  assignedEmployeeId    String?
  /// The certificate, once it exists, as a ClientDocument. Optional: the
  /// registration is real before the document is recorded.
  certificateDocumentId String?
  notes                 String?

  /// PROVENANCE — printed beside every government fact this row holds.
  source               String   @default("employee")
  recordedByEmployeeId String?
  recordedAt           DateTime @default(now())

  client Client              @relation(fields: [clientId], references: [id])
  type   RegistrationType    @relation(fields: [typeId], references: [id])
  events RegistrationEvent[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([clientId])
  @@index([typeId])
  @@index([status])
  @@index([nextRenewalOn])
}

/// Append-only trail for one registration — the human-readable story.
/// AuditLog remains the compliance record for every mutation.
model RegistrationEvent {
  id             String @id @default(uuid())
  registrationId String

  actorUserId     String?
  actorEmployeeId String?
  action          String
  detail          String?

  registration ClientRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([registrationId, createdAt])
}

// ============================================================
// ZOHO PAYMENTS — firm collections (docs/zoho-payments/README.md)
//
// This is the FIRM's own money, not client data. Two Zoho Payments
// accounts — one GST-registered entity, one not — connected via OAuth
// against payments.zoho.in. Modelled as Connection 1:N Account so a
// single Zoho login with two accounts and two separate logins both fit
// without rework (§2 of the spec).
//
// Money is INTEGER PAISE, never float. `raw` mirrors exactly what Zoho
// returned and is immutable — enforced in code, not schema. Unique
// (accountRowId, zohoPaymentId) keeps re-sync idempotent (§3).
// ============================================================

/// A Zoho OAuth connection. Holds the encrypted refresh token that
/// matters and the transient access token cached alongside it. The
/// status field runs the connection state machine defined in
/// server/src/modules/zpay/state.ts — do not write it from a route
/// without going through allowedNext / assertTransition.
model ZpayConnection {
  id             String @id @default(uuid())
  organisationId String

  /// Free-text label the operator sees in Settings, e.g. "GST entity",
  /// "Non-GST entity", or "Both" when one login carries both accounts.
  zohoOrgLabel String

  /// Encrypted at rest. NEVER logged, NEVER placed in error payloads,
  /// NEVER in job records. Nullable because the row exists before
  /// consent completes (status = not_connected | consent_pending).
  refreshTokenEncrypted String?
  accessTokenEncrypted  String?
  accessTokenExpiresAt  DateTime?

  /// Scopes actually granted at consent. Compared against the required
  /// set on every API call so a downgrade fails loudly rather than
  /// silently returning empty pages.
  scopesGranted String[]

  /// not_connected | consent_pending | connected | revoked | expired | error
  status String @default("not_connected")

  connectedAt   DateTime?
  connectedBy   String?
  lastErrorCode String?
  lastErrorAt   DateTime?

  accounts ZpayAccount[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([organisationId, status])
}

/// One Zoho Payments account. `accountId` is Zoho's identifier —
/// required as a query parameter on every API call, per §1 of the spec.
/// `label` is the operator's shorthand; `isGstRegistered` is the fact
/// that decides invoice series and drives GST reconciliation.
model ZpayAccount {
  id           String @id @default(uuid())
  connectionId String

  /// Zoho's own account identifier. Unique per connection.
  accountId String

  /// "GST" | "Non-GST" — the operator label, not to be relied on for
  /// tax logic. isGstRegistered is the source of truth.
  label           String
  isGstRegistered Boolean
  legalEntityName String
  gstin           String?

  /// e.g. "INV/2026/". Used by the exact-tier matcher to recognise an
  /// invoice number inside the payment's reference field (§4.2).
  invoiceSeriesPrefix String

  isActive       Boolean   @default(true)
  lastSyncAt     DateTime?
  /// pending | success | partial | failed — mirrors ZpaySyncRun.status
  /// so a card can render the last outcome without joining.
  lastSyncStatus String?

  connection       ZpayConnection        @relation(fields: [connectionId], references: [id])
  clients          Client[]
  payments         ZpayPayment[]
  refunds          ZpayRefund[]
  syncRuns         ZpaySyncRun[]
  externalInvoices ZpayExternalInvoice[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([connectionId, accountId])
  @@index([isActive])
}

/// One payment as Zoho recorded it. Idempotent upsert key is
/// (accountRowId, zohoPaymentId) so re-running a sync over the same
/// window never duplicates (§3). Amount and fee are INTEGER PAISE.
/// `raw` is the untouched Zoho response, treated as immutable.
model ZpayPayment {
  id           String @id @default(uuid())
  accountRowId String

  zohoPaymentId String

  amountPaise Int
  /// Zoho's per-transaction fee, when the API exposes it. Nullable so
  /// absence is modelled distinctly from zero (§3 note, §7 acceptance).
  feePaise    Int?
  currency    String  @default("INR")
  /// captured | authorized | failed | refunded | disputed | …
  /// Kept as a free string so an unknown Zoho value survives the sync
  /// rather than dropping the row.
  status      String
  paymentMode String?

  customerName  String?
  customerEmail String?

  /// THE matching key — invoice number placed here per the reference
  /// discipline in §4.1. Nullable because Zoho does not require it.
  referenceNumber String?
  description     String?

  mandateId     String?
  paidAt        DateTime
  createdAtZoho DateTime

  /// Whatever Zoho returned. Immutable — write once at sync, never
  /// updated in place.
  raw Json

  syncedAt DateTime @default(now())

  // ── matching (§4) ────────────────────────────────────────────────
  /// External invoice number, null until matched.
  matchedInvoiceRef String?
  matchedClientId   String?
  /// exact | probable | manual | unmatched
  matchType         String    @default("unmatched")
  matchConfirmedBy  String?
  matchConfirmedAt  DateTime?

  account ZpayAccount @relation(fields: [accountRowId], references: [id])

  @@unique([accountRowId, zohoPaymentId])
  @@index([accountRowId, paidAt])
  @@index([matchType])
  @@index([matchedClientId])
}

/// A refund, mirrored 1:1 from Zoho. Also amount-in-paise, also
/// immutable `raw`. Kept separate from ZpayPayment because Zoho models
/// them separately and the sync windows are independent.
model ZpayRefund {
  id            String @id @default(uuid())
  accountRowId  String
  zohoRefundId  String
  zohoPaymentId String

  amountPaise Int
  status      String
  reason      String?
  refundedAt  DateTime

  raw      Json
  syncedAt DateTime @default(now())

  account ZpayAccount @relation(fields: [accountRowId], references: [id])

  @@unique([accountRowId, zohoRefundId])
  @@index([accountRowId, refundedAt])
}

/// One run of the sync job, per account. Two accounts sync
/// independently (§3) — one failing must not stop the other, and the
/// per-account row is what the ops screen shows.
model ZpaySyncRun {
  id           String @id @default(uuid())
  accountRowId String

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  /// The window this run pulled — spec §3 overlaps 3 days for
  /// late-settlement changes; idempotent upserts make the overlap free.
  windowFrom DateTime
  windowTo   DateTime

  paymentsFetched Int @default(0)
  refundsFetched  Int @default(0)

  /// pending | success | partial | failed
  status       String  @default("pending")
  errorCode    String?
  errorDetail  String?
  apiCallsMade Int     @default(0)

  account ZpayAccount @relation(fields: [accountRowId], references: [id])

  @@index([accountRowId, startedAt])
  @@index([status])
}

/// External invoices — the source of truth the exact/probable matcher
/// verifies payment references against (docs/zoho-payments/README.md §4,
/// §9). Imported from a CSV/XLSX today; a Books integration or a real
/// invoicing API can replace the import path later without a schema
/// change.
///
/// Idempotent import key is `(billingAccountId, invoiceNumber)` so
/// re-uploading the same file merges instead of duplicating. Amounts are
/// INTEGER PAISE — the parser normalises the CSV's decimal-rupees
/// column at the boundary and nowhere else.
model ZpayExternalInvoice {
  id               String @id @default(uuid())
  organisationId   String
  /// Which of the firm's Zoho accounts raised this invoice — determines
  /// which payments can probable-match against it.
  billingAccountId String
  /// The invoice number as printed. The exact-tier matcher looks for this
  /// substring inside a Zoho payment's referenceNumber or description.
  invoiceNumber    String

  /// The client the invoice was raised to, if the CSV row carried a
  /// resolvable client_code. Nullable so an unresolved row still imports
  /// and matches on ref alone.
  clientId String?

  /// IST calendar date as ISO 'YYYY-MM-DD' string, per the schema's IST
  /// invariant.
  issuedOn String
  dueDate  String?

  amountPaise Int
  /// open | paid | cancelled — the operator's status, not ours.
  status      String @default("open")

  /// Where this row came from. `csv` today; `books` / `api` if we add
  /// alternate sources without changing the matcher.
  source     String   @default("csv")
  importedAt DateTime @default(now())
  importedBy String?

  billingAccount ZpayAccount @relation(fields: [billingAccountId], references: [id])
  client         Client?     @relation(fields: [clientId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([billingAccountId, invoiceNumber])
  @@index([organisationId, status])
  @@index([clientId, status])
  @@index([billingAccountId, issuedOn])
  @@index([billingAccountId, amountPaise])
}

// ═══════════════════════════════════════════════════════════════════════════
// QUOTATION (Workstation → Quotation)
//
// A priced proposal sent to a prospect (Lead) or an existing Client. It sits
// one step BEFORE the Task module: an accepted quotation is what authorises
// the work, and `convertedTaskId` records that hand-off exactly once.
//
// Money is in PAISE throughout (Int), the same rule as Lead.priceQuotedPaise
// and Books — no floats anywhere near a rupee figure. Every total on the
// parent row is DERIVED from the items by the service layer and recomputed on
// every write; nothing here is accepted from a request body.
// ═══════════════════════════════════════════════════════════════════════════

model Quotation {
  id             String @id @default(uuid())
  organisationId String
  /// Human-readable 'QT-2026-0001'. Per-year sequence, allocated server-side
  /// inside the creating transaction (see platform/workstation/codes.ts).
  quotationCode  String @unique

  /// Exactly one of leadId / clientId is set — the service layer enforces the
  /// XOR on write, the same shape FollowUp uses for the same reason.
  leadId   String?
  clientId String?

  /// What the quotation is for, in the client's language.
  subject    String
  /// YYYY-MM-DD. The date printed on the document, not the row's createdAt.
  quoteDate  String
  /// YYYY-MM-DD. After this date the quotation reads as expired.
  validUntil String

  /// draft | sent | accepted | rejected | expired
  status String @default("draft")

  /// Place of supply decides the tax split. Intra-state -> CGST+SGST,
  /// inter-state -> IGST. Stored, not inferred at render time, so a
  /// historical quotation keeps the split it was sent with.
  placeOfSupply String?
  isInterState  Boolean @default(false)

  // ── Derived money (paise). Never written from a request body. ──────────
  subtotalPaise Int @default(0)
  /// A flat discount on the whole quotation, applied after the line total.
  discountPaise Int @default(0)
  taxablePaise  Int @default(0)
  cgstPaise     Int @default(0)
  sgstPaise     Int @default(0)
  igstPaise     Int @default(0)
  totalPaise    Int @default(0)

  notes String?
  terms String?

  // ── Document composition (the builder) ────────────────────────────────
  /// Which template renders this quotation. 'gst-line-item' is the original
  /// priced-lines document; 'jns-compliance' is the professional-fee
  /// compliance proposal. The renderer switches on this, which is what lets
  /// both documents exist without either one bending to fit the other.
  templateId            String  @default("gst-line-item")
  /// Opening message, above the fee table. Plain text, newlines preserved.
  introduction          String?
  /// Closing line before the signature ('Thanks').
  closingText           String?
  /// Who signs it, as printed. Free text so a quotation can be signed by
  /// someone who is not an Audit OS employee row.
  preparedByName        String?
  preparedByDesignation String?
  /// Page size, margins, fonts, table and header style. Stored as sent, so a
  /// later change of house style does not silently redraw a quotation that
  /// has already gone out.
  layoutConfig          Json?
  /// Which blocks appear and in what order.
  blockConfig           Json?
  /// The client's particulars AS AT SENDING: name, type, industry, location,
  /// monthly volume. Editing the client master later must not rewrite a
  /// quotation that has already gone out, so the document reads from this
  /// snapshot once it exists rather than from the live client row.
  clientSnapshot        Json?

  preparedById String?

  sentAt          DateTime?
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  /// Set once, by conversion. @unique makes a second task from one accepted
  /// quotation impossible at the database level, mirroring Lead.convertedClientId.
  convertedTaskId String?   @unique
  convertedAt     DateTime?

  lead         Lead?                  @relation(fields: [leadId], references: [id])
  client       Client?                @relation(fields: [clientId], references: [id])
  preparedBy   Employee?              @relation("QuotationPreparedBy", fields: [preparedById], references: [id])
  items        QuotationItem[]
  workSections QuotationWorkSection[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([clientId])
  @@index([leadId])
  @@index([status])
  @@index([quoteDate])
  @@index([preparedById])
  @@index([createdAt])
}

/// One priced line. `amountPaise` and `taxPaise` are derived by the service
/// layer from quantity × unitRatePaise, less the line discount, at the line's
/// own GST rate — a quotation can mix 18% professional fees with a 0% reimbursement.
model QuotationItem {
  id          String  @id @default(uuid())
  quotationId String
  /// Optional link to the service catalogue. Null for a free-text line.
  serviceId   String?

  description     String
  /// Quantity in HUNDREDTHS (250 = 2.5), so half-hours and part-months are
  /// exact integers rather than floats.
  quantityCenti   Int    @default(100)
  unitRatePaise   Int    @default(0)
  /// Whole percent, 0-100.
  discountPercent Int    @default(0)
  /// Whole percent: 0 | 5 | 12 | 18 | 28.
  gstRatePercent  Int    @default(18)

  /// How often the fee recurs — 'Monthly', 'Quarterly', 'Yearly', 'One-Time'
  /// or anything the user types. Free text, because a fixed enum could not
  /// hold 'Every 6 Months'.
  frequency String?
  /// Optional grouping for the line, shown only if the template uses it.
  category  String?
  /// Longer description under the particulars, when the template shows one.
  detail    String?

  // ── Derived (paise) ───────────────────────────────────────────────────
  amountPaise Int @default(0)
  taxPaise    Int @default(0)

  sortOrder Int @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  service   Service?  @relation(fields: [serviceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quotationId, sortOrder])
}

// ════════════════════════════════════════════════════════════════════════
// COMPLIANCE CHECKLISTS — Workstation → Clients → [Client] → GST Checklist
//
// Three tables, and the whole design is the line between two of them:
//
//   ChecklistCategory + ChecklistService = THE MASTER CATALOGUE. What the
//   firm offers. Editing it changes what can be picked, never what any
//   client owes.
//
//   ClientChecklistItem = THE WORK. One row per client per obligation, with
//   its OWN status, assignee and due date. Client A going to 'completed'
//   touches one row and cannot be seen from Client B.
//
// `kind` ('gst') is what makes this reusable: a TDS or Income-Tax checklist
// later is the same three tables with a different kind, not a fourth table.
// Only 'gst' is populated and surfaced today.
// ════════════════════════════════════════════════════════════════════════

/// A grouping inside one kind of checklist — 'GST Returns', 'GST Notices'.
/// Users may add their own, which is why this is a row and not an enum.
model ChecklistCategory {
  id             String  @id @default(uuid())
  organisationId String
  /// Which checklist this belongs to. 'gst' today.
  kind           String  @default("gst")
  name           String
  description    String?
  active         Boolean @default(true)
  sortOrder      Int     @default(0)

  services ChecklistService[]
  items    ClientChecklistItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([organisationId, kind, name])
  @@index([kind, active])
}

/// THE MASTER SERVICE. Mirrors the catalogue shown at Workstation → Services
/// → GST; a service added here with `isCustom` becomes available to every
/// client's picker. It holds DEFAULTS only — never a client's status.
model ChecklistService {
  id               String  @id @default(uuid())
  organisationId   String
  kind             String  @default("gst")
  /// Stable handle for a seeded row ('registration'), so re-seeding updates
  /// rather than duplicates. Null for a user-added service.
  slug             String?
  name             String
  /// Statutory form: 'REG-01', 'GSTR-1 / 3B / CMP-08'.
  code             String?
  categoryId       String?
  /// recurring | project | externally-triggered | retainer
  serviceType      String  @default("project")
  /// one-time | monthly | quarterly | annual | event-based
  defaultFrequency String  @default("one-time")
  description      String?
  active           Boolean @default(true)
  sortOrder        Int     @default(0)
  /// True when a user created it from a client's checklist.
  isCustom         Boolean @default(false)

  category ChecklistCategory?    @relation(fields: [categoryId], references: [id])
  items    ClientChecklistItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([organisationId, kind, name])
  @@index([kind, active])
  @@index([categoryId])
}

/// ONE CLIENT'S OBLIGATION. Everything that differs between clients lives
/// here: status, who is doing it, when it is due, what was noted.
///
/// `serviceId` points at the master row it was picked from and is null for a
/// one-off item that exists only for this client. Its @@unique with clientId
/// is what stops the same master service being added twice — SQLite treats
/// NULLs as distinct, so custom items are unaffected.
model ClientChecklistItem {
  id             String  @id @default(uuid())
  organisationId String
  kind           String  @default("gst")
  clientId       String
  serviceId      String?
  categoryId     String?

  /// Set only for a custom item; otherwise the master service's name is used.
  customName  String?
  description String?

  /// STORED status: not_started | in_progress | pending | completed | not_required.
  /// 'overdue' is DERIVED on read (past due and not completed) and never
  /// stored, so completing a late item does not leave it stuck overdue.
  status       String    @default("not_started")
  assignedToId String?
  /// YYYY-MM-DD, like every other date in Workstation.
  dueDate      String?
  frequency    String    @default("one-time")
  notes        String?
  completedAt  DateTime?
  sortOrder    Int       @default(0)

  client     Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service    ChecklistService?         @relation(fields: [serviceId], references: [id])
  category   ChecklistCategory?        @relation(fields: [categoryId], references: [id])
  assignedTo Employee?                 @relation("ChecklistAssignee", fields: [assignedToId], references: [id])
  activities ClientChecklistActivity[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  Organisation Organisation @relation(fields: [organisationId], references: [id])

  @@unique([clientId, kind, serviceId])
  @@index([clientId, kind])
  @@index([status])
  @@index([assignedToId])
  @@index([dueDate])
}

/// Append-only trail for one checklist item: created, assigned, status
/// changed, due date changed, completed. Written by the service layer only.
model ClientChecklistActivity {
  id        String  @id @default(uuid())
  itemId    String
  /// created | assigned | status_changed | due_date_changed | completed | reopened | note
  action    String
  detail    String?
  /// Employee id of whoever did it; kept as a plain id so the trail survives
  /// an employee row being archived.
  actorId   String?
  actorName String?

  item ClientChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([itemId, createdAt])
}

/// A Nature-of-Work section: one heading, an optional lead-in, and bullets.
/// Separate rows rather than a blob of HTML so the builder can reorder and
/// edit a single bullet, and so a future template can render them differently.
model QuotationWorkSection {
  id          String  @id @default(uuid())
  quotationId String
  sortOrder   Int     @default(0)
  title       String
  description String?

  quotation Quotation           @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  items     QuotationWorkItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quotationId, sortOrder])
}

/// One bullet of a work section.
model QuotationWorkItem {
  id        String @id @default(uuid())
  sectionId String
  sortOrder Int    @default(0)
  content   String

  section QuotationWorkSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId, sortOrder])
}

/// A quotation TEMPLATE — the document shape, separate from any quotation's
/// data. Seeded with the two that exist; adding a third is a row plus a
/// renderer branch, not a change to every quotation.
model QuotationTemplate {
  id             String  @id @default(uuid())
  organisationId String
  /// Stable handle the renderer switches on: 'gst-line-item', 'jns-compliance'.
  slug           String
  name           String
  description    String?
  /// Default block order/visibility and layout for quotations made from it.
  configuration  Json?
  active         Boolean @default(true)
  sortOrder      Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organisationId, slug])
}

/// ENGAGEMENT LETTER — the terms of an engagement, as a composed document.
///
/// A sibling of Quotation, deliberately built on the same three-part split:
/// DATA (the fields below), TEMPLATE (`templateId`) and COMPOSITION
/// (`blockConfig`). The letter's prose lives in `blockConfig` as ordered
/// blocks rather than in named columns, so a firm can add a clause, move
/// confidentiality above fees, or drop a section without a migration.
model EngagementLetter {
  id             String @id @default(uuid())
  organisationId String
  /// 'EL-2026-0001'. Per-year sequence, allocated inside the creating
  /// transaction, exactly as quotationCode is.
  letterCode     String @unique

  /// Exactly one of leadId / clientId, the same XOR Quotation enforces.
  leadId   String?
  clientId String?

  subject String

  /// YYYY-MM-DD, all three. `letterDate` is what prints at the top; the
  /// effective dates are the period the engagement covers and are what the
  /// {{effective_from}} / {{effective_until}} placeholders resolve to.
  letterDate     String
  effectiveFrom  String?
  effectiveUntil String?
  /// '2024-25', as a firm writes it. Free text: a financial year is not a
  /// date range everywhere, and the letter prints whatever is typed.
  financialYear  String?

  /// draft | sent | accepted | archived
  status String @default("draft")

  /// The recipient AS AT SENDING — name, designation, company, address.
  /// Editing the client master later must not silently rewrite a letter that
  /// has already gone out, so the document reads this snapshot once set.
  recipientSnapshot Json?

  templateId   String @default("jns-accounting")
  /// Ordered document blocks: paragraphs, titled sections, the fee table,
  /// spacers and the signature. The whole body of the letter.
  blockConfig  Json?
  /// Page size, margins, fonts — stored as sent.
  layoutConfig Json?

  /// Who signs on the firm's side, as printed.
  signatoryName              String?
  signatoryDesignation       String?
  /// Who countersigns, as printed on the confirmation line.
  clientSignatoryName        String?
  clientSignatoryDesignation String?

  preparedById String?

  sentAt     DateTime?
  acceptedAt DateTime?

  lead       Lead?               @relation(fields: [leadId], references: [id])
  client     Client?             @relation(fields: [clientId], references: [id])
  preparedBy Employee?           @relation("EngagementPreparedBy", fields: [preparedById], references: [id])
  feeItems   EngagementFeeItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([clientId])
  @@index([leadId])
  @@index([status])
  @@index([letterDate])
  @@index([createdAt])
}

/// One priced line in an engagement letter's Fees section.
///
/// Amounts are paise and the letter carries no computed total: an engagement
/// mixes monthly, quarterly and yearly bases, so a single sum of the column
/// would be a number that means nothing. Each line states its own basis.
model EngagementFeeItem {
  id        String @id @default(uuid())
  letterId  String
  sortOrder Int    @default(0)

  service      String
  description  String?
  /// 'per month', 'per quarter', 'per year', 'per return' — free text.
  frequency    String?
  amountPaise  Int     @default(0)
  /// How it is billed, when that needs saying beyond the frequency.
  billingBasis String?
  notes        String?

  letter EngagementLetter @relation(fields: [letterId], references: [id], onDelete: Cascade)

  @@index([letterId, sortOrder])
}
