/// One table for every transaction document.
/// kind: estimate | sales_order | invoice | retainer_invoice | credit_note |
///       purchase_order | bill | vendor_credit
/// status: draft | sent | accepted | declined | posted | partially_paid | paid |
///         closed | void | expired
model BooksDocument {
  id             String  @id @default(uuid())
  booksOrgId     String
  kind           String
  number         String
  contactId      String
  date           String
  dueDate        String?
  expiryDate     String?
  referenceNo    String?
  status         String  @default("draft")
  currency       String  @default("INR")
  exchangeRate   Float   @default(1)
  placeOfSupply  String?
  isInterState   Boolean @default(false)
  taxInclusive   Boolean @default(false)
  /// Document-level discount, applied before tax. bp of subtotal or a fixed amount.
  discountPercentBp Int   @default(0)
  discountAmount BigInt  @default(0)
  subtotal       BigInt  @default(0)
  discountTotal  BigInt  @default(0)
  taxableTotal   BigInt  @default(0)
  cgstTotal      BigInt  @default(0)
  sgstTotal      BigInt  @default(0)
  igstTotal      BigInt  @default(0)
  taxTotal       BigInt  @default(0)
  tdsRateId      String?
  tdsTotal       BigInt  @default(0)
  roundOff       BigInt  @default(0)
  total          BigInt  @default(0)
  /// Base-currency total (== total when currency is the base).
  baseTotal      BigInt  @default(0)
  balanceDue     BigInt  @default(0)
  /// Remaining unapplied credit on a credit note / vendor credit.
  creditsRemaining BigInt @default(0)
  journalId      String?
  /// The document this one was created from (SO → invoice, PO → bill, …).
  sourceDocumentId String?
  recurringProfileId String?
  notes          String?
  terms          String?
  voidReason     String?

  lines BooksDocumentLine[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?

  @@unique([booksOrgId, kind, number])
  @@index([booksOrgId, kind, status])
  @@index([booksOrgId, contactId])
  @@index([booksOrgId, date])
}

model BooksDocumentLine {
  id           String  @id @default(uuid())
  documentId   String
  booksOrgId   String
  lineNo       Int
  itemId       String?
  description  String
  hsnSac       String?
  quantity     Float   @default(1)
  /// Unit rate in transaction-currency minor units.
  rate         BigInt
  discountPercentBp Int @default(0)
  discountAmount BigInt @default(0)
  taxRateId    String?
  taxPercentBp Int     @default(0)
  taxable      BigInt  @default(0)
  cgst         BigInt  @default(0)
  sgst         BigInt  @default(0)
  igst         BigInt  @default(0)
  tax          BigInt  @default(0)
  lineTotal    BigInt  @default(0)
  /// Income / expense / asset ledger this line posts to.
  ledgerId     String

  document BooksDocument @relation(fields: [documentId], references: [id])

  @@index([documentId])
}

/// kind: invoice | bill. frequency: weekly | monthly | quarterly | yearly.
model BooksRecurringProfile {
  id           String  @id @default(uuid())
  booksOrgId   String
  kind         String
  name         String
  contactId    String
  frequency    String
  startDate    String
  endDate      String?
  nextRunDate  String
  lastRunDate  String?
  /// Serialised document input (lines, terms, currency …) used for each run.
  templateJson String
  status       String  @default("active")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?

  @@index([booksOrgId, status, nextRunDate])
}

/// kind: received | made. Allocations live on the journal (BooksBillAllocation).
model BooksPayment {
  id              String  @id @default(uuid())
  booksOrgId      String
  kind            String
  number          String
  contactId       String
  date            String
  currency        String  @default("INR")
  exchangeRate    Float   @default(1)
  fxAmount        BigInt
  amount          BigInt
  depositLedgerId String
  bankCharges     BigInt  @default(0)
  tdsAmount       BigInt  @default(0)
  mode            String  @default("bank_transfer")
  reference       String?
  notes           String?
  journalId       String?
  status          String  @default("posted")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@unique([booksOrgId, kind, number])
  @@index([booksOrgId, contactId])
}

model BooksBankTransfer {
  id           String @id @default(uuid())
  booksOrgId   String
  date         String
  number       String
  fromLedgerId String
  toLedgerId   String
  amount       BigInt
  reference    String?
  notes        String?
  journalId    String?
  status       String @default("posted")

  createdAt DateTime @default(now())
  createdBy String?

  @@unique([booksOrgId, number])
