// AUDIT OS · HRMS — unified Prisma schema (Part 1 core-HR + Part 2 modules).
//
// ONE MODEL, ONE SOURCE OF TRUTH. There is exactly one User, one Employee,
// one Role, one ExpenseCategory and one payroll model in this file. Where
// Part 1 and Part 2 both described an entity, the Part 1 domain shape wins
// (it is the shape the shipped React frontend consumes) and the useful Part 2
// additions are folded into it.
//
// NAMING: columns are camelCase (Prisma convention). The HTTP API speaks
// snake_case (Part 1 §9/§10). The translation happens in exactly one place —
// src/api/serialize.ts — never inside a route handler or a React component.
//
// MONEY: every monetary column is an integer number of PAISE. No floats.
//
// DATES: a calendar date that must stay IST-stable (attendance date, leave
// range, effective-from, expiry) is stored as an ISO 'YYYY-MM-DD' STRING.
// A point in time is a DateTime stored in UTC. Storing calendar dates as
// DateTime is what makes attendance rows land on the wrong day across the
// IST/UTC boundary, so we do not do it.
//
// SOFT DELETE: every mutable table carries deletedAt; reads filter it out.
// AuditLog and LedgerTransaction are append-only and carry no deletedAt.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite is the local development database. Switching to PostgreSQL is a
  // two-line change: provider = "postgresql" and a Postgres DATABASE_URL.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// PLATFORM PRIMITIVES
// ============================================================

model Organisation {
  id                   String @id @default(uuid())
  name                 String
  timezone             String @default("Asia/Kolkata")
  currency             String @default("INR")
  fiscalYearStartMonth Int    @default(4)

  departments   Department[]
  designations  Designation[]
  workLocations WorkLocation[]
  workSchedules WorkSchedule[]
  holidays      Holiday[]
  employees     Employee[]
  users         User[]
  leaveTypes    LeaveType[]
  expenseCategories ExpenseCategory[]
  statutoryRates    StatutoryRate[]
  payrollRuns       PayrollRun[]
  chats             Chat[]
  toolDocuments     ToolDocument[]
  toolJobs          ToolJob[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

model Role {
  id          String @id @default(uuid())
  // employee | dept_manager | hr_admin | finance_admin | md
  code        String @unique
  name        String
  description String?

  permissions RolePermission[]
  users       User[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

model Permission {
  id          String @id @default(uuid())
  // '<module>.<action>[.<qualifier>]' — see src/platform/rbac/matrix.ts
  code        String @unique
  description String

  roles RolePermission[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String
  // self | department | organisation — a grant is (permission, scope).
  scope        String @default("self")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model User {
  id             String    @id @default(uuid())
  organisationId String
  email          String    @unique
  passwordHash   String
  roleId         String
  // Nullable BOTH ways (Part 1 §4.2): automation users have no employee, and
  // an employee (e.g. an exited one) may have no login.
  employeeId     String?   @unique
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])
  employee     Employee?    @relation(fields: [employeeId], references: [id])

  notifications Notification[]
  auditLogs     AuditLog[]
  toolDocuments ToolDocument[]
  toolJobs      ToolJob[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

// ============================================================
// CONFIGURATION (Settings §8.11)
// ============================================================

model Department {
  id             String @id @default(uuid())
  organisationId String
  name           String
  code           String @unique

  organisation Organisation @relation(fields: [organisationId], references: [id])
  employees    Employee[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

model Designation {
  id             String @id @default(uuid())
  organisationId String
  name           String

  organisation Organisation @relation(fields: [organisationId], references: [id])
  employees    Employee[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

model WorkLocation {
  id             String  @id @default(uuid())
  organisationId String
  name           String
  address        String  @default("")
  latitude       Float
  longitude      Float
  radiusM        Int     @default(150)
  isActive       Boolean @default(true)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  employees    Employee[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

model WorkSchedule {
  id                   String @id @default(uuid())
  organisationId       String
  name                 String
  standardStart        String // 'HH:mm'
  standardEnd          String // 'HH:mm'
  fullDayHours         Float  @default(8)
  halfDayHours         Float  @default(4)
  breakMinutes         Int    @default(60)
  // JSON array of ISO weekday numbers 1..7 (SQLite has no native Json column).
  workingDaysJson      String @default("[1,2,3,4,5]")
  alternateSaturdayOff Boolean @default(false)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  employees    Employee[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

model Holiday {
  id             String  @id @default(uuid())
  organisationId String
  date           String // 'YYYY-MM-DD'
  name           String
  isOptional     Boolean @default(false)

  organisation Organisation @relation(fields: [organisationId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([date])
}

model LeaveType {
  id                    String  @id @default(uuid())
  organisationId        String
  // casual | sick | earned | lop | comp_off
  code                  String
  name                  String
  // null = unlimited (Loss of Pay)
  annualEntitlement     Float?
  accrual               String  @default("monthly") // monthly | earned
  carryForwardMax       Float   @default(0)
  halfDayAllowed        Boolean @default(false)
  minNoticeDays         Int     @default(0)
  accrueDuringProbation Boolean @default(true)

  organisation Organisation   @relation(fields: [organisationId], references: [id])
  balances     LeaveBalance[]
  requests     LeaveRequest[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([organisationId, code])
}

model ExpenseCategory {
  id              String  @id @default(uuid())
  organisationId  String
  name            String
  code            String  @unique
  isActive        Boolean @default(true)
  requiresReceipt Boolean @default(true)
  glAccount       String?

  organisation Organisation @relation(fields: [organisationId], references: [id])
  expenses     Expense[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

// Statutory configuration is DATA, never a literal in code. A row is
// (code, effectiveFrom, effectiveTo); payroll resolves the row effective on
// the period start and snapshots it onto the run.
model StatutoryRate {
  id             String  @id @default(uuid())
  organisationId String
  // 'pf.employee_rate' | 'pf.wage_ceiling' | 'esi.gross_threshold' | 'pt.tn.slab' | …
  code           String
  // Stored as a string; the caller parses (rate, ceiling, or a slab JSON array).
  value          String
  effectiveFrom  String  // 'YYYY-MM-DD'
  effectiveTo    String? // 'YYYY-MM-DD'
  notes          String?

  organisation Organisation @relation(fields: [organisationId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([code, effectiveFrom])
}

// ============================================================
// CORE HR
// ============================================================

model Employee {
  id             String @id @default(uuid())
  organisationId String
  employeeCode   String @unique
  firstName      String
  lastName       String
  fullName       String
  // partner | manager | executive | articled | support
  type           String @default("executive")
  // active | on_leave | probation | notice_period | inactive
  status         String @default("active")

  designationId String
  departmentId  String
  managerId     String? // self-referential, nullable
  workLocationId String
  workScheduleId String

  email            String  @unique
  phone            String  @default("")
  joiningDate      String  // 'YYYY-MM-DD'
  exitDate         String?
  exitReason       String?
  noticePeriodDays Int     @default(30)

  // RESERVED FOR WORKSTATION — nullable from day one, no UI in this phase.
  weeklyCapacityHours Float?

  photoUrl               String?
  address                String?
  emergencyContactName   String?
  emergencyContactPhone  String?
  bankAccountMasked      String?

  organisation Organisation @relation(fields: [organisationId], references: [id])
  department   Department   @relation(fields: [departmentId], references: [id])
  designation  Designation  @relation(fields: [designationId], references: [id])
  workLocation WorkLocation @relation(fields: [workLocationId], references: [id])
  workSchedule WorkSchedule @relation(fields: [workScheduleId], references: [id])
  manager      Employee?    @relation("EmployeeManager", fields: [managerId], references: [id])
  reports      Employee[]   @relation("EmployeeManager")

  user               User?
  training           ArticledTraining?  @relation("TrainingSubject")
  principalTrainings ArticledTraining[] @relation("TrainingPrincipal")
  attendance         Attendance[]
  corrections        AttendanceCorrection[]
  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]
  documents          EmployeeDocument[]
  salaryStructures   SalaryStructure[]
  payrollItems       PayrollItem[]
  payslips           Payslip[]
  expenses           Expense[]
  payments           Payment[]
  ledgerEntries      LedgerTransaction[]
  chatMemberships    ChatMember[]
  chatMessages       ChatMessage[]
  messageReads       MessageRead[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([departmentId])
  @@index([managerId])
}

model ArticledTraining {
  id                  String @id @default(uuid())
  employeeId          String @unique
  icaiRegistrationNo  String
  principalEmployeeId String
  trainingStart       String
  trainingEnd         String
  currentYear         Int    @default(1)
  stipendSlab         String @default("")
  // active | transferred | completed | terminated
  status              String @default("active")

  employee  Employee @relation("TrainingSubject", fields: [employeeId], references: [id])
  principal Employee @relation("TrainingPrincipal", fields: [principalEmployeeId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

model EmployeeDocument {
  id         String  @id @default(uuid())
  employeeId String
  name       String
  // employment | joining | certificate | hr | tax | bank | company_issued | icai
  type       String
  fileKey    String
  uploadedBy String
  uploadedAt DateTime @default(now())
  expiryDate String?
  // valid | expiring_soon | expired | pending_verification (derived on read
  // from expiryDate, except the sticky pending_verification state)
  status     String   @default("valid")

  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([employeeId])
}

// ============================================================
// ATTENDANCE (§8.2)
// ============================================================

model Attendance {
  id         String @id @default(uuid())
  employeeId String
  date       String // 'YYYY-MM-DD' IST calendar date

  checkInAt  DateTime?
  checkOutAt DateTime?

  checkInLat        Float?
  checkInLong       Float?
  checkInAccuracyM  Float?
  checkOutLat       Float?
  checkOutLong      Float?
  checkOutAccuracyM Float?

  checkInLocationId  String?
  checkOutLocationId String?
  // office | client_site | remote | field
  locationType       String?
  offSiteReason      String?

  workedMinutes Int?
  breakMinutes  Int?
  // present | late | absent | half_day | wfh | on_leave | missing_check_in | missing_check_out
  status        String
  // web_geo | biometric | manual
  source        String  @default("web_geo")
  // none | requested | approved | rejected
  correctionStatus String @default("none")
  device        String?
  ip            String?

  // RESERVED FOR WORKSTATION — no FK, there is no Client table yet.
  clientId String?

  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([employeeId, date])
  @@index([date])
}

model AttendanceCorrection {
  id                   String  @id @default(uuid())
  attendanceId         String? // null when the correction creates a new day
  employeeId           String
  date                 String
  requestedCheckInAt   DateTime?
  requestedCheckOutAt  DateTime?
  reason               String
  attachmentUrl        String?
  // pending | approved | rejected
  status               String  @default("pending")
  reviewedBy           String?
  reviewedAt           DateTime?
  reviewNotes          String?

  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([employeeId, status])
}

// ============================================================
// LEAVE (§8.3)
// ============================================================

model LeaveBalance {
  id              String @id @default(uuid())
  employeeId      String
  leaveTypeId     String
  fiscalYearStart String // 'YYYY-04-01'
  entitled        Float  @default(0)
  availed         Float  @default(0)
  carriedForward  Float  @default(0)

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, leaveTypeId, fiscalYearStart])
}

model LeaveRequest {
  id                  String  @id @default(uuid())
  employeeId          String
  leaveTypeId         String
  startDate           String
  endDate             String
  halfDay             Boolean @default(false)
  // Server-authoritative: the sandwich rule is applied at write time.
  computedWorkingDays Float
  reason              String
  attachmentUrl       String?
  // pending | approved | rejected | cancelled
  status              String  @default("pending")
  approverId          String? // manager who approved (stage 1)
  hrApproverId        String? // HR who approved (stage 2, > 5 days)
  approvedAt          DateTime?
  rejectionReason     String?

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([employeeId, startDate])
  @@index([status])
}

// ============================================================
// PAYROLL (§8.4)
// ============================================================

model SalaryStructure {
  id                    String  @id @default(uuid())
  employeeId            String
  effectiveFrom         String
  effectiveTo           String? // null = currently effective
  monthlyCtcPaise       Int     @default(0)
  basicPaise            Int     @default(0)
  hraPaise              Int     @default(0)
  conveyancePaise       Int     @default(0)
  specialAllowancePaise Int     @default(0)
  // JSON array of { code, label, amount_paise, kind: 'earning' | 'deduction' }
  customComponentsJson  String  @default("[]")
  notes                 String?

  employee     Employee      @relation(fields: [employeeId], references: [id])
  payrollItems PayrollItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([employeeId, effectiveFrom])
}

model PayrollRun {
  id             String @id @default(uuid())
  organisationId String
  periodStart    String
  periodEnd      String
  // draft → hr_review → finance_review → approved → processed
  stage          String @default("draft")
  isCalculating  Boolean @default(false)
  // Snapshot of the StatutoryRate table at calculate time. A rate change
  // afterwards must NOT alter a processed run's numbers.
  statutorySnapshotJson String?

  headcount            Int @default(0)
  grossTotalPaise      Int @default(0)
  deductionsTotalPaise Int @default(0)
  netTotalPaise        Int @default(0)

  reviewedBy  String?
  approvedBy  String?
  processedBy String?
  processedAt DateTime?
  notes       String?

  organisation Organisation  @relation(fields: [organisationId], references: [id])
  items        PayrollItem[]
  payslips     Payslip[]
  payments     Payment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([periodStart, periodEnd])
}

model PayrollItem {
  id                String @id @default(uuid())
  payrollRunId      String
  employeeId        String
  salaryStructureId String

  payableDays Float
  presentDays Float
  onLeaveDays Float
  absentDays  Float
  lopDays     Float

  // "Show the working": full component-by-component breakdown, in the exact
  // PayrollEarnings / PayrollDeductions shape the payslip renders.
  earningsJson   String
  deductionsJson String

  grossPaise           Int
  totalDeductionsPaise Int
  netPaise             Int
  gratuityAccrualPaise Int @default(0)
  notes                String?

  payrollRun      PayrollRun      @relation(fields: [payrollRunId], references: [id])
  employee        Employee        @relation(fields: [employeeId], references: [id])
  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id])
  payslip         Payslip?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
}

model Payslip {
  id            String   @id @default(uuid())
  payrollRunId  String
  payrollItemId String   @unique
  employeeId    String
  payslipNo     String   @unique
  publishedAt   DateTime
  fileKey       String
  // published | revoked
  status        String   @default("published")

  payrollRun  PayrollRun  @relation(fields: [payrollRunId], references: [id])
  payrollItem PayrollItem @relation(fields: [payrollItemId], references: [id])
  employee    Employee    @relation(fields: [employeeId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([employeeId])
}

// ============================================================
// EXPENSES (§8.5)
// ============================================================

model Expense {
  id           String @id @default(uuid())
  expenseNo    String @unique
  employeeId   String
  categoryId   String
  title        String
  amountPaise  Int
  expenseDate  String
  description  String @default("")
  // cash | card | upi | bank_transfer | other
  paymentMethod String @default("card")
  receiptFileKey String?
  notes        String?
  // draft → pending_manager → pending_finance → approved → paid | rejected
  stage        String @default("draft")

  submittedAt        DateTime?
  managerApprovedBy  String?
  managerApprovedAt  DateTime?
  financeApprovedBy  String?
  financeApprovedAt  DateTime?
  paidAt             DateTime?
  paymentId          String?
  rejectionReason    String?
  rejectedBy         String?
  rejectedAt         DateTime?

  // RESERVED FOR WORKSTATION — nullable, no UI, no FK.
  clientId String?

  employee  Employee        @relation(fields: [employeeId], references: [id])
  category  ExpenseCategory @relation(fields: [categoryId], references: [id])
  approvals ExpenseApproval[]
  payments  Payment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([employeeId, stage])
  @@index([stage])
}

/// Append-only stage-transition trail. No update, no delete.
model ExpenseApproval {
  id          String @id @default(uuid())
  expenseId   String
  actorUserId String
  fromStage   String
  toStage     String
  notes       String?

  expense Expense @relation(fields: [expenseId], references: [id])

  createdAt DateTime @default(now())

  @@index([expenseId])
}

// ============================================================
// ACCOUNTS & PAYMENTS (§8.6)
// ============================================================

model Payment {
  id           String  @id @default(uuid())
  paymentNo    String  @unique
  employeeId   String
  payrollRunId String?
  expenseId    String?
  amountPaise  Int
  // bank_transfer | cash | cheque | mock
  method       String  @default("mock")
  reference    String  @unique
  // pending | processing | completed | failed
  status       String  @default("pending")
  paidAt       DateTime?

  employee      Employee            @relation(fields: [employeeId], references: [id])
  payrollRun    PayrollRun?         @relation(fields: [payrollRunId], references: [id])
  expense       Expense?            @relation(fields: [expenseId], references: [id])
  ledgerEntries LedgerTransaction[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([employeeId, status])
}

/// APPEND-ONLY. There is no update and no delete path to this table anywhere
/// in the application — a correction is a contra entry that points back at the
/// row it reverses via reversesId. `namespace` is the hard boundary that keeps
/// client accounting out of Audit OS's own books (§8.6).
model LedgerTransaction {
  id             String @id @default(uuid())
  transactionRef String @unique
  namespace      String @default("INTERNAL")
  // Monotonic, assigned inside the posting transaction.
  sequence       Int    @unique
  date           String
  // Payroll | Expense Reimbursement | Office Expense | Employee Advance |
  // Advance Recovery | Payment
  type           String
  description    String
  employeeId     String?
  category       String?
  debitPaise     Int    @default(0)
  creditPaise    Int    @default(0)
  runningBalancePaise Int
  referenceId    String
  referenceType  String
  // posted | reversed  (`reversed` means "a contra entry exists for me")
  status         String @default("posted")

  paymentId  String?
  reversesId String?

  employee Employee? @relation(fields: [employeeId], references: [id])
  payment  Payment?  @relation(fields: [paymentId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?

  @@index([date])
  @@index([type])
}

// ============================================================
// MESSAGES (§8.7)
// ============================================================
//
// Shapes follow src/data/models.ts: a chat is `group` or `dm`; membership is
// a soft-leave row so history survives someone leaving; a read receipt is one
// row per (message, employee) rather than a per-chat high-water mark, which is
// what lets "read by me" be answered for an individual message.

model Chat {
  id             String  @id @default(uuid())
  organisationId String
  // group | dm
  type           String
  // Groups carry a name; a DM derives its display name from the other member.
  name           String?
  description    String?

  // RESERVED FOR WORKSTATION — nullable, no UI in this phase.
  subjectType String?
  subjectId   String?

  // Denormalised so the chat list can sort by activity without a join.
  lastMessageAt DateTime?

  organisation Organisation  @relation(fields: [organisationId], references: [id])
  members      ChatMember[]
  messages     ChatMessage[]
  reads        MessageRead[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([lastMessageAt])
}

model ChatMember {
  id         String    @id @default(uuid())
  chatId     String
  employeeId String
  // member | admin
  role       String    @default("member")
  joinedAt   DateTime  @default(now())
  /// Soft leave — the person stops receiving the chat but history is intact.
  leftAt     DateTime?

  chat     Chat     @relation(fields: [chatId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([chatId, employeeId])
  @@index([employeeId])
}

model ChatMessage {
  id               String @id @default(uuid())
  chatId           String
  authorEmployeeId String
  body             String
  /// Reply-to. A thread is one level deep by design.
  parentId         String?
  /// JSON array of employee ids. Reserved for @mentions; empty in this phase.
  mentionsJson     String @default("[]")

  chat     Chat          @relation(fields: [chatId], references: [id])
  author   Employee      @relation(fields: [authorEmployeeId], references: [id])
  parent   ChatMessage?  @relation("MessageReply", fields: [parentId], references: [id])
  replies  ChatMessage[] @relation("MessageReply")
  reads    MessageRead[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete — messages are retained for audit.
  deletedAt DateTime?

  @@index([chatId, createdAt])
}

model MessageRead {
  id         String   @id @default(uuid())
  chatId     String
  messageId  String
  employeeId String
  readAt     DateTime @default(now())

  chat     Chat        @relation(fields: [chatId], references: [id])
  message  ChatMessage @relation(fields: [messageId], references: [id])
  employee Employee    @relation(fields: [employeeId], references: [id])

  @@unique([messageId, employeeId])
  @@index([chatId, employeeId])
}

// ============================================================
// NOTIFICATIONS + AUDIT (§8.9, §10)
// ============================================================

model Notification {
  id         String  @id @default(uuid())
  userId     String
  type       String
  // attendance | leave | payroll | expense | message | document | system
  module     String
  entityType String?
  entityId   String?
  title      String
  body       String
  actionUrl  String?
  isRead     Boolean @default(false)

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

/// Append-only. There is no update shape and no delete.
model AuditLog {
  id          String  @id @default(uuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  beforeJson  String?
  afterJson   String?
  ip          String?
  userAgent   String?

  actor User? @relation(fields: [actorUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================
// WORKSTATION (AUDIT_OS_WORKSTATION.md §5)
// ============================================================
//
// ONE CENTRAL CLIENT RECORD. Leads, Services, Follow-ups, Documents, GST,
// E-way Bills, Tasks and Activity all reference `Client.id`. Nothing in this
// section creates a second client row, and nothing creates a second employee
// table — every assignment is a scalar `…EmployeeId` resolved against the
// HRMS `Employee` at read time, exactly like `EmployeeDocument.uploadedBy`
// and `Expense.managerApprovedBy` already do. That is deliberate: declaring
// Prisma relations here would force back-relation fields onto `Employee` and
// `Organisation`, and those models must stay untouched.

/// Configurable service catalog. A ClientService and a Lead both point here.
model Service {
  id             String  @id @default(uuid())
  organisationId String
  code           String  @unique
  name           String
  isActive       Boolean @default(true)
  sortOrder      Int     @default(0)

  leads          Lead[]
  clientServices ClientService[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

/// A prospect, BEFORE it becomes a client. Never deleted once converted.
model Lead {
  id             String @id @default(uuid())
  organisationId String
  /// Human-readable 'LD-1001'. Allocated server-side inside a transaction.
  leadCode       String @unique

  name             String
  contactNumber    String
  email            String?
  serviceId        String
  priceQuotedPaise Int    @default(0)
  /// HRMS Employee id. No FK by design — see the section header.
  assignedEmployeeId String
  /// new | contacted | requirement_identified | quote_sent | negotiation | won | lost
  status           String @default("new")
  notes            String?
  lostReason       String?

  /// Set once, by conversion. @unique is what makes a second client from one
  /// lead impossible at the database level rather than only in a handler.
  convertedClientId String?   @unique
  convertedAt       DateTime?

  service   Service    @relation(fields: [serviceId], references: [id])
  followUps FollowUp[]

  /// System-generated (§5.2). Never accepted from a request body.
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([status])
  @@index([assignedEmployeeId])
}

/// THE ONE CENTRAL CLIENT RECORD.
model Client {
  id             String @id @default(uuid())
  organisationId String
  /// Human-readable 'CLI-1001'.
  clientCode     String @unique

  companyName   String
  legalName     String?
  businessType  String?
  contactPerson String
  contactNumber String
  email         String?
  address       String?

  gstin String?
  pan   String?
  tan   String?

  accountManagerId String
  assignedTeam     String?
  /// active | onboarding | pending_documents | service_due | inactive
  status           String  @default("onboarding")
  onboardingDate   String
  notes            String?

  /// Back-link to the lead this client came from. @unique mirrors
  /// Lead.convertedClientId so the 1:1 holds from both directions.
  sourceLeadId String? @unique

  /// RESERVED FOR THE CLIENT PORTAL (§56). Modelled, no client-facing screen.
  portalEnabled     Boolean @default(false)
  portalInviteEmail String?

  contacts  ClientContact[]
  services  ClientService[]
  followUps FollowUp[]
  documents ClientDocument[]
  tasks     Task[]
  ewayBills EwayBill[]
  gstProfile GstProfile?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([status])
  @@index([accountManagerId])
}

model ClientContact {
  id           String  @id @default(uuid())
  clientId     String
  name         String
  designation  String?
  phone        String
  email        String?
  isPrimary    Boolean @default(false)

  client Client @relation(fields: [clientId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([clientId])
}

/// A service sold to a client. The join between Client and the catalog.
model ClientService {
  id        String @id @default(uuid())
  clientId  String
  serviceId String

  assignedEmployeeId String
  managerId          String?
  /// 'YYYY-MM-DD' — a calendar date, so it cannot drift across the IST/UTC edge.
  dueDate            String?
  /// not_started | documents_pending | in_progress | under_review | ready |
  /// submitted | completed | failed | on_hold
  status             String  @default("not_started")
  startedAt          DateTime?
  completedAt        DateTime?
  notes              String?

  client  Client  @relation(fields: [clientId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])
  tasks   Task[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([clientId])
  @@index([assignedEmployeeId])
  @@index([status])
}

model Task {
  id              String  @id @default(uuid())
  clientId        String
  clientServiceId String?
  title           String
  description     String?
  assignedEmployeeId String
  dueDate         String?
  /// open | in_progress | blocked | done
  status          String  @default("open")

  client        Client         @relation(fields: [clientId], references: [id])
  clientService ClientService? @relation(fields: [clientServiceId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([clientId])
  @@index([assignedEmployeeId])
}

/// ONE follow-up entity for BOTH leads and clients (§3). Exactly one of
/// leadId / clientId is set; the service layer enforces the XOR on write.
model FollowUp {
  id             String  @id @default(uuid())
  organisationId String
  leadId         String?
  clientId       String?
  clientServiceId String?

  title       String
  /// call | whatsapp | email | meeting | document_request | payment_followup |
  /// service_followup | other
  type        String  @default("call")
  /// A point in time — the follow-up's date AND time.
  scheduledAt DateTime
  assignedEmployeeId String
  /// pending | completed | rescheduled | cancelled | missed
  status      String  @default("pending")
  notes       String?
  reminderMinutesBefore Int?

  completedByEmployeeId String?
  completedAt           DateTime?
  completionNotes       String?

  lead   Lead?   @relation(fields: [leadId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([scheduledAt])
  @@index([assignedEmployeeId, status])
  @@index([clientId])
  @@index([leadId])
}

model DocumentCategory {
  id             String @id @default(uuid())
  organisationId String
  /// gst | it_filing | basic | other
  code           String @unique
  name           String
  description    String?
  sortOrder      Int    @default(0)

  documents ClientDocument[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

/// CLIENT-CENTRIC (§10.7). clientId is REQUIRED; clientServiceId is only a
/// tag. There is deliberately no per-service document store.
///
/// Named ClientDocument rather than §17's bare `Document` because
/// `EmployeeDocument` already exists for HRMS and the two must never be
/// confused at a call site.
model ClientDocument {
  id         String @id @default(uuid())
  clientId   String
  categoryId String
  /// Optional tag only — a document belongs to the CLIENT, not the service.
  clientServiceId String?

  name          String
  financialYear String?
  /// requested | pending | uploaded | under_review | verified | rejected | expired
  status        String  @default("requested")
  /// Points at the highest ClientDocumentVersion.version. 0 = nothing uploaded yet.
  currentVersion Int    @default(0)

  requestedByEmployeeId String?
  requestedAt           DateTime?
  verifiedByEmployeeId  String?
  verifiedAt            DateTime?
  rejectionReason       String?
  expiryDate            String?

  client   Client           @relation(fields: [clientId], references: [id])
  category DocumentCategory @relation(fields: [categoryId], references: [id])
  versions ClientDocumentVersion[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([clientId])
  @@index([categoryId])
  @@index([status])
}

/// Never overwrite (§10.6). An upload appends v1 → v2 → v3, each with its own
/// fileKey and therefore its own signed download URL.
model ClientDocumentVersion {
  id         String @id @default(uuid())
  documentId String
  version    Int
  fileKey    String
  /// An HRMS employee id, or the literal 'portal' when the future Client
  /// Portal delivered it. Seeded both ways so the receiving path is exercised.
  uploadedBy String
  uploadedAt DateTime @default(now())
  sizeBytes  Int      @default(0)
  notes      String?
  previousVersionId String?

  document ClientDocument @relation(fields: [documentId], references: [id])

  createdAt DateTime @default(now())

  @@unique([documentId, version])
  @@index([documentId])
}

model GstProfile {
  id       String @id @default(uuid())
  clientId String @unique
  gstin    String

  /// active | cancelled | suspended | not_registered
  registrationStatus String @default("active")
  /// monthly | quarterly
  filingFrequency    String @default("monthly")
  registrationDate   String?
  assignedEmployeeId String
  /// Mirrors the GST service status values (§7.7).
  serviceStatus      String @default("not_started")
  lastFiledAt        DateTime?
  nextDueDate        String?

  client  Client      @relation(fields: [clientId], references: [id])
  filings GstFiling[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

model GstFiling {
  id           String @id @default(uuid())
  gstProfileId String
  /// 'YYYY-MM' — the return period, e.g. '2026-08'.
  period       String
  /// GSTR-1 | GSTR-3B | GSTR-9
  returnType   String
  /// not_started | documents_pending | data_preparation | under_review |
  /// ready_to_file | filed | failed | completed
  status       String @default("not_started")
  filedAt      DateTime?
  dueDate      String?
  assignedEmployeeId String
  arn          String?
  remarks      String?

  gstProfile GstProfile @relation(fields: [gstProfileId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([gstProfileId, period, returnType])
  @@index([status])
}

/// SIMULATED (§7.3 / §15). `isSimulated` defaults true and every response and
/// screen says so. Audit OS has no government e-way bill connectivity.
model EwayBill {
  id       String @id @default(uuid())
  clientId String
  ewbNo    String @unique

  documentNo   String
  documentDate String
  fromGstin    String?
  toGstin      String?
  toPartyName  String?
  valuePaise   Int    @default(0)
  /// generated | active | cancelled | expired
  status       String @default("generated")
  generatedAt  DateTime @default(now())
  validUntil   String?
  cancelledAt  DateTime?
  cancelReason String?
  generatedByEmployeeId String
  isSimulated  Boolean @default(true)

  client Client @relation(fields: [clientId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([clientId])
}

/// The user-visible timeline (§11) — distinct from AuditLog, which is the
/// security trail. Append-only, so no deletedAt, like AuditLog.
model Activity {
  id             String @id @default(uuid())
  organisationId String
  /// lead | client
  subjectType    String
  subjectId      String

  /// 'lead.created', 'lead.status_changed', 'client.service_assigned', …
  action      String
  description String
  actorUserId String?
  actorEmployeeId String?
  entityType  String?
  entityId    String?
  metaJson    String?

  createdAt DateTime @default(now())

  @@index([subjectType, subjectId, createdAt])
}

// ============================================================
// TOOLS MODULE (Converters & Utilities)
// ============================================================
//
// One document model for every tool — no per-tool tables. The registry that
// drives the Tools page lives in code (src/modules/tools/registry.ts on both
// sides); these three catalogue tables are synced FROM it by the seed so a
// job row can reference a stable tool id and reporting can join on it.

model ToolCategory {
  id     String @id
  key    String @unique
  label  String
  order  Int
  /// active | coming_soon
  status String @default("active")

  groups ToolGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ToolGroup {
  id         String @id
  key        String @unique
  label      String
  categoryId String
  order      Int

  category ToolCategory @relation(fields: [categoryId], references: [id])
  tools    Tool[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tool {
  id            String @id
  key           String @unique
  name          String
  description   String
  groupId       String
  /// pdf | xlsx | docx | csv | txt | zip
  outputType    String
  permissionKey String
  /// active | coming_soon
  status        String @default("active")

  group ToolGroup @relation(fields: [groupId], references: [id])
  jobs  ToolJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A file the Tools module holds: either something a user uploaded as input
/// (`kind = input`) or something a tool generated (`kind = output`).
model ToolDocument {
  id               String  @id @default(uuid())
  organisationId   String
  userId           String
  /// input | output
  kind             String  @default("output")
  originalFilename String
  storedFilename   String
  mimeType         String
  fileSize         Int
  /// Key understood by the StorageAdapter — never a client-supplied path.
  storagePath      String
  /// Registry tool id that produced this document (null for raw uploads).
  sourceTool       String?
  parentDocumentId String?
  /// processing | completed | failed
  status           String  @default("completed")
  errorMessage     String?
  /// Free-form JSON — page count, table count, OCR confidence, signer info…
  metaJson         String?

  organisation Organisation @relation(fields: [organisationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  versions     ToolDocumentVersion[]
  inputJobs    ToolJob[]    @relation("ToolJobInput")
  outputJobs   ToolJob[]    @relation("ToolJobOutput")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organisationId, userId])
  @@index([sourceTool])
  @@index([status])
  @@index([createdAt])
}

model ToolDocumentVersion {
  id          String @id @default(uuid())
  documentId  String
  version     Int
  storagePath String
  fileSize    Int

  document ToolDocument @relation(fields: [documentId], references: [id])

  createdAt DateTime @default(now())

  @@unique([documentId, version])
}

/// Every tool run — queued, processing, completed or failed — is one row here,
/// so the Documents detail drawer can show timing and the outcome uniformly.
model ToolJob {
  id               String  @id @default(uuid())
  toolId           String
  userId           String
  organisationId   String
  inputDocumentId  String?
  outputDocumentId String?
  /// queued | processing | completed | failed
  status           String  @default("queued")
  /// 0–100, reported by the service where it can be determinate.
  progress         Int     @default(0)
  errorMessage     String?
  /// Tool options + per-run facts (all input ids, page counts, warnings…).
  metaJson         String?
  startedAt        DateTime?
  completedAt      DateTime?

  tool           Tool          @relation(fields: [toolId], references: [id])
  user           User          @relation(fields: [userId], references: [id])
  organisation   Organisation  @relation(fields: [organisationId], references: [id])
  inputDocument  ToolDocument? @relation("ToolJobInput", fields: [inputDocumentId], references: [id])
  outputDocument ToolDocument? @relation("ToolJobOutput", fields: [outputDocumentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId, userId])
  @@index([toolId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// BOOKS — native bookkeeping (docs/accounting-module/README.md)
// ============================================================
//
// One BooksOrganisation per end client of the firm. Every table below carries
// booksOrgId and every read folds it into the where clause. Money is BigInt
// minor units (paise); a foreign-currency line stores both the transaction
// amount (fxAmount, fxCurrency) and the base amount (amount) with the rate.
//
// The ONE writer of financial state is BooksJournal + BooksJournalLine, via
// engine/posting.ts. Invoices, bills, payments, credit notes and transfers are
// wrappers that produce journals. Triggers in prisma/sql/books-invariants.*
// make an unbalanced posted journal, an edit to a posted journal, or an
// edit/delete of an audit event impossible at the database.

model BooksOrganisation {
  id             String  @id @default(uuid())
  organisationId String
  /// Optional link to the Workstation client this set of books belongs to.
  clientId       String?
  name           String
  legalName      String?
  gstin          String?
  pan            String?
  /// Two-letter GST state code, e.g. '33' for Tamil Nadu — place-of-supply anchor.
  stateCode      String?
  stateName      String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  pincode        String?
  baseCurrency   String  @default("INR")
  fiscalYearStartMonth Int @default(4)
  /// Enable TDS deduction on purchases.
  tdsEnabled     Boolean @default(true)
  isActive       Boolean @default(true)

  memberships BooksMembership[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([organisationId])
  @@index([clientId])
}

/// Firm staff assigned to a set of books. role: admin | staff | viewer.
model BooksMembership {
  id         String @id @default(uuid())
  booksOrgId String
  userId     String
  role       String @default("staff")

  booksOrg BooksOrganisation @relation(fields: [booksOrgId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?

  @@unique([booksOrgId, userId])
  @@index([userId])
}

/// Account groups. rootCategory: asset | liability | equity | income | expense.
/// tallyGroup mirrors Tally's primary group names for a later export.
model BooksAccountGroup {
  id            String  @id @default(uuid())
  booksOrgId    String
  name          String
  rootCategory  String
  tallyGroup    String
  parentGroupId String?
  isSystem      Boolean @default(false)
  sortOrder     Int     @default(0)

  ledgers BooksLedger[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([booksOrgId, name])
  @@index([booksOrgId, rootCategory])
}

/// A ledger account. systemKey names the accounts the engine posts to
/// (accounts_receivable, cgst_output, round_off, …) so posting never
/// depends on a user-editable name.
model BooksLedger {
  id                 String  @id @default(uuid())
  booksOrgId         String
  groupId            String
  name               String
  alias              String?
  code               String?
  rootCategory       String
  tallyGroup         String
  systemKey          String?
  /// Party ledgers point at their contact.
  contactId          String?
  openingBalance     BigInt  @default(0)
  /// debit | credit
  openingBalanceType String  @default("debit")
  openingDate        String?
  currency           String  @default("INR")
  billWise           Boolean @default(false)
  gstin              String?
  stateCode          String?
  /// TDS nature of payment / section for expense ledgers, e.g. '194C'.
  tdsSection         String?
  bankName           String?
  bankAccountNo      String?
  bankIfsc           String?
  isBank             Boolean @default(false)
  isCash             Boolean @default(false)
  isSystem           Boolean @default(false)
  isActive           Boolean @default(true)
  description        String?

  group BooksAccountGroup @relation(fields: [groupId], references: [id])
  lines BooksJournalLine[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([booksOrgId, name])
  @@index([booksOrgId, systemKey])
  @@index([booksOrgId, rootCategory])
  @@index([contactId])
}

/// THE financial record. status: draft | posted | void.
/// voucherType: journal | opening | invoice | credit_note | payment_in |
///   bill | vendor_credit | payment_out | transfer | revaluation | retainer_apply
model BooksJournal {
  id            String  @id @default(uuid())
  booksOrgId    String
  date          String  // 'YYYY-MM-DD'
  number        String
  voucherType   String
  sourceModule  String?
  sourceId      String?
  narration     String?
  status        String  @default("draft")
  /// Set on the reversing journal that voids another.
  reversesJournalId String?
  /// Set on a voided journal, pointing at its reversal.
  voidedByJournalId String?
  currency      String  @default("INR")
  exchangeRate  Float   @default(1)
  totalDebit    BigInt  @default(0)
  totalCredit   BigInt  @default(0)
  postedAt      DateTime?
  postedBy      String?

  lines       BooksJournalLine[]
  allocations BooksBillAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@unique([booksOrgId, number])
  @@index([booksOrgId, date])
  @@index([booksOrgId, status])
  @@index([sourceModule, sourceId])
}

model BooksJournalLine {
  id            String  @id @default(uuid())
  journalId     String
  booksOrgId    String
  lineNo        Int
  ledgerId      String
  /// debit | credit
  side          String
  /// Base-currency minor units, always positive.
  amount        BigInt
  fxCurrency    String  @default("INR")
  fxAmount      BigInt
  exchangeRate  Float   @default(1)
  partyLedgerId String?
  taxRateId     String?
  description   String?
  /// Bank reconciliation: statement line this entry was matched to.
  reconciledStatementLineId String?
  reconciledAt  DateTime?

  journal BooksJournal @relation(fields: [journalId], references: [id])
  ledger  BooksLedger  @relation(fields: [ledgerId], references: [id])

  @@index([booksOrgId, ledgerId])
  @@index([journalId])
}

/// An open item on a bill-wise ledger: one per invoice / bill / advance.
/// side: debit (receivable) | credit (payable). balance falls as allocations
/// are posted; status closes at zero.
model BooksBill {
  id          String  @id @default(uuid())
  booksOrgId  String
  ledgerId    String
  contactId   String?
  billNo      String
  /// new_ref | advance | on_account
  billType    String  @default("new_ref")
  sourceType  String
  sourceId    String
  date        String
  dueDate     String?
  side        String
  currency    String  @default("INR")
  fxAmount    BigInt
  amount      BigInt
  fxBalance   BigInt
  balance     BigInt
  status      String  @default("open")

  allocations BooksBillAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([booksOrgId, sourceType, sourceId])
  @@index([booksOrgId, ledgerId, status])
  @@index([contactId])
}

/// A journal's effect on an open item. type: new_ref | against_ref | advance | on_account.
model BooksBillAllocation {
  id         String @id @default(uuid())
  booksOrgId String
  journalId  String
  billId     String
  type       String
  currency   String @default("INR")
  fxAmount   BigInt
  amount     BigInt

  journal BooksJournal @relation(fields: [journalId], references: [id])
  bill    BooksBill    @relation(fields: [billId], references: [id])

  createdAt DateTime @default(now())

  @@index([booksOrgId, billId])
  @@index([journalId])
}

/// customer | vendor | both. gstTreatment: business_gst | business_none | overseas | consumer.
model BooksContact {
  id                 String  @id @default(uuid())
  booksOrgId         String
  type               String
  displayName        String
  companyName        String?
  email              String?
  phone              String?
  gstin              String?
  gstTreatment       String  @default("business_gst")
  pan                String?
  placeOfSupplyState String?
  currency           String  @default("INR")
  paymentTermsDays   Int     @default(30)
  creditLimit        BigInt  @default(0)
  /// TDS section applied to this vendor's bills, e.g. '194J'.
  tdsSection         String?
  receivableLedgerId String?
  payableLedgerId    String?
  notes              String?
  isActive           Boolean @default(true)

  persons   BooksContactPerson[]
  addresses BooksAddress[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([booksOrgId, type])
  @@index([booksOrgId, displayName])
}

model BooksContactPerson {
  id        String  @id @default(uuid())
  contactId String
  name      String
  email     String?
  phone     String?
  designation String?
  isPrimary Boolean @default(false)

  contact BooksContact @relation(fields: [contactId], references: [id])

  @@index([contactId])
}

/// kind: billing | shipping
model BooksAddress {
  id        String  @id @default(uuid())
  contactId String
  kind      String
  line1     String?
  line2     String?
  city      String?
  stateCode String?
  stateName String?
  pincode   String?
  country   String  @default("IN")

  contact BooksContact @relation(fields: [contactId], references: [id])

  @@index([contactId])
}

/// itemType: inventory | sales | purchases | sales_and_purchases; productType: goods | service
model BooksItem {
  id                String  @id @default(uuid())
  booksOrgId        String
  name              String
  sku               String?
  unit              String  @default("nos")
  itemType          String  @default("sales_and_purchases")
  productType       String  @default("service")
  sellRate          BigInt  @default(0)
  purchaseRate      BigInt  @default(0)
  taxRateId         String?
  hsnSac            String?
  salesLedgerId     String?
  purchaseLedgerId  String?
  description       String?
  isActive          Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([booksOrgId, name])
}

/// type: gst | tds | tcs | other. percentage in basis points (1800 = 18%).
model BooksTaxRate {
  id          String  @id @default(uuid())
  booksOrgId  String
  name        String
  type        String
  percentageBp Int
  /// For TDS: the flat rate when the vendor has no PAN (bp).
  noPanPercentageBp Int?
  /// TDS/TCS section code, e.g. '194C'.
  section     String?
  isCompound  Boolean @default(false)
  isActive    Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([booksOrgId, name])
  @@index([booksOrgId, type])
}

/// One table for every transaction document.
/// kind: estimate | sales_order | invoice | retainer_invoice | credit_note |
///       purchase_order | bill | vendor_credit
/// status: draft | sent | accepted | declined | posted | partially_paid | paid |
///         closed | void | expired
model BooksDocument {
  id             String  @id @default(uuid())
  booksOrgId     String
  kind           String
  number         String
  contactId      String
  date           String
  dueDate        String?
  expiryDate     String?
  referenceNo    String?
  status         String  @default("draft")
  currency       String  @default("INR")
  exchangeRate   Float   @default(1)
  placeOfSupply  String?
  isInterState   Boolean @default(false)
  taxInclusive   Boolean @default(false)
  /// Document-level discount, applied before tax. bp of subtotal or a fixed amount.
  discountPercentBp Int   @default(0)
  discountAmount BigInt  @default(0)
  subtotal       BigInt  @default(0)
  discountTotal  BigInt  @default(0)
  taxableTotal   BigInt  @default(0)
  cgstTotal      BigInt  @default(0)
  sgstTotal      BigInt  @default(0)
  igstTotal      BigInt  @default(0)
  taxTotal       BigInt  @default(0)
  tdsRateId      String?
  tdsTotal       BigInt  @default(0)
  roundOff       BigInt  @default(0)
  total          BigInt  @default(0)
  /// Base-currency total (== total when currency is the base).
  baseTotal      BigInt  @default(0)
  balanceDue     BigInt  @default(0)
  /// Remaining unapplied credit on a credit note / vendor credit.
  creditsRemaining BigInt @default(0)
  journalId      String?
  /// The document this one was created from (SO → invoice, PO → bill, …).
  sourceDocumentId String?
  recurringProfileId String?
  notes          String?
  terms          String?
  voidReason     String?

  lines BooksDocumentLine[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?

  @@unique([booksOrgId, kind, number])
  @@index([booksOrgId, kind, status])
  @@index([booksOrgId, contactId])
  @@index([booksOrgId, date])
}

model BooksDocumentLine {
  id           String  @id @default(uuid())
  documentId   String
  booksOrgId   String
  lineNo       Int
  itemId       String?
  description  String
  hsnSac       String?
  quantity     Float   @default(1)
  /// Unit rate in transaction-currency minor units.
  rate         BigInt
  discountPercentBp Int @default(0)
  discountAmount BigInt @default(0)
  taxRateId    String?
  taxPercentBp Int     @default(0)
  taxable      BigInt  @default(0)
  cgst         BigInt  @default(0)
  sgst         BigInt  @default(0)
  igst         BigInt  @default(0)
  tax          BigInt  @default(0)
  lineTotal    BigInt  @default(0)
  /// Income / expense / asset ledger this line posts to.
  ledgerId     String

  document BooksDocument @relation(fields: [documentId], references: [id])

  @@index([documentId])
}

/// kind: invoice | bill. frequency: weekly | monthly | quarterly | yearly.
model BooksRecurringProfile {
  id           String  @id @default(uuid())
  booksOrgId   String
  kind         String
  name         String
  contactId    String
  frequency    String
  startDate    String
  endDate      String?
  nextRunDate  String
  lastRunDate  String?
  /// Serialised document input (lines, terms, currency …) used for each run.
  templateJson String
  status       String  @default("active")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?

  @@index([booksOrgId, status, nextRunDate])
}

/// kind: received | made. Allocations live on the journal (BooksBillAllocation).
model BooksPayment {
  id              String  @id @default(uuid())
  booksOrgId      String
  kind            String
  number          String
  contactId       String
  date            String
  currency        String  @default("INR")
  exchangeRate    Float   @default(1)
  fxAmount        BigInt
  amount          BigInt
  depositLedgerId String
  bankCharges     BigInt  @default(0)
  tdsAmount       BigInt  @default(0)
  mode            String  @default("bank_transfer")
  reference       String?
  notes           String?
  journalId       String?
  status          String  @default("posted")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@unique([booksOrgId, kind, number])
  @@index([booksOrgId, contactId])
}

model BooksBankTransfer {
  id           String @id @default(uuid())
  booksOrgId   String
  date         String
  number       String
  fromLedgerId String
  toLedgerId   String
  amount       BigInt
  reference    String?
  notes        String?
  journalId    String?
  status       String @default("posted")

  createdAt DateTime @default(now())
  createdBy String?

  @@unique([booksOrgId, number])
}

/// A manually entered bank statement line, matched to a journal line.
model BooksBankStatementLine {
  id          String  @id @default(uuid())
  booksOrgId  String
  ledgerId    String
  date        String
  description String
  /// Signed minor units: positive = money in.
  amount      BigInt
  reference   String?
  matchedJournalLineId String?
  matchedAt   DateTime?

  createdAt DateTime @default(now())
  createdBy String?

  @@index([booksOrgId, ledgerId, date])
}

model BooksExchangeRate {
  id         String @id @default(uuid())
  booksOrgId String
  currency   String
  date       String
  rate       Float

  createdAt DateTime @default(now())

  @@unique([booksOrgId, currency, date])
}

model BooksRevaluation {
  id         String @id @default(uuid())
  booksOrgId String
  date       String
  currency   String
  rate       Float
  /// Signed base-currency delta booked to the FX gain/loss ledger.
  delta      BigInt
  journalId  String?
  detailJson String

  createdAt DateTime @default(now())
  createdBy String?

  @@index([booksOrgId, date])
}

model BooksNumberSequence {
  id         String @id @default(uuid())
  booksOrgId String
  kind       String
  prefix     String
  next       Int    @default(1)

  @@unique([booksOrgId, kind])
}

/// Append-only. Triggers forbid UPDATE and DELETE.
model BooksAuditEvent {
  id          String  @id @default(uuid())
  booksOrgId  String
  actorUserId String?
  entityType  String
  entityId    String
  action      String
  beforeJson  String?
  afterJson   String?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([booksOrgId, entityType, entityId])
  @@index([booksOrgId, createdAt])
}
