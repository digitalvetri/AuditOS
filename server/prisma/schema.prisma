// AUDIT OS · HRMS — unified Prisma schema (Part 1 core-HR + Part 2 modules).
//
// ONE MODEL, ONE SOURCE OF TRUTH. There is exactly one User, one Employee,
// one Role, one ExpenseCategory and one payroll model in this file. Where
// Part 1 and Part 2 both described an entity, the Part 1 domain shape wins
// (it is the shape the shipped React frontend consumes) and the useful Part 2
// additions are folded into it.
//
// NAMING: columns are camelCase (Prisma convention). The HTTP API speaks
// snake_case (Part 1 §9/§10). The translation happens in exactly one place —
// src/api/serialize.ts — never inside a route handler or a React component.
//
// MONEY: every monetary column is an integer number of PAISE. No floats.
//
// DATES: a calendar date that must stay IST-stable (attendance date, leave
// range, effective-from, expiry) is stored as an ISO 'YYYY-MM-DD' STRING.
// A point in time is a DateTime stored in UTC. Storing calendar dates as
// DateTime is what makes attendance rows land on the wrong day across the
// IST/UTC boundary, so we do not do it.
//
// SOFT DELETE: every mutable table carries deletedAt; reads filter it out.
// AuditLog and LedgerTransaction are append-only and carry no deletedAt.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // PostgreSQL running in Docker (see docker-compose.yml at repo root).
  // The invariants layer (src/modules/books/db/invariants.ts) already
  // detects the active provider and loads the matching SQL file.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// PLATFORM PRIMITIVES
// ============================================================

model Organisation {
  id                   String @id @default(uuid())
  name                 String
  timezone             String @default("Asia/Kolkata")
  currency             String @default("INR")
  fiscalYearStartMonth Int    @default(4)

  departments       Department[]
  designations      Designation[]
  workLocations     WorkLocation[]
  workSchedules     WorkSchedule[]
  holidays          Holiday[]
  employees         Employee[]
  users             User[]
  leaveTypes        LeaveType[]
  expenseCategories ExpenseCategory[]
  statutoryRates    StatutoryRate[]
  payrollRuns       PayrollRun[]
  chats             Chat[]
  toolDocuments     ToolDocument[]
  toolJobs          ToolJob[]
  aaBankAccounts    AaBankAccount[]
  aaSourceDocuments AaSourceDocument[]
  aaJobs            AaJob[]
  aaGstFilings2B    AaGstFiling2B[]
  aaPurchaseRegisters AaPurchaseRegister[]
  aaGstReconJobs    AaGstReconJob[]
  aaTds26AS         AaTds26AS[]
  aaTdsBooks        AaTdsBooks[]
  aaTdsReconJobs    AaTdsReconJob[]
  tallyCompanies    TallyCompany[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

model Role {
  id          String  @id @default(uuid())
  // employee | dept_manager | hr_admin | finance_admin | md
  code        String  @unique
  name        String
  description String?

  permissions RolePermission[]
  users       User[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

model Permission {
  id          String @id @default(uuid())
  // '<module>.<action>[.<qualifier>]' — see src/platform/rbac/matrix.ts
  code        String @unique
  description String

  roles RolePermission[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String
  // self | department | organisation — a grant is (permission, scope).
  scope        String @default("self")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model User {
  id             String    @id @default(uuid())
  organisationId String
  email          String    @unique
  passwordHash   String
  roleId         String
  // Nullable BOTH ways (Part 1 §4.2): automation users have no employee, and
  // an employee (e.g. an exited one) may have no login.
  employeeId     String?   @unique
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])
  employee     Employee?    @relation(fields: [employeeId], references: [id])

  notifications       Notification[]
  auditLogs           AuditLog[]
  toolDocuments       ToolDocument[]
  toolJobs            ToolJob[]
  aaSourceDocuments   AaSourceDocument[]
  aaJobs              AaJob[]
  aaGstFilings2B      AaGstFiling2B[]
  aaPurchaseRegisters AaPurchaseRegister[]
  aaGstReconJobs      AaGstReconJob[]
  aaTds26AS           AaTds26AS[]
  aaTdsBooks          AaTdsBooks[]
  aaTdsReconJobs      AaTdsReconJob[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

// ============================================================
// CONFIGURATION (Settings §8.11)
// ============================================================

model Department {
  id             String @id @default(uuid())
  organisationId String
  name           String
  code           String @unique

  organisation Organisation @relation(fields: [organisationId], references: [id])
  employees    Employee[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

model Designation {
  id             String @id @default(uuid())
  organisationId String
  name           String

  organisation Organisation @relation(fields: [organisationId], references: [id])
  employees    Employee[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

model WorkLocation {
  id             String  @id @default(uuid())
  organisationId String
  name           String
  address        String  @default("")
  latitude       Float
  longitude      Float
  radiusM        Int     @default(150)
  isActive       Boolean @default(true)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  employees    Employee[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

model WorkSchedule {
  id                   String  @id @default(uuid())
  organisationId       String
  name                 String
  standardStart        String // 'HH:mm'
  standardEnd          String // 'HH:mm'
  fullDayHours         Float   @default(8)
  halfDayHours         Float   @default(4)
  breakMinutes         Int     @default(60)
  // JSON array of ISO weekday numbers 1..7 (SQLite has no native Json column).
  workingDaysJson      String  @default("[1,2,3,4,5]")
  alternateSaturdayOff Boolean @default(false)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  employees    Employee[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

model Holiday {
  id             String  @id @default(uuid())
  organisationId String
  date           String // 'YYYY-MM-DD'
  name           String
  isOptional     Boolean @default(false)

  organisation Organisation @relation(fields: [organisationId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([date])
}

model LeaveType {
  id                    String  @id @default(uuid())
  organisationId        String
  // casual | sick | earned | lop | comp_off
  code                  String
  name                  String
  // null = unlimited (Loss of Pay)
  annualEntitlement     Float?
  accrual               String  @default("monthly") // monthly | earned
  carryForwardMax       Float   @default(0)
  halfDayAllowed        Boolean @default(false)
  minNoticeDays         Int     @default(0)
  accrueDuringProbation Boolean @default(true)

  organisation Organisation   @relation(fields: [organisationId], references: [id])
  balances     LeaveBalance[]
  requests     LeaveRequest[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([organisationId, code])
}

model ExpenseCategory {
  id              String  @id @default(uuid())
  organisationId  String
  name            String
  code            String  @unique
  isActive        Boolean @default(true)
  requiresReceipt Boolean @default(true)
  glAccount       String?

  organisation Organisation @relation(fields: [organisationId], references: [id])
  expenses     Expense[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

// Statutory configuration is DATA, never a literal in code. A row is
// (code, effectiveFrom, effectiveTo); payroll resolves the row effective on
// the period start and snapshots it onto the run.
model StatutoryRate {
  id             String  @id @default(uuid())
  organisationId String
  // 'pf.employee_rate' | 'pf.wage_ceiling' | 'esi.gross_threshold' | 'pt.tn.slab' | …
  code           String
  // Stored as a string; the caller parses (rate, ceiling, or a slab JSON array).
  value          String
  effectiveFrom  String // 'YYYY-MM-DD'
  effectiveTo    String? // 'YYYY-MM-DD'
  notes          String?

  organisation Organisation @relation(fields: [organisationId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([code, effectiveFrom])
}

// ============================================================
// CORE HR
// ============================================================

model Employee {
  id             String @id @default(uuid())
  organisationId String
  employeeCode   String @unique
  firstName      String
  lastName       String
  fullName       String
  // partner | manager | executive | articled | support
  type           String @default("executive")
  // active | on_leave | probation | notice_period | inactive
  status         String @default("active")

  designationId  String
  departmentId   String
  managerId      String? // self-referential, nullable
  workLocationId String
  workScheduleId String

  email            String  @unique
  phone            String  @default("")
  joiningDate      String // 'YYYY-MM-DD'
  exitDate         String?
  exitReason       String?
  noticePeriodDays Int     @default(30)

  // RESERVED FOR WORKSTATION — nullable from day one, no UI in this phase.
  weeklyCapacityHours Float?

  photoUrl              String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  bankAccountMasked     String?

  organisation Organisation @relation(fields: [organisationId], references: [id])
  department   Department   @relation(fields: [departmentId], references: [id])
  designation  Designation  @relation(fields: [designationId], references: [id])
  workLocation WorkLocation @relation(fields: [workLocationId], references: [id])
  workSchedule WorkSchedule @relation(fields: [workScheduleId], references: [id])
  manager      Employee?    @relation("EmployeeManager", fields: [managerId], references: [id])
  reports      Employee[]   @relation("EmployeeManager")

  user               User?
  training           ArticledTraining?      @relation("TrainingSubject")
  principalTrainings ArticledTraining[]     @relation("TrainingPrincipal")
  attendance         Attendance[]
  corrections        AttendanceCorrection[]
  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]
  documents          EmployeeDocument[]
  salaryStructures   SalaryStructure[]
  payrollItems       PayrollItem[]
  payslips           Payslip[]
  expenses           Expense[]
  payments           Payment[]
  ledgerEntries      LedgerTransaction[]
  chatMemberships    ChatMember[]
  chatMessages       ChatMessage[]
  messageReads       MessageRead[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([departmentId])
  @@index([managerId])
}

model ArticledTraining {
  id                  String @id @default(uuid())
  employeeId          String @unique
  icaiRegistrationNo  String
  principalEmployeeId String
  trainingStart       String
  trainingEnd         String
  currentYear         Int    @default(1)
  stipendSlab         String @default("")
  // active | transferred | completed | terminated
  status              String @default("active")

  employee  Employee @relation("TrainingSubject", fields: [employeeId], references: [id])
  principal Employee @relation("TrainingPrincipal", fields: [principalEmployeeId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

model EmployeeDocument {
  id         String   @id @default(uuid())
  employeeId String
  name       String
  // employment | joining | certificate | hr | tax | bank | company_issued | icai
  type       String
  fileKey    String
  uploadedBy String
  uploadedAt DateTime @default(now())
  expiryDate String?
  // valid | expiring_soon | expired | pending_verification (derived on read
  // from expiryDate, except the sticky pending_verification state)
  status     String   @default("valid")

  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([employeeId])
}

// ============================================================
// ATTENDANCE (§8.2)
// ============================================================

model Attendance {
  id         String @id @default(uuid())
  employeeId String
  date       String // 'YYYY-MM-DD' IST calendar date

  checkInAt  DateTime?
  checkOutAt DateTime?

  checkInLat        Float?
  checkInLong       Float?
  checkInAccuracyM  Float?
  checkOutLat       Float?
  checkOutLong      Float?
  checkOutAccuracyM Float?

  checkInLocationId  String?
  checkOutLocationId String?
  // office | client_site | remote | field
  locationType       String?
  offSiteReason      String?

  workedMinutes    Int?
  breakMinutes     Int?
  // present | late | absent | half_day | wfh | on_leave | missing_check_in | missing_check_out
  status           String
  // web_geo | biometric | manual
  source           String  @default("web_geo")
  // none | requested | approved | rejected
  correctionStatus String  @default("none")
  device           String?
  ip               String?

  // RESERVED FOR WORKSTATION — no FK, there is no Client table yet.
  clientId String?

  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([employeeId, date])
  @@index([date])
}

model AttendanceCorrection {
  id                  String    @id @default(uuid())
  attendanceId        String? // null when the correction creates a new day
  employeeId          String
  date                String
  requestedCheckInAt  DateTime?
  requestedCheckOutAt DateTime?
  reason              String
  attachmentUrl       String?
  // pending | approved | rejected
  status              String    @default("pending")
  reviewedBy          String?
  reviewedAt          DateTime?
  reviewNotes         String?

  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([employeeId, status])
}

// ============================================================
// LEAVE (§8.3)
// ============================================================

model LeaveBalance {
  id              String @id @default(uuid())
  employeeId      String
  leaveTypeId     String
  fiscalYearStart String // 'YYYY-04-01'
  entitled        Float  @default(0)
  availed         Float  @default(0)
  carriedForward  Float  @default(0)

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, leaveTypeId, fiscalYearStart])
}

model LeaveRequest {
  id                  String    @id @default(uuid())
  employeeId          String
  leaveTypeId         String
  startDate           String
  endDate             String
  halfDay             Boolean   @default(false)
  // Server-authoritative: the sandwich rule is applied at write time.
  computedWorkingDays Float
  reason              String
  attachmentUrl       String?
  // pending | approved | rejected | cancelled
  status              String    @default("pending")
  approverId          String? // manager who approved (stage 1)
  hrApproverId        String? // HR who approved (stage 2, > 5 days)
  approvedAt          DateTime?
  rejectionReason     String?

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([employeeId, startDate])
  @@index([status])
}

// ============================================================
// PAYROLL (§8.4)
// ============================================================

model SalaryStructure {
  id                    String  @id @default(uuid())
  employeeId            String
  effectiveFrom         String
  effectiveTo           String? // null = currently effective
  monthlyCtcPaise       Int     @default(0)
  basicPaise            Int     @default(0)
  hraPaise              Int     @default(0)
  conveyancePaise       Int     @default(0)
  specialAllowancePaise Int     @default(0)
  // JSON array of { code, label, amount_paise, kind: 'earning' | 'deduction' }
  customComponentsJson  String  @default("[]")
  notes                 String?

  employee     Employee      @relation(fields: [employeeId], references: [id])
  payrollItems PayrollItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([employeeId, effectiveFrom])
}

model PayrollRun {
  id                    String  @id @default(uuid())
  organisationId        String
  periodStart           String
  periodEnd             String
  // draft → hr_review → finance_review → approved → processed
  stage                 String  @default("draft")
  isCalculating         Boolean @default(false)
  // Snapshot of the StatutoryRate table at calculate time. A rate change
  // afterwards must NOT alter a processed run's numbers.
  statutorySnapshotJson String?

  headcount            Int @default(0)
  grossTotalPaise      Int @default(0)
  deductionsTotalPaise Int @default(0)
  netTotalPaise        Int @default(0)

  reviewedBy  String?
  approvedBy  String?
  processedBy String?
  processedAt DateTime?
  notes       String?

  organisation Organisation  @relation(fields: [organisationId], references: [id])
  items        PayrollItem[]
  payslips     Payslip[]
  payments     Payment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([periodStart, periodEnd])
}

model PayrollItem {
  id                String @id @default(uuid())
  payrollRunId      String
  employeeId        String
  salaryStructureId String

  payableDays Float
  presentDays Float
  onLeaveDays Float
  absentDays  Float
  lopDays     Float

  // "Show the working": full component-by-component breakdown, in the exact
  // PayrollEarnings / PayrollDeductions shape the payslip renders.
  earningsJson   String
  deductionsJson String

  grossPaise           Int
  totalDeductionsPaise Int
  netPaise             Int
  gratuityAccrualPaise Int     @default(0)
  notes                String?

  payrollRun      PayrollRun      @relation(fields: [payrollRunId], references: [id])
  employee        Employee        @relation(fields: [employeeId], references: [id])
  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id])
  payslip         Payslip?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
}

model Payslip {
  id            String   @id @default(uuid())
  payrollRunId  String
  payrollItemId String   @unique
  employeeId    String
  payslipNo     String   @unique
  publishedAt   DateTime
  fileKey       String
  // published | revoked
  status        String   @default("published")

  payrollRun  PayrollRun  @relation(fields: [payrollRunId], references: [id])
  payrollItem PayrollItem @relation(fields: [payrollItemId], references: [id])
  employee    Employee    @relation(fields: [employeeId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([employeeId])
}

// ============================================================
// EXPENSES (§8.5)
// ============================================================

model Expense {
  id             String  @id @default(uuid())
  expenseNo      String  @unique
  employeeId     String
  categoryId     String
  title          String
  amountPaise    Int
  expenseDate    String
  description    String  @default("")
  // cash | card | upi | bank_transfer | other
  paymentMethod  String  @default("card")
  receiptFileKey String?
  notes          String?
  // draft → pending_manager → pending_finance → approved → paid | rejected
  stage          String  @default("draft")

  submittedAt       DateTime?
  managerApprovedBy String?
  managerApprovedAt DateTime?
  financeApprovedBy String?
  financeApprovedAt DateTime?
  paidAt            DateTime?
  paymentId         String?
  rejectionReason   String?
  rejectedBy        String?
  rejectedAt        DateTime?

  // RESERVED FOR WORKSTATION — nullable, no UI, no FK.
  clientId String?

  employee  Employee          @relation(fields: [employeeId], references: [id])
  category  ExpenseCategory   @relation(fields: [categoryId], references: [id])
  approvals ExpenseApproval[]
  payments  Payment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([employeeId, stage])
  @@index([stage])
}

/// Append-only stage-transition trail. No update, no delete.
model ExpenseApproval {
  id          String  @id @default(uuid())
  expenseId   String
  actorUserId String
  fromStage   String
  toStage     String
  notes       String?

  expense Expense @relation(fields: [expenseId], references: [id])

  createdAt DateTime @default(now())

  @@index([expenseId])
}

// ============================================================
// ACCOUNTS & PAYMENTS (§8.6)
// ============================================================

model Payment {
  id           String    @id @default(uuid())
  paymentNo    String    @unique
  employeeId   String
  payrollRunId String?
  expenseId    String?
  amountPaise  Int
  // bank_transfer | cash | cheque | mock
  method       String    @default("mock")
  reference    String    @unique
  // pending | processing | completed | failed
  status       String    @default("pending")
  paidAt       DateTime?

  employee      Employee            @relation(fields: [employeeId], references: [id])
  payrollRun    PayrollRun?         @relation(fields: [payrollRunId], references: [id])
  expense       Expense?            @relation(fields: [expenseId], references: [id])
  ledgerEntries LedgerTransaction[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([employeeId, status])
}

/// APPEND-ONLY. There is no update and no delete path to this table anywhere
/// in the application — a correction is a contra entry that points back at the
/// row it reverses via reversesId. `namespace` is the hard boundary that keeps
/// client accounting out of Audit OS's own books (§8.6).
model LedgerTransaction {
  id                  String  @id @default(uuid())
  transactionRef      String  @unique
  namespace           String  @default("INTERNAL")
  // Monotonic, assigned inside the posting transaction.
  sequence            Int     @unique
  date                String
  // Payroll | Expense Reimbursement | Office Expense | Employee Advance |
  // Advance Recovery | Payment
  type                String
  description         String
  employeeId          String?
  category            String?
  debitPaise          Int     @default(0)
  creditPaise         Int     @default(0)
  runningBalancePaise Int
  referenceId         String
  referenceType       String
  // posted | reversed  (`reversed` means "a contra entry exists for me")
  status              String  @default("posted")

  paymentId  String?
  reversesId String?

  employee Employee? @relation(fields: [employeeId], references: [id])
  payment  Payment?  @relation(fields: [paymentId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?

  @@index([date])
  @@index([type])
}

// ============================================================
// MESSAGES (§8.7)
// ============================================================
//
// Shapes follow src/data/models.ts: a chat is `group` or `dm`; membership is
// a soft-leave row so history survives someone leaving; a read receipt is one
// row per (message, employee) rather than a per-chat high-water mark, which is
// what lets "read by me" be answered for an individual message.

model Chat {
  id             String  @id @default(uuid())
  organisationId String
  // group | dm
  type           String
  // Groups carry a name; a DM derives its display name from the other member.
  name           String?
  description    String?

  // RESERVED FOR WORKSTATION — nullable, no UI in this phase.
  subjectType String?
  subjectId   String?

  // Denormalised so the chat list can sort by activity without a join.
  lastMessageAt DateTime?

  organisation Organisation  @relation(fields: [organisationId], references: [id])
  members      ChatMember[]
  messages     ChatMessage[]
  reads        MessageRead[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([lastMessageAt])
}

model ChatMember {
  id         String    @id @default(uuid())
  chatId     String
  employeeId String
  // member | admin
  role       String    @default("member")
  joinedAt   DateTime  @default(now())
  /// Soft leave — the person stops receiving the chat but history is intact.
  leftAt     DateTime?

  chat     Chat     @relation(fields: [chatId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([chatId, employeeId])
  @@index([employeeId])
}

model ChatMessage {
  id               String  @id @default(uuid())
  chatId           String
  authorEmployeeId String
  /// Empty for an image-only message — an attachment is content in its own
  /// right, so the caption is optional. Never null, so readers need no guard.
  body             String  @default("")
  /// Reply-to. A thread is one level deep by design.
  parentId         String?
  /// JSON array of employee ids. Reserved for @mentions; empty in this phase.
  mentionsJson     String  @default("[]")

  chat        Chat             @relation(fields: [chatId], references: [id])
  author      Employee         @relation(fields: [authorEmployeeId], references: [id])
  parent      ChatMessage?     @relation("MessageReply", fields: [parentId], references: [id])
  replies     ChatMessage[]    @relation("MessageReply")
  reads       MessageRead[]
  attachments ChatAttachment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete — messages are retained for audit.
  deletedAt DateTime?

  @@index([chatId, createdAt])
}

/// An image sent in a chat. Bytes live in the storage adapter, never in the
/// database and never on a publicly guessable path: `storagePath` is a
/// server-generated key, and the only way to read it back is the membership-
/// checked GET /api/chat-attachments/:id route.
model ChatAttachment {
  id        String @id @default(uuid())
  messageId String
  /// Key understood by the StorageAdapter — never a client-supplied path.
  storagePath      String
  /// What the sender called it, sanitized. Shown on hover and on download.
  originalFilename String
  /// Sniffed from the magic bytes, not taken from the upload's own header.
  mimeType         String
  fileSize         Int

  message ChatMessage @relation(fields: [messageId], references: [id])

  createdAt DateTime @default(now())

  @@index([messageId])
}

model MessageRead {
  id         String   @id @default(uuid())
  chatId     String
  messageId  String
  employeeId String
  readAt     DateTime @default(now())

  chat     Chat        @relation(fields: [chatId], references: [id])
  message  ChatMessage @relation(fields: [messageId], references: [id])
  employee Employee    @relation(fields: [employeeId], references: [id])

  @@unique([messageId, employeeId])
  @@index([chatId, employeeId])
}

// ============================================================
// NOTIFICATIONS + AUDIT (§8.9, §10)
// ============================================================

model Notification {
  id         String  @id @default(uuid())
  userId     String
  type       String
  // attendance | leave | payroll | expense | message | document | system
  module     String
  entityType String?
  entityId   String?
  title      String
  body       String
  actionUrl  String?
  isRead     Boolean @default(false)

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

/// Append-only. There is no update shape and no delete.
model AuditLog {
  id          String  @id @default(uuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  beforeJson  String?
  afterJson   String?
  ip          String?
  userAgent   String?

  actor User? @relation(fields: [actorUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================
// WORKSTATION (AUDIT_OS_WORKSTATION.md §5)
// ============================================================
//
// ONE CENTRAL CLIENT RECORD. Leads, Services, Follow-ups, Documents, GST,
// E-way Bills, Tasks and Activity all reference `Client.id`. Nothing in this
// section creates a second client row, and nothing creates a second employee
// table — every assignment is a scalar `…EmployeeId` resolved against the
// HRMS `Employee` at read time, exactly like `EmployeeDocument.uploadedBy`
// and `Expense.managerApprovedBy` already do. That is deliberate: declaring
// Prisma relations here would force back-relation fields onto `Employee` and
// `Organisation`, and those models must stay untouched.

/// Configurable service catalog. A ClientService and a Lead both point here.
model Service {
  id             String  @id @default(uuid())
  organisationId String
  code           String  @unique
  name           String
  isActive       Boolean @default(true)
  sortOrder      Int     @default(0)

  leads          Lead[]
  clientServices ClientService[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

/// A prospect, BEFORE it becomes a client. Never deleted once converted.
model Lead {
  id             String @id @default(uuid())
  organisationId String
  /// Human-readable 'LD-1001'. Allocated server-side inside a transaction.
  leadCode       String @unique

  name               String
  contactNumber      String
  email              String?
  serviceId          String
  priceQuotedPaise   Int     @default(0)
  /// HRMS Employee id. No FK by design — see the section header.
  assignedEmployeeId String
  /// new | contacted | requirement_identified | quote_sent | negotiation | won | lost
  status             String  @default("new")
  notes              String?
  lostReason         String?

  /// Set once, by conversion. @unique is what makes a second client from one
  /// lead impossible at the database level rather than only in a handler.
  convertedClientId String?   @unique
  convertedAt       DateTime?

  service   Service    @relation(fields: [serviceId], references: [id])
  followUps FollowUp[]

  /// System-generated (§5.2). Never accepted from a request body.
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([status])
  @@index([assignedEmployeeId])
}

/// THE ONE CENTRAL CLIENT RECORD.
model Client {
  id             String @id @default(uuid())
  organisationId String
  /// Human-readable 'CLI-1001'.
  clientCode     String @unique

  companyName   String
  legalName     String?
  businessType  String?
  contactPerson String
  contactNumber String
  email         String?
  address       String?

  gstin String?
  pan   String?
  tan   String?

  accountManagerId String
  assignedTeam     String?
  /// active | onboarding | pending_documents | service_due | inactive
  status           String  @default("onboarding")
  onboardingDate   String
  notes            String?

  /// Back-link to the lead this client came from. @unique mirrors
  /// Lead.convertedClientId so the 1:1 holds from both directions.
  sourceLeadId String? @unique

  /// RESERVED FOR THE CLIENT PORTAL (§56). Modelled, no client-facing screen.
  portalEnabled     Boolean @default(false)
  portalInviteEmail String?

  contacts          ClientContact[]
  services          ClientService[]
  followUps         FollowUp[]
  documents         ClientDocument[]
  tasks             Task[]
  ewayBills         EwayBill[]
  gstProfile        GstProfile?
  bkEngagement       BookkeepingEngagement?
  bkTasks            BookkeepingTask[]
  bkPendingItems     BookkeepingPendingItem[]
  bkDocumentRequests BookkeepingDocumentRequest[]
  bkDeliverables     BookkeepingDeliverable[]
  bkActivities       BookkeepingActivity[]
  incCases            IncorporationCase[]
  incDocumentRequests IncorporationDocumentRequest[]
  incDeliverables     IncorporationDeliverable[]
  incFees             IncorporationFee[]
  aaBankAccounts     AaBankAccount[]
  aaSourceDocuments  AaSourceDocument[]
  aaJobs             AaJob[]
  aaGstFilings2B     AaGstFiling2B[]
  aaPurchaseRegisters AaPurchaseRegister[]
  aaGstReconJobs     AaGstReconJob[]
  aaTds26AS          AaTds26AS[]
  aaTdsBooks         AaTdsBooks[]
  aaTdsReconJobs     AaTdsReconJob[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([status])
  @@index([accountManagerId])
}

model ClientContact {
  id          String  @id @default(uuid())
  clientId    String
  name        String
  designation String?
  phone       String
  email       String?
  isPrimary   Boolean @default(false)

  client     Client               @relation(fields: [clientId], references: [id])
  incParties IncorporationParty[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([clientId])
}

/// A service sold to a client. The join between Client and the catalog.
model ClientService {
  id        String @id @default(uuid())
  clientId  String
  serviceId String

  assignedEmployeeId String
  managerId          String?
  /// 'YYYY-MM-DD' — a calendar date, so it cannot drift across the IST/UTC edge.
  dueDate            String?
  /// not_started | documents_pending | in_progress | under_review | ready |
  /// submitted | completed | failed | on_hold
  status             String    @default("not_started")
  startedAt          DateTime?
  completedAt        DateTime?
  notes              String?

  client   Client              @relation(fields: [clientId], references: [id])
  service  Service             @relation(fields: [serviceId], references: [id])
  tasks    Task[]
  incCases IncorporationCase[]
  incFees  IncorporationFee[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([clientId])
  @@index([assignedEmployeeId])
  @@index([status])
}

model Task {
  id                 String  @id @default(uuid())
  clientId           String
  clientServiceId    String?
  /// Set when the task was raised from an Incorporation case. Nullable, so
  /// every existing Task row is untouched — this EXTENDS the one task engine
  /// rather than standing a second one up beside it.
  incorporationCaseId String?
  title              String
  description        String?
  assignedEmployeeId String
  dueDate            String?
  /// open | in_progress | blocked | done
  status             String  @default("open")

  client            Client             @relation(fields: [clientId], references: [id])
  clientService     ClientService?     @relation(fields: [clientServiceId], references: [id])
  incorporationCase IncorporationCase? @relation(fields: [incorporationCaseId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([clientId])
  @@index([assignedEmployeeId])
  @@index([incorporationCaseId])
}

/// ONE follow-up entity for BOTH leads and clients (§3). Exactly one of
/// leadId / clientId is set; the service layer enforces the XOR on write.
model FollowUp {
  id              String  @id @default(uuid())
  organisationId  String
  leadId          String?
  clientId        String?
  clientServiceId String?

  title                 String
  /// call | whatsapp | email | meeting | document_request | payment_followup |
  /// service_followup | other
  type                  String   @default("call")
  /// A point in time — the follow-up's date AND time.
  scheduledAt           DateTime
  assignedEmployeeId    String
  /// pending | completed | rescheduled | cancelled | missed
  status                String   @default("pending")
  notes                 String?
  reminderMinutesBefore Int?

  completedByEmployeeId String?
  completedAt           DateTime?
  completionNotes       String?

  lead   Lead?   @relation(fields: [leadId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([scheduledAt])
  @@index([assignedEmployeeId, status])
  @@index([clientId])
  @@index([leadId])
}

model DocumentCategory {
  id             String  @id @default(uuid())
  organisationId String
  /// gst | it_filing | basic | other
  code           String  @unique
  name           String
  description    String?
  sortOrder      Int     @default(0)

  documents ClientDocument[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

/// CLIENT-CENTRIC (§10.7). clientId is REQUIRED; clientServiceId is only a
/// tag. There is deliberately no per-service document store.
///
/// Named ClientDocument rather than §17's bare `Document` because
/// `EmployeeDocument` already exists for HRMS and the two must never be
/// confused at a call site.
model ClientDocument {
  id              String  @id @default(uuid())
  clientId        String
  categoryId      String
  /// Optional tag only — a document belongs to the CLIENT, not the service.
  clientServiceId String?

  name           String
  financialYear  String?
  /// requested | pending | uploaded | under_review | verified | rejected | expired
  status         String  @default("requested")
  /// Points at the highest ClientDocumentVersion.version. 0 = nothing uploaded yet.
  currentVersion Int     @default(0)

  requestedByEmployeeId String?
  requestedAt           DateTime?
  verifiedByEmployeeId  String?
  verifiedAt            DateTime?
  rejectionReason       String?
  expiryDate            String?

  client   Client                  @relation(fields: [clientId], references: [id])
  category DocumentCategory        @relation(fields: [categoryId], references: [id])
  versions ClientDocumentVersion[]
  bkDocumentRequests BookkeepingDocumentRequest[]
  bkDeliverables     BookkeepingDeliverable[]
  incDocumentRequests IncorporationDocumentRequest[]
  incFilings          IncorporationFiling[]
  incQueries          IncorporationQuery[]
  incDeliverables     IncorporationDeliverable[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([clientId])
  @@index([categoryId])
  @@index([status])
}

/// Never overwrite (§10.6). An upload appends v1 → v2 → v3, each with its own
/// fileKey and therefore its own signed download URL.
model ClientDocumentVersion {
  id                String   @id @default(uuid())
  documentId        String
  version           Int
  fileKey           String
  /// An HRMS employee id, or the literal 'portal' when the future Client
  /// Portal delivered it. Seeded both ways so the receiving path is exercised.
  uploadedBy        String
  uploadedAt        DateTime @default(now())
  sizeBytes         Int      @default(0)
  notes             String?
  previousVersionId String?

  document ClientDocument @relation(fields: [documentId], references: [id])

  createdAt DateTime @default(now())

  @@unique([documentId, version])
  @@index([documentId])
}

model GstProfile {
  id       String @id @default(uuid())
  clientId String @unique
  gstin    String

  /// active | cancelled | suspended | not_registered
  registrationStatus String    @default("active")
  /// monthly | quarterly
  filingFrequency    String    @default("monthly")
  registrationDate   String?
  assignedEmployeeId String
  /// Mirrors the GST service status values (§7.7).
  serviceStatus      String    @default("not_started")
  lastFiledAt        DateTime?
  nextDueDate        String?

  client  Client      @relation(fields: [clientId], references: [id])
  filings GstFiling[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
}

model GstFiling {
  id                 String    @id @default(uuid())
  gstProfileId       String
  /// 'YYYY-MM' — the return period, e.g. '2026-08'.
  period             String
  /// GSTR-1 | GSTR-3B | GSTR-9
  returnType         String
  /// not_started | documents_pending | data_preparation | under_review |
  /// ready_to_file | filed | failed | completed
  status             String    @default("not_started")
  filedAt            DateTime?
  dueDate            String?
  assignedEmployeeId String
  arn                String?
  remarks            String?

  gstProfile GstProfile @relation(fields: [gstProfileId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([gstProfileId, period, returnType])
  @@index([status])
}

/// SIMULATED (§7.3 / §15). `isSimulated` defaults true and every response and
/// screen says so. Audit OS has no government e-way bill connectivity.
model EwayBill {
  id       String @id @default(uuid())
  clientId String
  ewbNo    String @unique

  documentNo            String
  documentDate          String
  fromGstin             String?
  toGstin               String?
  toPartyName           String?
  valuePaise            Int       @default(0)
  /// generated | active | cancelled | expired
  status                String    @default("generated")
  generatedAt           DateTime  @default(now())
  validUntil            String?
  cancelledAt           DateTime?
  cancelReason          String?
  generatedByEmployeeId String
  isSimulated           Boolean   @default(true)

  client Client @relation(fields: [clientId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([clientId])
}

/// The user-visible timeline (§11) — distinct from AuditLog, which is the
/// security trail. Append-only, so no deletedAt, like AuditLog.
model Activity {
  id             String @id @default(uuid())
  organisationId String
  /// lead | client
  subjectType    String
  subjectId      String

  /// 'lead.created', 'lead.status_changed', 'client.service_assigned', …
  action          String
  description     String
  actorUserId     String?
  actorEmployeeId String?
  entityType      String?
  entityId        String?
  metaJson        String?

  createdAt DateTime @default(now())

  @@index([subjectType, subjectId, createdAt])
}

// ============================================================
// TOOLS MODULE (Converters & Utilities)
// ============================================================
//
// One document model for every tool — no per-tool tables. The registry that
// drives the Tools page lives in code (src/modules/tools/registry.ts on both
// sides); these three catalogue tables are synced FROM it by the seed so a
// job row can reference a stable tool id and reporting can join on it.

model ToolCategory {
  id     String @id
  key    String @unique
  label  String
  order  Int
  /// active | coming_soon
  status String @default("active")

  groups ToolGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ToolGroup {
  id         String @id
  key        String @unique
  label      String
  categoryId String
  order      Int

  category ToolCategory @relation(fields: [categoryId], references: [id])
  tools    Tool[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tool {
  id            String @id
  key           String @unique
  name          String
  description   String
  groupId       String
  /// pdf | xlsx | docx | csv | txt | zip
  outputType    String
  permissionKey String
  /// active | coming_soon
  status        String @default("active")

  group ToolGroup @relation(fields: [groupId], references: [id])
  jobs  ToolJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A file the Tools module holds: either something a user uploaded as input
/// (`kind = input`) or something a tool generated (`kind = output`).
model ToolDocument {
  id               String  @id @default(uuid())
  organisationId   String
  userId           String
  /// input | output
  kind             String  @default("output")
  originalFilename String
  storedFilename   String
  mimeType         String
  fileSize         Int
  /// Key understood by the StorageAdapter — never a client-supplied path.
  storagePath      String
  /// Registry tool id that produced this document (null for raw uploads).
  sourceTool       String?
  parentDocumentId String?
  /// processing | completed | failed
  status           String  @default("completed")
  errorMessage     String?
  /// Free-form JSON — page count, table count, OCR confidence, signer info…
  metaJson         String?

  organisation Organisation          @relation(fields: [organisationId], references: [id])
  user         User                  @relation(fields: [userId], references: [id])
  versions     ToolDocumentVersion[]
  inputJobs    ToolJob[]             @relation("ToolJobInput")
  outputJobs   ToolJob[]             @relation("ToolJobOutput")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organisationId, userId])
  @@index([sourceTool])
  @@index([status])
  @@index([createdAt])
}

model ToolDocumentVersion {
  id          String @id @default(uuid())
  documentId  String
  version     Int
  storagePath String
  fileSize    Int

  document ToolDocument @relation(fields: [documentId], references: [id])

  createdAt DateTime @default(now())

  @@unique([documentId, version])
}

/// Every tool run — queued, processing, completed or failed — is one row here,
/// so the Documents detail drawer can show timing and the outcome uniformly.
model ToolJob {
  id               String    @id @default(uuid())
  toolId           String
  userId           String
  organisationId   String
  inputDocumentId  String?
  outputDocumentId String?
  /// queued | processing | completed | failed
  status           String    @default("queued")
  /// 0–100, reported by the service where it can be determinate.
  progress         Int       @default(0)
  errorMessage     String?
  /// Tool options + per-run facts (all input ids, page counts, warnings…).
  metaJson         String?
  startedAt        DateTime?
  completedAt      DateTime?

  tool           Tool          @relation(fields: [toolId], references: [id])
  user           User          @relation(fields: [userId], references: [id])
  organisation   Organisation  @relation(fields: [organisationId], references: [id])
  inputDocument  ToolDocument? @relation("ToolJobInput", fields: [inputDocumentId], references: [id])
  outputDocument ToolDocument? @relation("ToolJobOutput", fields: [outputDocumentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId, userId])
  @@index([toolId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// AUDIT AUTOMATION (AMENDMENT-02-REPOTIC-GAPS.md)
// Bank-statement ingestion pipeline. See plan file: revised upload
// flow with user-selected bank, password-protected PDF support,
// scanned-document rejection, per-client dedupe, adapter registry.
// ============================================================

/// Master list of supported banks. Rendered in the bank-picker on the
/// upload wireframe (amendment §3). Seeded from a code registry so a
/// new adapter adds a bank list entry automatically.
model AaBank {
  id     String  @id
  key    String  @unique
  name   String
  order  Int
  active Boolean @default(true)

  accounts        AaBankAccount[]
  sourceDocuments AaSourceDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A bank account belonging to a client — the auditor picks one before
/// uploading a statement. Full account number is intentionally NOT
/// stored on this slice; only the masked form (e.g. "•••4471"). Adding
/// an encrypted full number is a follow-on decision.
model AaBankAccount {
  id                  String  @id @default(uuid())
  organisationId      String
  clientId            String
  bankId              String
  /// Masked form for display, e.g. "•••4471".
  accountNumberMasked String
  /// Optional label (e.g. "Current — Payroll").
  label               String?
  currency            String  @default("INR")
  active              Boolean @default(true)

  organisation    Organisation       @relation(fields: [organisationId], references: [id])
  client          Client             @relation(fields: [clientId], references: [id])
  bank            AaBank             @relation(fields: [bankId], references: [id])
  sourceDocuments AaSourceDocument[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organisationId, clientId])
  @@index([bankId])
}

/// A statement record. This is NOT the encrypted PDF — per amendment
/// §1-Gap1 we store the extracted text (pdfjs TextItem[] per page,
/// with coordinates) at `extractionPath`, never a decrypted copy of
/// the PDF. `fileSha256` is the sha256 of the original uploaded bytes
/// (encrypted), which is what the auditor sees as "the file" and so
/// is the correct dedupe key per (clientId, fileSha256).
///
/// The password is deliberately absent — used to decrypt in memory
/// during upload preflight, then discarded. Never persisted anywhere.
model AaSourceDocument {
  id                String  @id @default(uuid())
  organisationId    String
  clientId          String
  uploadedByUserId  String
  bankId            String
  bankAccountId     String
  originalFilename  String
  mimeType          String
  fileSize          Int
  fileSha256        String
  /// Storage key for the JSON extraction blob (never the decrypted PDF).
  extractionPath    String
  pageCount         Int
  /// Sum of text bytes across pages — the text-layer signal.
  textLayerBytes    Int
  encrypted         Boolean @default(false)
  /// "Page N of M" M value where the footer was found; null otherwise.
  declaredPageCount Int?

  organisation Organisation  @relation(fields: [organisationId], references: [id])
  client       Client        @relation(fields: [clientId], references: [id])
  uploadedBy   User          @relation(fields: [uploadedByUserId], references: [id])
  bank         AaBank        @relation(fields: [bankId], references: [id])
  bankAccount  AaBankAccount @relation(fields: [bankAccountId], references: [id])
  jobs         AaJob[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// Per-client dedupe key (amendment §4-Prompt2-1(d)). A second upload
  /// of the same file for the same client is refused with a link to the
  /// existing job.
  @@unique([clientId, fileSha256])
  @@index([organisationId, clientId])
  @@index([bankId])
}

/// One pipeline run per uploaded statement. Status walks
/// queued → extracting → extracted | failed. This slice's extractor
/// is a stub; row-extraction + balance chain are follow-on slices.
model AaJob {
  id               String    @id @default(uuid())
  sourceDocumentId String
  organisationId   String
  clientId         String
  createdByUserId  String
  /// queued | extracting | extracted | failed
  status           String    @default("queued")
  progress         Int       @default(0)
  /// Non-blocking condition flags: ADAPTER_UNCERTAIN, ADAPTER_MISMATCH,
  /// PAGE_COUNT_MISMATCH, UNKNOWN_FORMAT.
  flags            String    @default("")
  errorMessage     String?
  /// Adapter id, detect score, page counts, extractor facts. Never a
  /// password — password is destructured out at the route boundary.
  metaJson         String?
  startedAt        DateTime?
  completedAt      DateTime?

  sourceDocument AaSourceDocument @relation(fields: [sourceDocumentId], references: [id])
  organisation   Organisation     @relation(fields: [organisationId], references: [id])
  client         Client           @relation(fields: [clientId], references: [id])
  createdBy      User             @relation(fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId, clientId])
  @@index([sourceDocumentId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// AUDIT AUTOMATION · GST RECONCILIATION
// GSTR-2B (inward supplies from GSTN) vs Purchase Register
// (client's book). See plan for the parsers and matching engine.
// ============================================================

/// One uploaded GSTR-2B filing (from the GSTN portal, JSON or Excel).
/// Per-(client, sha256) dedupe like AaSourceDocument.
model AaGstFiling2B {
  id                String  @id @default(uuid())
  organisationId    String
  clientId          String
  uploadedByUserId  String
  /// 1..12
  periodMonth       Int
  periodYear        Int
  /// json | excel
  sourceFormat      String
  originalFilename  String
  fileSize          Int
  fileSha256        String
  storagePath       String
  /// Client's own GSTIN this filing was pulled for.
  gstin             String?
  /// When GSTN generated the 2B (from the file's own metadata).
  generatedAt       DateTime?

  organisation Organisation           @relation(fields: [organisationId], references: [id])
  client       Client                 @relation(fields: [clientId], references: [id])
  uploadedBy   User                   @relation(fields: [uploadedByUserId], references: [id])
  entries      AaGstFiling2BEntry[]
  reconJobs    AaGstReconJob[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([clientId, fileSha256])
  @@index([organisationId, clientId])
  @@index([periodYear, periodMonth])
}

/// One line item inside a GSTR-2B filing. Sections map to the JSON
/// envelope: b2b | cdnr | isd | impg | imps + amendments b2ba|cdnra|isda.
model AaGstFiling2BEntry {
  id             String  @id @default(uuid())
  filingId       String
  section        String
  supplierGstin  String
  supplierName   String?
  invoiceNumber  String
  /// YYYY-MM-DD to keep the calendar date IST-stable.
  invoiceDate    String
  /// Amounts in paise (INR minor units) — Int for exact arithmetic.
  taxableValue   Int
  igst           Int     @default(0)
  cgst           Int     @default(0)
  sgst           Int     @default(0)
  cess           Int     @default(0)
  /// GSTN's own "ITC Available" flag from the 2B row.
  itcAvailable   Boolean @default(true)
  /// Original source row as JSON so we can re-parse later if needed.
  rawJson        String?

  filing   AaGstFiling2B    @relation(fields: [filingId], references: [id])
  reconRows AaGstReconRow[] @relation("Filing2BEntryToReconRow")

  @@index([filingId])
  @@index([supplierGstin, invoiceNumber])
}

/// One uploaded Purchase Register (client's book — Excel with a column
/// map, or Tally XML). Per-(client, sha256) dedupe.
model AaPurchaseRegister {
  id                String  @id @default(uuid())
  organisationId    String
  clientId          String
  uploadedByUserId  String
  periodMonth       Int
  periodYear        Int
  /// excel | tally_xml
  sourceFormat      String
  originalFilename  String
  fileSize          Int
  fileSha256        String
  storagePath       String
  /// { supplierGstin: 'B', invoiceNumber: 'D', ... } for Excel; null for Tally XML.
  columnMapJson     String?

  organisation Organisation                @relation(fields: [organisationId], references: [id])
  client       Client                      @relation(fields: [clientId], references: [id])
  uploadedBy   User                        @relation(fields: [uploadedByUserId], references: [id])
  entries      AaPurchaseRegisterEntry[]
  reconJobs    AaGstReconJob[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([clientId, fileSha256])
  @@index([organisationId, clientId])
  @@index([periodYear, periodMonth])
}

/// One line item inside a Purchase Register.
model AaPurchaseRegisterEntry {
  id             String  @id @default(uuid())
  registerId     String
  supplierGstin  String
  supplierName   String?
  invoiceNumber  String
  invoiceDate    String
  taxableValue   Int
  igst           Int     @default(0)
  cgst           Int     @default(0)
  sgst           Int     @default(0)
  cess           Int     @default(0)
  /// Ledger / GL code from the register (optional).
  glCode         String?
  rawJson        String?

  register  AaPurchaseRegister @relation(fields: [registerId], references: [id])
  reconRows AaGstReconRow[]    @relation("PurchaseRegisterEntryToReconRow")

  @@index([registerId])
  @@index([supplierGstin, invoiceNumber])
}

/// One reconciliation run pairing a 2B filing with a PR for a client.
model AaGstReconJob {
  id                    String  @id @default(uuid())
  organisationId        String
  clientId              String
  createdByUserId       String
  filing2BId            String
  purchaseRegisterId    String
  /// queued | matching | matched | failed
  status                String  @default("queued")
  progress              Int     @default(0)
  matchedCount          Int     @default(0)
  partialCount          Int     @default(0)
  only2BCount           Int     @default(0)
  onlyPRCount           Int     @default(0)
  /// { matched: {taxable, igst, cgst, sgst, cess}, partial: {...}, only_2b: {...}, only_pr: {...} } — paise.
  totalsJson            String?
  errorMessage          String?
  startedAt             DateTime?
  completedAt           DateTime?

  organisation      Organisation       @relation(fields: [organisationId], references: [id])
  client            Client             @relation(fields: [clientId], references: [id])
  createdBy         User               @relation(fields: [createdByUserId], references: [id])
  filing2B          AaGstFiling2B      @relation(fields: [filing2BId], references: [id])
  purchaseRegister  AaPurchaseRegister @relation(fields: [purchaseRegisterId], references: [id])
  rows              AaGstReconRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId, clientId])
  @@index([status])
  @@index([createdAt])
}

/// One row of the reconciliation result. Either or both entry refs may be
/// set: matched/partial rows carry both; only_2b / only_pr rows carry one.
model AaGstReconRow {
  id                        String  @id @default(uuid())
  jobId                     String
  /// matched | partial | only_2b | only_pr
  matchStatus               String
  filing2BEntryId           String?
  purchaseRegisterEntryId   String?
  /// Comma-separated field names that differ on partial matches
  /// (taxable_value | tax_split | invoice_date | supplier_gstin).
  mismatchFields            String  @default("")
  /// eligible | ineligible | reversal | blocked (auditor-overridable).
  itcClassification         String  @default("eligible")
  auditorNote               String?
  reviewedByUserId          String?
  reviewedAt                DateTime?

  job                     AaGstReconJob            @relation(fields: [jobId], references: [id])
  filing2BEntry           AaGstFiling2BEntry?      @relation("Filing2BEntryToReconRow", fields: [filing2BEntryId], references: [id])
  purchaseRegisterEntry   AaPurchaseRegisterEntry? @relation("PurchaseRegisterEntryToReconRow", fields: [purchaseRegisterEntryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId, matchStatus])
  @@index([filing2BEntryId])
  @@index([purchaseRegisterEntryId])
}

// ============================================================
// AUDIT AUTOMATION · TDS RECONCILIATION
// Form 26AS (TDS credits reported by deductors) vs client's TDS books.
// ============================================================

/// One uploaded Form 26AS (TRACES text or Excel).
model AaTds26AS {
  id                  String    @id @default(uuid())
  organisationId      String
  clientId            String
  uploadedByUserId    String
  /// Client PAN (from the 26AS header).
  pan                 String?
  /// AY (e.g. 2027 for AY 2026-27, i.e. FY 2026-27).
  assessmentYear      Int
  /// text | excel
  sourceFormat        String
  originalFilename    String
  fileSize            Int
  fileSha256          String
  storagePath         String
  /// From the 26AS header (View As on date / Generated on).
  tracesGeneratedAt   DateTime?

  organisation Organisation       @relation(fields: [organisationId], references: [id])
  client       Client             @relation(fields: [clientId], references: [id])
  uploadedBy   User               @relation(fields: [uploadedByUserId], references: [id])
  entries      AaTds26ASEntry[]
  reconJobs    AaTdsReconJob[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([clientId, fileSha256])
  @@index([organisationId, clientId])
  @@index([assessmentYear])
}

/// One line-item inside a 26AS. `part` identifies the 26AS section
/// (Part A = TDS on salary, A1 = TDS other than salary, A2 = TDS on
/// sale of immovable property, Part B = TCS, Part C = tax paid).
model AaTds26ASEntry {
  id             String  @id @default(uuid())
  filingId       String
  /// part_a | part_a1 | part_a2 | part_b | part_c
  part           String
  /// Bare TDS section code (e.g. "194C", "192", "195").
  section        String
  deductorTan    String
  deductorName   String?
  /// Q1 | Q2 | Q3 | Q4
  quarter        String
  /// Amounts in paise (INR minor units) for exact arithmetic.
  amountPaid     Int     @default(0)
  tdsAmount      Int     @default(0)
  /// Date TDS was deducted / booked (YYYY-MM-DD, IST calendar).
  tdsDate        String
  /// TRACES status (Booked / Provisional / etc.), free text.
  status         String?
  rawJson        String?

  filing    AaTds26AS       @relation(fields: [filingId], references: [id])
  reconRows AaTdsReconRow[] @relation("Tds26ASEntryToReconRow")

  @@index([filingId])
  @@index([deductorTan, section, quarter])
}

/// One uploaded Books TDS register (Excel + column map, or Tally XML).
model AaTdsBooks {
  id                String    @id @default(uuid())
  organisationId    String
  clientId          String
  uploadedByUserId  String
  assessmentYear    Int
  /// excel | tally_xml
  sourceFormat      String
  originalFilename  String
  fileSize          Int
  fileSha256        String
  storagePath       String
  /// Column map (JSON) — only set for Excel uploads.
  columnMapJson     String?

  organisation Organisation      @relation(fields: [organisationId], references: [id])
  client       Client            @relation(fields: [clientId], references: [id])
  uploadedBy   User              @relation(fields: [uploadedByUserId], references: [id])
  entries      AaTdsBooksEntry[]
  reconJobs    AaTdsReconJob[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([clientId, fileSha256])
  @@index([organisationId, clientId])
  @@index([assessmentYear])
}

/// One entry inside a Books TDS register.
model AaTdsBooksEntry {
  id             String  @id @default(uuid())
  booksId        String
  section        String
  deductorTan    String
  deductorName   String?
  quarter        String
  amountPaid     Int     @default(0)
  tdsAmount      Int     @default(0)
  tdsDate        String
  glCode         String?
  rawJson        String?

  books     AaTdsBooks      @relation(fields: [booksId], references: [id])
  reconRows AaTdsReconRow[] @relation("TdsBooksEntryToReconRow")

  @@index([booksId])
  @@index([deductorTan, section, quarter])
}

/// One TDS reconciliation run pairing a 26AS with a Books register.
model AaTdsReconJob {
  id                 String    @id @default(uuid())
  organisationId     String
  clientId           String
  createdByUserId    String
  filing26ASId       String
  booksId            String
  /// queued | matching | matched | failed
  status             String    @default("queued")
  progress           Int       @default(0)
  verifiedCount      Int       @default(0)
  varianceCount      Int       @default(0)
  only26ASCount      Int       @default(0)
  onlyBooksCount     Int       @default(0)
  /// { verified: { amount_paid, tds_amount, count }, variance: {...}, ... } — paise.
  totalsJson         String?
  errorMessage       String?
  startedAt          DateTime?
  completedAt        DateTime?

  organisation Organisation    @relation(fields: [organisationId], references: [id])
  client       Client          @relation(fields: [clientId], references: [id])
  createdBy    User            @relation(fields: [createdByUserId], references: [id])
  filing26AS   AaTds26AS       @relation(fields: [filing26ASId], references: [id])
  books        AaTdsBooks      @relation(fields: [booksId], references: [id])
  rows         AaTdsReconRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId, clientId])
  @@index([status])
  @@index([createdAt])
}

/// One row of a TDS recon result. Either or both entry refs may be set.
model AaTdsReconRow {
  id                      String    @id @default(uuid())
  jobId                   String
  /// verified | variance | only_26as | only_books
  matchStatus             String
  filing26ASEntryId       String?
  booksEntryId            String?
  /// Comma-separated: tds_amount | amount_paid | tds_date | section
  mismatchFields          String    @default("")
  /// no_action | chase_deductor | revise_book | credit_claimed | written_off
  actionStatus            String    @default("no_action")
  auditorNote             String?
  reviewedByUserId        String?
  reviewedAt              DateTime?

  job              AaTdsReconJob    @relation(fields: [jobId], references: [id])
  filing26ASEntry  AaTds26ASEntry?  @relation("Tds26ASEntryToReconRow", fields: [filing26ASEntryId], references: [id])
  booksEntry       AaTdsBooksEntry? @relation("TdsBooksEntryToReconRow", fields: [booksEntryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId, matchStatus])
  @@index([filing26ASEntryId])
  @@index([booksEntryId])
}

// ============================================================
// TALLY — native double-entry accounting module (AUDITOSTALLYMODULEPROMPT.md)
// Foundation slice: companies, financial years, groups, ledgers.
// Every table carries tallyCompanyId; every service enforces strict
// (organisationId, tallyCompanyId) isolation. Money in paise (Int).
// ============================================================

/// One accounting company (Tally-equivalent). A user's Organisation
/// may hold many companies; each is fully isolated from the others.
model TallyCompany {
  id                   String  @id @default(uuid())
  organisationId       String
  name                 String
  mailingName          String?
  address              String?
  country              String  @default("India")
  state                String?
  pin                  String?
  phone                String?
  email                String?
  website              String?
  baseCurrency         String  @default("INR")
  /// regular | composition | unregistered | sez | overseas
  gstRegistrationType  String  @default("regular")
  gstin                String?
  pan                  String?
  tan                  String?
  /// Month the financial year begins (Indian FY = 4 / April).
  fyBeginMonth         Int     @default(4)
  /// Calendar date books opened (YYYY-MM-DD, IST-stable).
  booksBeginFrom       String
  active               Boolean @default(true)

  organisation Organisation          @relation(fields: [organisationId], references: [id])
  financialYears TallyFinancialYear[]
  groups         TallyGroup[]
  ledgers        TallyLedger[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organisationId])
  @@unique([organisationId, name])
}

/// Financial year for a Tally company. Every future voucher will
/// belong to exactly one FY; posting into a closed FY is rejected.
model TallyFinancialYear {
  id             String  @id @default(uuid())
  tallyCompanyId String
  /// Human label, e.g. "2026-27".
  label          String
  startDate      String
  endDate        String
  closed         Boolean @default(false)

  company TallyCompany  @relation(fields: [tallyCompanyId], references: [id])
  ledgersOpening TallyLedger[] @relation("LedgerOpeningInFY")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tallyCompanyId, label])
  @@index([tallyCompanyId])
}

/// Group of ledgers — the top of the account tree. Seeded with 17
/// primary groups per company at creation time (Capital, Sundry
/// Debtors, etc.). Sub-groups reference `parentGroupId`.
model TallyGroup {
  id             String  @id @default(uuid())
  tallyCompanyId String
  name           String
  parentGroupId  String?
  /// assets | liabilities | income | expenses
  nature         String
  /// Whether balances under this group hit P&L (vs Balance Sheet only).
  affectsPL      Boolean @default(false)
  /// Primary groups are seeded and cannot be deleted.
  isPrimary      Boolean @default(false)

  company     TallyCompany  @relation(fields: [tallyCompanyId], references: [id])
  parentGroup TallyGroup?   @relation("TallyGroupParent", fields: [parentGroupId], references: [id])
  children    TallyGroup[]  @relation("TallyGroupParent")
  ledgers     TallyLedger[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([tallyCompanyId, name])
  @@index([tallyCompanyId])
  @@index([parentGroupId])
}

/// A ledger — the leaves of the account tree. Opening balances land
/// here; posted voucher lines (Slice 2+) reference these.
model TallyLedger {
  id                       String  @id @default(uuid())
  tallyCompanyId           String
  name                     String
  groupId                  String
  /// Amount in PAISE — never floats.
  openingBalancePaise      Int     @default(0)
  /// dr | cr — which side the opening balance sits on.
  openingBalanceType       String  @default("dr")
  /// FY the opening balance applies to.
  openingBalanceAsOfFyId   String?
  address                  String?
  contact                  String?
  gstin                    String?
  pan                      String?
  state                    String?
  /// regular | composition | unregistered | sez | overseas
  gstRegistrationType      String?
  creditPeriodDays         Int?
  bankAccountName          String?
  bankAccountNumber        String?
  bankIfsc                 String?
  /// JSON blob for default tax config (rate, HSN, etc.).
  taxConfigJson            String?
  active                   Boolean @default(true)

  company             TallyCompany        @relation(fields: [tallyCompanyId], references: [id])
  group               TallyGroup          @relation(fields: [groupId], references: [id])
  openingBalanceAsOf  TallyFinancialYear? @relation("LedgerOpeningInFY", fields: [openingBalanceAsOfFyId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([tallyCompanyId, name])
  @@index([tallyCompanyId])
  @@index([groupId])
}
// ============================================================
// BOOKS — native bookkeeping (docs/accounting-module/README.md)
// ============================================================
//
// One BooksOrganisation per end client of the firm. Every table below carries
// booksOrgId and every read folds it into the where clause. Money is BigInt
// minor units (paise); a foreign-currency line stores both the transaction
// amount (fxAmount, fxCurrency) and the base amount (amount) with the rate.
//
// The ONE writer of financial state is BooksJournal + BooksJournalLine, via
// engine/posting.ts. Invoices, bills, payments, credit notes and transfers are
// wrappers that produce journals. Triggers in prisma/sql/books-invariants.*
// make an unbalanced posted journal, an edit to a posted journal, or an
// edit/delete of an audit event impossible at the database.

model BooksOrganisation {
  id             String  @id @default(uuid())
  organisationId String
  /// Optional link to the Workstation client this set of books belongs to.
  clientId       String?
  name           String
  legalName      String?
  gstin          String?
  pan            String?
  /// Two-letter GST state code, e.g. '33' for Tamil Nadu — place-of-supply anchor.
  stateCode      String?
  stateName      String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  pincode        String?
  baseCurrency   String  @default("INR")
  fiscalYearStartMonth Int @default(4)
  /// Enable TDS deduction on purchases.
  tdsEnabled     Boolean @default(true)
  isActive       Boolean @default(true)

  memberships BooksMembership[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([organisationId])
  @@index([clientId])
}

/// Firm staff assigned to a set of books. role: admin | staff | viewer.
model BooksMembership {
  id         String @id @default(uuid())
  booksOrgId String
  userId     String
  role       String @default("staff")

  booksOrg BooksOrganisation @relation(fields: [booksOrgId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?

  @@unique([booksOrgId, userId])
  @@index([userId])
}

/// Account groups. rootCategory: asset | liability | equity | income | expense.
/// tallyGroup mirrors Tally's primary group names for a later export.
model BooksAccountGroup {
  id            String  @id @default(uuid())
  booksOrgId    String
  name          String
  rootCategory  String
  tallyGroup    String
  parentGroupId String?
  isSystem      Boolean @default(false)
  sortOrder     Int     @default(0)

  ledgers BooksLedger[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([booksOrgId, name])
  @@index([booksOrgId, rootCategory])
}

/// A ledger account. systemKey names the accounts the engine posts to
/// (accounts_receivable, cgst_output, round_off, …) so posting never
/// depends on a user-editable name.
model BooksLedger {
  id                 String  @id @default(uuid())
  booksOrgId         String
  groupId            String
  name               String
  alias              String?
  code               String?
  rootCategory       String
  tallyGroup         String
  systemKey          String?
  /// Party ledgers point at their contact.
  contactId          String?
  openingBalance     BigInt  @default(0)
  /// debit | credit
  openingBalanceType String  @default("debit")
  openingDate        String?
  currency           String  @default("INR")
  billWise           Boolean @default(false)
  gstin              String?
  stateCode          String?
  /// TDS nature of payment / section for expense ledgers, e.g. '194C'.
  tdsSection         String?
  bankName           String?
  bankAccountNo      String?
  bankIfsc           String?
  isBank             Boolean @default(false)
  isCash             Boolean @default(false)
  isSystem           Boolean @default(false)
  isActive           Boolean @default(true)
  description        String?

  group BooksAccountGroup @relation(fields: [groupId], references: [id])
  lines BooksJournalLine[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([booksOrgId, name])
  @@index([booksOrgId, systemKey])
  @@index([booksOrgId, rootCategory])
  @@index([contactId])
}

/// THE financial record. status: draft | posted | void.
/// voucherType: journal | opening | invoice | credit_note | payment_in |
///   bill | vendor_credit | payment_out | transfer | revaluation | retainer_apply
model BooksJournal {
  id            String  @id @default(uuid())
  booksOrgId    String
  date          String  // 'YYYY-MM-DD'
  number        String
  voucherType   String
  sourceModule  String?
  sourceId      String?
  narration     String?
  status        String  @default("draft")
  /// Set on the reversing journal that voids another.
  reversesJournalId String?
  /// Set on a voided journal, pointing at its reversal.
  voidedByJournalId String?
  currency      String  @default("INR")
  exchangeRate  Float   @default(1)
  totalDebit    BigInt  @default(0)
  totalCredit   BigInt  @default(0)
  postedAt      DateTime?
  postedBy      String?

  lines       BooksJournalLine[]
  allocations BooksBillAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@unique([booksOrgId, number])
  @@index([booksOrgId, date])
  @@index([booksOrgId, status])
  @@index([sourceModule, sourceId])
}

model BooksJournalLine {
  id            String  @id @default(uuid())
  journalId     String
  booksOrgId    String
  lineNo        Int
  ledgerId      String
  /// debit | credit
  side          String
  /// Base-currency minor units, always positive.
  amount        BigInt
  fxCurrency    String  @default("INR")
  fxAmount      BigInt
  exchangeRate  Float   @default(1)
  partyLedgerId String?
  taxRateId     String?
  description   String?
  /// Bank reconciliation: statement line this entry was matched to.
  reconciledStatementLineId String?
  reconciledAt  DateTime?

  journal BooksJournal @relation(fields: [journalId], references: [id])
  ledger  BooksLedger  @relation(fields: [ledgerId], references: [id])

  @@index([booksOrgId, ledgerId])
  @@index([journalId])
}

/// An open item on a bill-wise ledger: one per invoice / bill / advance.
/// side: debit (receivable) | credit (payable). balance falls as allocations
/// are posted; status closes at zero.
model BooksBill {
  id          String  @id @default(uuid())
  booksOrgId  String
  ledgerId    String
  contactId   String?
  billNo      String
  /// new_ref | advance | on_account
  billType    String  @default("new_ref")
  sourceType  String
  sourceId    String
  date        String
  dueDate     String?
  side        String
  currency    String  @default("INR")
  fxAmount    BigInt
  amount      BigInt
  fxBalance   BigInt
  balance     BigInt
  status      String  @default("open")

  allocations BooksBillAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([booksOrgId, sourceType, sourceId])
  @@index([booksOrgId, ledgerId, status])
  @@index([contactId])
}

/// A journal's effect on an open item. type: new_ref | against_ref | advance | on_account.
model BooksBillAllocation {
  id         String @id @default(uuid())
  booksOrgId String
  journalId  String
  billId     String
  type       String
  currency   String @default("INR")
  fxAmount   BigInt
  amount     BigInt

  journal BooksJournal @relation(fields: [journalId], references: [id])
  bill    BooksBill    @relation(fields: [billId], references: [id])

  createdAt DateTime @default(now())

  @@index([booksOrgId, billId])
  @@index([journalId])
}

/// customer | vendor | both. gstTreatment: business_gst | business_none | overseas | consumer.
model BooksContact {
  id                 String  @id @default(uuid())
  booksOrgId         String
  type               String
  displayName        String
  companyName        String?
  email              String?
  phone              String?
  gstin              String?
  gstTreatment       String  @default("business_gst")
  pan                String?
  placeOfSupplyState String?
  currency           String  @default("INR")
  paymentTermsDays   Int     @default(30)
  creditLimit        BigInt  @default(0)
  /// TDS section applied to this vendor's bills, e.g. '194J'.
