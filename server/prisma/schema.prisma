  date       String
  currency   String
  rate       Float
  /// Signed base-currency delta booked to the FX gain/loss ledger.
  delta      BigInt
  journalId  String?
  detailJson String

  createdAt DateTime @default(now())
  createdBy String?

  @@index([booksOrgId, date])
}

model BooksNumberSequence {
  id         String @id @default(uuid())
  booksOrgId String
  kind       String
  prefix     String
  next       Int    @default(1)

  @@unique([booksOrgId, kind])
}

/// Append-only. Triggers forbid UPDATE and DELETE.
model BooksAuditEvent {
  id          String  @id @default(uuid())
  booksOrgId  String
  actorUserId String?
  entityType  String
  entityId    String
  action      String
  beforeJson  String?
  afterJson   String?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([booksOrgId, entityType, entityId])
  @@index([booksOrgId, createdAt])
