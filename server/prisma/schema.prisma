  booksOrgId  String
  ledgerId    String
  date        String
  description String
  /// Signed minor units: positive = money in.
  amount      BigInt
  reference   String?
  matchedJournalLineId String?
  matchedAt   DateTime?

  createdAt DateTime @default(now())
  createdBy String?

  @@index([booksOrgId, ledgerId, date])
}

model BooksExchangeRate {
