{
  "name": "auditos-hrms-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && npm run build:copy-sql",
    "_comment_build_copy_sql": "tsc emits prisma/*.ts to dist/prisma/, and the Task invariants loader resolves its .sql beside the compiled output — but tsc does not copy non-TS files, so the compiled server would boot without its ledger triggers. node -e rather than cp so the script is not shell-specific.",
    "build:copy-sql": "node -e \"require('node:fs').cpSync('prisma/sql', 'dist/prisma/sql', { recursive: true })\"",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:audit-automation": "tsx src/modules/audit-automation/__tests__/gst-matching.ts && tsx src/modules/audit-automation/__tests__/tds-matching.ts && tsx src/modules/audit-automation/__tests__/preflight.ts",
    "test:tally": "tsx src/modules/tally/__tests__/foundation.ts && tsx src/modules/tally/__tests__/accounting.ts",
    "test:zpay": "tsx src/modules/zpay/__tests__/state.ts && tsx src/modules/zpay/__tests__/matcher.ts && tsx src/modules/zpay/__tests__/oauth.ts && tsx src/modules/zpay/__tests__/fake-zoho.ts && tsx src/modules/zpay/__tests__/sync.ts && tsx src/modules/zpay/__tests__/collections.ts && tsx src/modules/zpay/__tests__/matching-integration.ts && tsx src/modules/zpay/__tests__/billing.ts && tsx src/modules/zpay/__tests__/invoice-import.ts",
    "test:scripts": "npm run test:audit-automation && npm run test:tally && npm run test:tasks && npm run test:zpay",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push --skip-generate",
    "prisma:push:safe": "tsx prisma/safe-push.ts",
    "db:drop-legacy-books": "prisma db execute --schema prisma/schema.prisma --file prisma/sql/drop-legacy-books.postgresql.sql",
    "seed": "tsx prisma/seed.ts",
    "seed:tools": "tsx prisma/seed-tools.ts",
    "db:reset": "prisma db push --force-reset --accept-data-loss --skip-generate && npm run seed",
    "sync:permissions": "tsx prisma/sync-permissions.ts",
    "test:tasks": "tsx src/modules/task/__tests__/time-tracking.ts",
    "seed:tasks": "tsx prisma/seed-tasks.ts",
    "seed:gst-compliance": "tsx prisma/seed-gst-compliance.ts",
    "seed:documents": "tsx prisma/seed-documents.ts",
    "reset:gst-template": "tsx prisma/reset-gst-template.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "docx": "9.5.1",
    "exceljs": "4.4.0",
    "express": "4.21.2",
    "fast-xml-parser": "^4.5.1",
    "jsonwebtoken": "9.0.2",
    "jszip": "3.10.1",
    "multer": "1.4.5-lts.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "pdfkit": "0.15.1",
    "qrcode": "^1.5.4",
    "sharp": "0.34.3",
    "socket.io": "4.8.1",
    "tesseract.js": "6.0.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/multer": "1.4.12",
    "@types/node": "20.17.9",
    "@types/pdfkit": "0.13.9",
    "prisma": "5.22.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.9"
  }
}
