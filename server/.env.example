# Backend environment. Copy to server/.env and fill in real values.
# NEVER commit the resulting .env — it is git-ignored.

# Local development database — PostgreSQL running in Docker (see
# docker-compose.yml at the repo root). If you change the user, password
# or db name here, update .env.docker to match.
DATABASE_URL="postgresql://auditos:auditos_dev_pw@localhost:55432/auditos?schema=public"

# Separate database used by the vitest suite. Created automatically on
# first Postgres container start (see docker/postgres/init/).
TEST_DATABASE_URL="postgresql://auditos:auditos_dev_pw@localhost:55432/auditos_test?schema=public"

# Session signing key. Required in production; generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Signing key for short-lived document / payslip download links.
SIGNED_URL_SECRET=

# Seconds a signed download link stays valid.
SIGNED_URL_TTL_SECONDS=300

# Seconds a login session stays valid (default 8 hours).
SESSION_TTL_SECONDS=28800

# Comma-separated allow-list of browser origins for credentialed CORS.
# Never "*" — credentials are sent with every request.
#
# IMPORTANT: Vite proxies /api with changeOrigin:false, so it forwards the
# browser's Origin header verbatim — /api through the proxy is NOT
# same-origin to this server. If you open the app on a LAN address
# (http://192.168.x.x:5173) rather than localhost, that exact origin must
# be listed here or **login fails**. Add your machine's address:
#   WEB_ORIGIN=http://localhost:5173,http://192.168.1.60:5173
# Outside production, lib/origin.ts also accepts any loopback/private-LAN
# origin, so a changed machine IP does not silently break login.
WEB_ORIGIN=http://localhost:5173

# API port.
PORT=4000

# development | production. In production a missing secret aborts startup.
NODE_ENV=development

# ── Zoho Payments integration (docs/zoho-payments/README.md) ──────────────

# fake | live. `fake` mounts an in-process /fake-zoho router so the OAuth
# flow can be driven end-to-end without a Zoho developer app. Never allowed
# in production — the config module refuses to boot with fake there.
ZPAY_MODE=fake

# Zoho developer console credentials. REQUIRED when ZPAY_MODE=live.
# In fake mode the config manufactures placeholder values.
ZPAY_CLIENT_ID=
ZPAY_CLIENT_SECRET=

# Where accounts.zoho.in should redirect after the user consents. In fake
# mode the fake router uses this exact value, so pointing it back at the
# API is what closes the loop.
ZPAY_REDIRECT_URI=http://localhost:4000/api/zpay/callback

# AES-256 key for encrypting stored refresh + access tokens. Base64-encoded
# 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production. In development an ephemeral key is generated at
# boot; stored tokens do not survive a restart.
ZPAY_ENCRYPTION_KEY=

# Override the Zoho hosts. Only useful for pointing at a staging Zoho or
# forcing accounts.zoho.in even in fake mode. Do not point at
# accounts.zoho.com for an Indian tenant (spec §1).
# ZPAY_ACCOUNTS_BASE=https://accounts.zoho.in
# ZPAY_PAYMENTS_BASE=https://payments.zoho.in

# ── Books (Tools → Books) — Zoho Books integration ───────────────────────────
# docs/books-zoho/README.md. Register a "Server-based Application" in the Zoho
# API console (api-console.zoho.in) with the redirect URI below. Without the
# client id/secret Books shows "not configured" — it never shows sample data.
ZBOOKS_CLIENT_ID=
ZBOOKS_CLIENT_SECRET=
ZBOOKS_REDIRECT_URI=http://localhost:4000/api/books/callback
# base64 32-byte key encrypting Zoho tokens at rest; required in production.
# Falls back to ZPAY_ENCRYPTION_KEY. Generate: openssl rand -base64 32
ZBOOKS_ENCRYPTION_KEY=
# Optional overrides:
# ZBOOKS_ACCOUNTS_BASE=https://accounts.zoho.in   # where consent starts; Zoho redirects to the user's DC
# ZBOOKS_SCOPES=ZohoBooks.fullaccess.all
# ZBOOKS_RATE_PER_MINUTE=90                        # per-organisation budget under Zoho's 100/min
