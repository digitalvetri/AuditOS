# Backend environment. Copy to server/.env and fill in real values.
# NEVER commit the resulting .env — it is git-ignored.

# Local development database. SQLite by default; for PostgreSQL also change
# `provider` in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Session signing key. Required in production; generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Signing key for short-lived document / payslip download links.
SIGNED_URL_SECRET=

# Seconds a signed download link stays valid.
SIGNED_URL_TTL_SECONDS=300

# Seconds a login session stays valid (default 8 hours).
SESSION_TTL_SECONDS=28800

# Comma-separated allow-list of browser origins for credentialed CORS.
# Never "*" — credentials are sent with every request.
#
# IMPORTANT: Vite proxies /api with changeOrigin:false, so it forwards the
# browser's Origin header verbatim — /api through the proxy is NOT
# same-origin to this server. If you open the app on a LAN address
# (http://192.168.x.x:5173) rather than localhost, that exact origin must
# be listed here or **login fails**. Add your machine's address:
#   WEB_ORIGIN=http://localhost:5173,http://192.168.1.60:5173
# Outside production, lib/origin.ts also accepts any loopback/private-LAN
# origin, so a changed machine IP does not silently break login.
WEB_ORIGIN=http://localhost:5173

# API port.
PORT=4000

# development | production. In production a missing secret aborts startup.
NODE_ENV=development
