# Environment for the Docker stack (docker-compose.yml).
# Copy to .env.docker — which is git-ignored — and edit.
#
#   cp .env.docker.example .env.docker
#   docker compose up -d --build
#
# NOTE: backend/.env is for the NATIVE workflow (npm run dev:full) and points
# at localhost:55432. This file is for the containers, where the database is
# reached as `postgres:5432`. The two can run side by side against the same
# database; keep the credentials below in step with backend/.env.

# ── Database ──────────────────────────────────────────────────────────────
POSTGRES_USER=auditos
POSTGRES_PASSWORD=auditos_dev_pw
POSTGRES_DB=auditos

# ── Host ports ────────────────────────────────────────────────────────────
# The app is served here. Postgres stays on 55432 so the native dev workflow
# keeps working; Adminer is the database UI.
WEB_HOST_PORT=8080
POSTGRES_HOST_PORT=55432
ADMINER_HOST_PORT=58080

# ── Secrets ───────────────────────────────────────────────────────────────
# REQUIRED. The API runs with NODE_ENV=production and refuses to boot if
# either is missing or shorter than 16 characters — there is no default.
# Generate real ones:  openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32
SIGNED_URL_SECRET=change-me-openssl-rand-hex-32
# Separate key for the long-lived download links a client receives by email
# or WhatsApp. Kept separate from SIGNED_URL_SECRET so one can be rotated
# without invalidating the other.  openssl rand -hex 32
PERMANENT_LINK_SECRET=change-me-openssl-rand-hex-32
# AES-256 key for stored portal passwords (GST + TDS credentials).
# Must decode to 32 bytes: openssl rand -base64 32. Changing it makes
# already-saved passwords unreadable — set once, keep it safe.
PORTAL_ACCESS_ENC_KEY=change-me-openssl-rand-base64-32
# Optional: signing secret for the government-portal autofill extension's
# short-lived launch tokens. When unset it is derived from PORTAL_ACCESS_ENC_KEY.
# openssl rand -hex 32
# PORTAL_AUTOFILL_SECRET=
# Optional: where TDS receipts/certificates are stored (default /app/uploads/tds-documents,
# inside the auditos-uploads volume).
# TDS_STORAGE_ROOT=/app/uploads/tds-documents
# Optional: where files uploaded into a client's Documents folders are stored
# (default /app/uploads/client-documents, inside the auditos-uploads volume).
# CLIENT_DOC_STORAGE_ROOT=/app/uploads/client-documents

# ── Origins ───────────────────────────────────────────────────────────────
# Credentialed CORS never uses '*', and NODE_ENV=production means ONLY this
# list is accepted — the development fallback that waves through any LAN
# address does not apply. List every origin a browser will actually use,
# including the machine's LAN IP if you open the app from another device.
#
#   WEB_ORIGIN=http://localhost:8080,http://192.168.1.60:8080
#
# The API prints the accepted list on boot: `docker compose logs api`.
#
# The :5173 entries are the Vite dev server. It proxies /api with
# changeOrigin:false — deliberately, so the app stays same-origin and the
# session cookie works — which means the API sees Origin: localhost:5173, not
# :8080. Leave them out and `npm run dev` logs in with 403 origin_not_allowed
# while the dockerised app on :8080 works fine, which is a confusing half hour.
WEB_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# ── Public URL (download links in email / WhatsApp) ──────────────────────
# The absolute origin a client opens to reach this app. The server embeds it
# in every "Send by email" / "Send on WhatsApp" message as part of the
# download link. For a local Docker stack this is the WEB_HOST_PORT above
# (default 8080); for a real deployment it is the public hostname with https.
PUBLIC_APP_URL=http://localhost:8080

# ── Session ───────────────────────────────────────────────────────────────
# The session cookie's Secure flag. This stack serves plain HTTP, and a
# browser DROPS a Secure cookie on an http:// origin — login would appear to
# work and then every request would come back 401. Set this to true the
# moment you put TLS in front.
COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
SIGNED_URL_TTL_SECONDS=300

# Books (Tools → Books) — Zoho Books. See docs/books-zoho/README.md.
# Several Zoho accounts can be connected; users switch between them in
# Books → Settings. Each account brings its own Client ID / Secret, added by
# a Super Admin (Books → Settings → Add organisation) or by a developer:
#   docker compose run --rm migrate npm run books:connection -- add
# ZBOOKS_CLIENT_ID / _SECRET below are the server-wide client — only needed for
# a connection made without its own client (e.g. the original "Main Account").
# For a Server-based client, ZBOOKS_REDIRECT_URI must be the API's public
# /api/books/callback URL (e.g. http://localhost:8080/api/books/callback behind
# this nginx) and match the redirect registered in the Zoho API console exactly.
# ZBOOKS_ENCRYPTION_KEY is required in production: openssl rand -base64 32 —
# it encrypts every connection's secret and tokens; keep it stable.
ZBOOKS_CLIENT_ID=
ZBOOKS_CLIENT_SECRET=
ZBOOKS_REDIRECT_URI=
ZBOOKS_ENCRYPTION_KEY=
# Optional. The in-app create screens (journals, recurring profiles, price
# lists, transaction locking, bulk update…) need write access, which the
# default full-access scope grants — narrow it only if those stay unused.
# ZBOOKS_ACCOUNTS_BASE=https://accounts.zoho.in   # where consent starts; Zoho redirects to the user's DC
# ZBOOKS_SCOPES=ZohoBooks.fullaccess.all
# ZBOOKS_RATE_PER_MINUTE=90                        # per-organisation budget under Zoho's 100/min
# BOOKS_SELF_SERVICE_CONNECT=false                 # true re-enables the old in-app Connect / Reconnect / Disconnect

# Zoho Payments (Integrations → Zoho Payments) — firm collections: sync
# payments, import invoices (CSV / Excel / PDF), raise payment links.
# See docs/zoho-payments/README.md. In production (NODE_ENV=production) the
# mode is live; ZPAY_MODE=fake is refused. Create a Server-based client in the
# Zoho API console (api-console.zoho.in) with the redirect below, registered
# exactly. The consent asks for ZohoPay.payments.READ, ZohoPay.refunds.READ and
# ZohoPay.payments.CREATE (payment links).
# ZPAY_ENCRYPTION_KEY is required: openssl rand -base64 32
ZPAY_MODE=live
ZPAY_CLIENT_ID=
ZPAY_CLIENT_SECRET=
ZPAY_REDIRECT_URI=http://localhost:8080/api/zpay/callback
ZPAY_ENCRYPTION_KEY=
# India data centre by default; change for another Zoho region.
# ZPAY_ACCOUNTS_BASE=https://accounts.zoho.in
# ZPAY_PAYMENTS_BASE=https://payments.zoho.in

# Email with PDF attachments (see backend/.env.example).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# WhatsApp Business Cloud API (see docs/whatsapp/README.md).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# Web Push (notifications when the app is closed). Generate once with:
#   npx web-push generate-vapid-keys
# Leave blank to turn push off; in-app realtime notifications still work.
# Push needs HTTPS in production (localhost is exempt).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
