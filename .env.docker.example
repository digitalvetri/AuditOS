# Environment for the Docker stack (docker-compose.yml).
# Copy to .env.docker — which is git-ignored — and edit.
#
#   cp .env.docker.example .env.docker
#   docker compose up -d --build
#
# NOTE: server/.env is for the NATIVE workflow (npm run dev:full) and points
# at localhost:55432. This file is for the containers, where the database is
# reached as `postgres:5432`. The two can run side by side against the same
# database; keep the credentials below in step with server/.env.

# ── Database ──────────────────────────────────────────────────────────────
POSTGRES_USER=auditos
POSTGRES_PASSWORD=auditos_dev_pw
POSTGRES_DB=auditos

# ── Host ports ────────────────────────────────────────────────────────────
# The app is served here. Postgres stays on 55432 so the native dev workflow
# keeps working; Adminer is the database UI.
WEB_HOST_PORT=8080
POSTGRES_HOST_PORT=55432
ADMINER_HOST_PORT=58080

# ── Secrets ───────────────────────────────────────────────────────────────
# REQUIRED. The API runs with NODE_ENV=production and refuses to boot if
# either is missing or shorter than 16 characters — there is no default.
# Generate real ones:  openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32
SIGNED_URL_SECRET=change-me-openssl-rand-hex-32

# ── Origins ───────────────────────────────────────────────────────────────
# Credentialed CORS never uses '*', and NODE_ENV=production means ONLY this
# list is accepted — the development fallback that waves through any LAN
# address does not apply. List every origin a browser will actually use,
# including the machine's LAN IP if you open the app from another device.
#
#   WEB_ORIGIN=http://localhost:8080,http://192.168.1.60:8080
#
# The API prints the accepted list on boot: `docker compose logs api`.
WEB_ORIGIN=http://localhost:8080

# ── Session ───────────────────────────────────────────────────────────────
# The session cookie's Secure flag. This stack serves plain HTTP, and a
# browser DROPS a Secure cookie on an http:// origin — login would appear to
# work and then every request would come back 401. Set this to true the
# moment you put TLS in front.
COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
SIGNED_URL_TTL_SECONDS=300
