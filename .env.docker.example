# Credentials for the Postgres container defined in docker-compose.yml.
# Copy to .env.docker (git-ignored) and edit as needed.
#
# The values here MUST match the DATABASE_URL in server/.env — if you
# change the user, password or db name, update server/.env too.

POSTGRES_USER=auditos
POSTGRES_PASSWORD=auditos_dev_pw
POSTGRES_DB=auditos

# Host ports are configured in docker-compose.yml (55432 for Postgres,
# 58080 for Adminer). To change them, edit the compose file or run:
#   POSTGRES_HOST_PORT=5432 docker compose up -d
