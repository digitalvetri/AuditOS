{
  "name": "auditos-portal-autofill-extension",
  "private": true,
  "version": "0.1.0",
  "description": "AuditOS internal Chrome extension (MV3): fills the CRM-selected client's government-portal login. Phase 1.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "esbuild tests/context.test.ts --bundle --platform=node --format=esm --outfile=.test-out/context.test.mjs --log-level=warning && node --test .test-out/context.test.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}
