{
  "name": "audit-os-hrms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm --prefix server run dev",
    "dev:full": "concurrently -n web,api -c blue,magenta \"npm run dev\" \"npm run dev:api\"",
    "build": "tsc -b && vite build",
    "build:api": "npm --prefix server run build",
    "preview": "vite preview",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "type-check:api": "npm --prefix server run typecheck",
    "db:setup": "npm --prefix server run prisma:generate && npm --prefix server run prisma:push && npm --prefix server run seed",
    "db:reset": "npm --prefix server run db:reset",
    "setup": "npm install && npm --prefix server install && npm run db:setup",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api web",
    "docker:ps": "docker compose ps",
    "docker:seed": "docker compose run --rm migrate",
    "docker:reset": "docker compose down -v && docker compose up -d --build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "lucide-react": "^1.42.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.4",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "msw": "^2.6.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
