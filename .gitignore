# Secrets — never commit. The .example files are the committed templates.
.env
.env.*
!.env.example
!.env.docker.example

# Local databases — SQLite dev files live under server/prisma/.
*.db
*.db-journal
*.sqlite
*.sqlite3

*.log
.vite
.DS_Store

# Verify-run + snapshot artifacts — regenerated by scripts/*.mjs.
scripts/shots/
scripts/shots-v2/
scripts/snap/
# Tools smoke-test outputs — regenerated by server/src/modules/tools/__tests__/smoke.ts.
server/src/modules/tools/__tests__/fixtures/out/

# TypeScript incremental-build cache — regenerated by `tsc -b`.
*.tsbuildinfo

# Editor / IDE
.idea/
.vscode/
*.swp
